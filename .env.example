# Web3Forms public access key for the contact form (client-side, baked at build time).
# Rotate at https://web3forms.com and set this in your local .env and in CI secrets.
PUBLIC_WEB3FORMS_KEY=

# LinkedIn Insight Tag partner ID (Campaign Manager > Account Assets > Insight Tag).
# Optional — the tag is omitted entirely from every page until this is set.
PUBLIC_LINKEDIN_PARTNER_ID=
