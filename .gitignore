# Build artifacts (dirs AND any stray file/symlink of the same name).
# The trailing-slash form only ignores directories; a committed file/symlink of
# that name would NOT be ignored and could break CI (ENOTDIR on pnpm install).
node_modules
node_modules/
data/**/hash.*
public/
dist/
.DS_Store
# Book files
*.pdf
Practical RHEL AI.pdf
# Allow slide deck PDFs
!static/slides/*.pdf-e 
# Astro generated cache
.astro
.astro/

# Local environment files
.env
.env.local
.env.*.local

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
.img-originals/

# Python
__pycache__/
*.pyc
