{
  "site": "ansiblebyexample.com",
  "base": "https://www.ansiblebyexample.com",
  "role": "The core Ansible and AWX how-to library",
  "sitemaps": [
    "https://www.ansiblebyexample.com/sitemap.xml"
  ],
  "articlePrefix": "/articles/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": [
      "@yourAnsiblePilot"
    ]
  },
  "analytics": {
    "gaId": "G-YFX4FP055Q",
    "inHtml": true
  },
  "home": {
    "titleIncludes": [
      "Learn Ansible"
    ]
  },
  "llms": {
    "mustInclude": [
      "ansiblepilot.com"
    ],
    "forbid": [
      "largest collection"
    ]
  },
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "fresh": [
    {
      "dir": "src/content/tutorials",
      "url": "/articles/{slug}",
      "date": [
        "publishedAt",
        "date"
      ]
    }
  ],
  "repo": "lucab85/ansiblebyexample.com",
  "index": {
    "path": "/articles/all"
  },
  "articleExclude": [
    "/articles/all"
  ]
}
