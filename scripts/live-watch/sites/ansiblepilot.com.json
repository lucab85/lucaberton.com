{
  "site": "ansiblepilot.com",
  "base": "https://www.ansiblepilot.com",
  "role": "Red Hat Ansible Automation Platform (AAP) and enterprise Ansible, plus Luca's brand hub",
  "articlePrefix": "/articles/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": [
      "@ansiblepilot"
    ]
  },
  "analytics": {
    "gaId": "G-Q0V9R2ZHZM",
    "inHtml": false
  },
  "llms": {
    "mustInclude": [
      "ansiblebyexample.com"
    ],
    "forbid": [
      "largest"
    ]
  },
  "pages": [
    {
      "path": "/articles/ansible-automation-platform-aap-guides",
      "article": true
    }
  ],
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "fresh": [
    {
      "dir": "src/content/tutorials",
      "url": "/articles/{slug}",
      "date": [
        "date",
        "publishedAt"
      ]
    }
  ],
  "repo": "lucab85/ansiblepilot.com",
  "index": {
    "path": "/articles/all"
  },
  "articleExclude": [
    "/articles/all"
  ]
}
