{
  "site": "terraformpilot.com",
  "base": "https://www.terraformpilot.com",
  "role": "Terraform/OpenTofu for on-prem, homelab and network providers, plus OpenTofu migration",
  "articlePrefix": "/articles/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": []
  },
  "analytics": {
    "gaId": "G-5NMM6ZT4E4",
    "inHtml": true
  },
  "llms": {
    "mustInclude": [
      "OpenTofu"
    ]
  },
  "pages": [
    {
      "path": "/on-prem/"
    },
    {
      "path": "/opentofu/"
    },
    {
      "path": "/comparisons/",
      "titleIncludes": "Head-to-Head"
    },
    {
      "path": "/articles/terraform-alternatives/",
      "titleIncludes": "Terraform Alternatives",
      "article": true
    },
    {
      "path": "/about/",
      "mustInclude": [
        "former Red Hat"
      ]
    }
  ],
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "fresh": [
    {
      "dir": "content/articles",
      "url": "/articles/{slug}/",
      "date": "date",
      "draft": "draft"
    }
  ],
  "repo": "lucab85/terraformpilot.com"
}
