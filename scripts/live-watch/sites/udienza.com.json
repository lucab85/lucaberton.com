{
  "site": "udienza.com",
  "base": "https://www.udienza.com",
  "role": "Video podcast: interviews and conference coverage",
  "articlePrefix": "/episodes/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": [
      "@TheLucaBerton"
    ]
  },
  "analytics": {
    "gaId": "G-YJKMKH633R",
    "inHtml": true
  },
  "llms": {
    "mustInclude": [
      "Luca Berton",
      "openempower.com"
    ]
  },
  "pages": [
    {
      "path": "/episodes/"
    },
    {
      "path": "/articles/"
    }
  ],
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "fresh": [
    {
      "dir": "src/content/articles",
      "url": "/articles/{slug}/",
      "date": "pubDate"
    },
    {
      "dir": "src/content/episodes",
      "url": "/episodes/{slug}",
      "date": "pubDate",
      "indexable": true
    }
  ],
  "repo": "lucab85/udienza.com"
}
