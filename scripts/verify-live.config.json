{
  "site": "lucaberton.com",
  "base": "https://lucaberton.com",
  "role": "Luca Berton the person, plus AI-coding content; buyer intent goes to openempower.com",
  "sitemaps": [
    "https://lucaberton.com/sitemap-index.xml"
  ],
  "articlePrefix": "/blog/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": [
      "@TheLucaBerton"
    ]
  },
  "analytics": {
    "gaId": "G-M9Q5F672JT",
    "inHtml": true
  },
  "llms": {
    "mustInclude": [
      "openempower.com",
      "ansiblebyexample.com",
      "ansiblepilot.com",
      "terraformpilot.com",
      "kubernetes.recipes",
      "udienza.com",
      "copypastelearn.com"
    ]
  },
  "redirects": [
    {
      "from": "/production-ai-assessment/",
      "to": "https://www.openempower.com/services/assessment",
      "status": 301
    },
    {
      "from": "/ai-readiness-assessment/",
      "to": "https://www.openempower.com/services/assessment",
      "status": 301
    }
  ],
  "pages": [
    {
      "path": "/services/",
      "titleIncludes": "Work with Luca",
      "mustInclude": [
        "openempower.com"
      ]
    },
    {
      "path": "/blog/claude-code-econnreset-fix/",
      "article": true
    }
  ],
  "articleType": "BlogPosting",
  "allowForeignCanonical": true,
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "articleExclude": [
    "/blog/categories/",
    "/blog/category/",
    "/blog/tags/",
    "/blog/tag/",
    "/blog/page/",
    "/blog/search",
    "/blog/all/"
  ],
  "fresh": [
    {
      "dir": "src/content/blog",
      "url": "/blog/{slug}/",
      "date": "publishDate",
      "draft": "draft"
    }
  ],
  "index": {
    "path": "/blog/all"
  }
}
