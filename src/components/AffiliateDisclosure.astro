---
/**
 * Affiliate disclosure, shown at the top of every blog post.
 *
 * Unconditional by design: BlogPromoCard renders an Amazon affiliate link on
 * every post, so there is no such thing as a post without one. Making this
 * conditional would only create a way to miss it.
 *
 * The sentence "We earn commissions when you shop through the links below" is
 * the exact wording required by the DigitalOcean affiliate programme for blog
 * posts and web pages, and it also satisfies the Amazon Associates operating
 * agreement and FTC endorsement guidelines. Do not reword it.
 */
import { AFFILIATE_DISCLOSURE_LABEL, AFFILIATE_DISCLOSURE_TEXT } from "@utils/affiliateDisclosure";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<aside
  class={`not-prose mx-auto max-w-3xl rounded-lg border border-amber-200 bg-amber-50/60 px-4 py-3 ${className}`}
  aria-label="Affiliate disclosure"
>
  <p class="m-0 text-sm leading-relaxed text-gray-700">
    <span class="font-semibold text-gray-900">{AFFILIATE_DISCLOSURE_LABEL}</span>
    {AFFILIATE_DISCLOSURE_TEXT}
  </p>
</aside>
