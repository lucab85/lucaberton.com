---
/**
 * AGNTCon + MCPCon North America 2026 (Oct 22–23, San Jose) with Luca's code
 * LUCA_475: registration for $475, valid through the event. Images come from
 * scripts/generate-agntcon-banners.mjs and are served from
 * /promo/agntcon-na-2026/ so Luca's other sites embed the same files.
 * Clicking copies LUCA_475 to the clipboard (best effort, never blocks
 * navigation) and goes to the Linux Foundation registration page; the code is
 * not passed in the URL because no such parameter is documented.
 * Remove after the event (Oct 23, 2026).
 */
interface Props {
  /** Top of a page: load the image eagerly. */
  eager?: boolean;
  class?: string;
}
const { eager = false, class: className = "" } = Astro.props;
const REGISTER_URL = "https://register.linuxfoundation.org/agntcon-mcpcon-na-2026";
const CODE = "LUCA_475";
const IMG = "/promo/agntcon-na-2026";
const alt = "AGNTCon and MCPCon North America 2026, October 22–23, San Jose — register for $475 with code LUCA_475";
---

<aside class={`not-prose mx-auto max-w-3xl ${className}`} aria-label="AGNTCon + MCPCon North America 2026 registration offer">
  <a
    href={REGISTER_URL}
    class="agntcon-banner block overflow-hidden rounded-2xl shadow-lg transition-shadow hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    data-agntcon-code={CODE}
    data-track-event="affiliate_click"
    data-tp-company="linux_foundation"
    data-tp-offer-id="agntcon_na_2026_luca475"
    data-tp-offer-type="partner"
    data-tp-cta-position="top_banner"
    data-tp-cta-variant="agntcon_na_2026_banner"
  >
    <picture>
      <source media="(max-width: 640px)" type="image/webp" srcset={`${IMG}/card-800.webp 800w, ${IMG}/card-1200.webp 1200w`} sizes="100vw" width="1672" height="941" />
      <source media="(max-width: 640px)" srcset={`${IMG}/card.jpg`} width="1672" height="941" />
      <source type="image/webp" srcset={`${IMG}/wide.webp`} width="1200" height="300" />
      <img
        src={`${IMG}/wide.jpg`}
        width="1200"
        height="300"
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
        class="block h-auto w-full"
      />
    </picture>
  </a>
  <p class="mt-2 text-center text-sm text-gray-600">
    Register for $475 — use code <code class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold text-gray-900">{CODE}</code> at checkout
    <span class="agntcon-copied ml-1 font-medium text-green-700" role="status" aria-live="polite"></span>
  </p>
</aside>

<script>
  // Copy the code, then navigate. Navigation never depends on the clipboard:
  // it waits at most 300 ms for the copy and goes anyway if it fails or is
  // blocked. Modified clicks (new tab, middle click) keep the browser default.
  document.querySelectorAll<HTMLAnchorElement>("a[data-agntcon-code]").forEach((a) => {
    a.addEventListener("click", (e) => {
      const code = a.dataset.agntconCode ?? "";
      const status = a.parentElement?.querySelector(".agntcon-copied");
      const copy = navigator.clipboard?.writeText(code).then(() => {
        if (status) status.textContent = `${code} copied — paste it at checkout`;
      });
      if (!copy || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const go = () => window.location.assign(a.href);
      Promise.race([copy, new Promise((r) => setTimeout(r, 300))]).then(go, go);
    });
  });
</script>
