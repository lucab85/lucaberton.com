---
/**
 * Sets window.__lucaNoAnalytics before any analytics tag runs. True on local
 * and private hosts (localhost, 127.0.0.0/8, 0.0.0.0, ::1, *.localhost,
 * *.local, Tailscale *.ts.net, file://) and in automated browsers
 * (navigator.webdriver, which Playwright sets).
 *
 * When it is true, gtag() does nothing (no config, no events), GA4 is also
 * opted out with ga-disable-<id>, and PostHog, Clarity and the LinkedIn tag do
 * not load. ConversionTracker still pushes its own event objects to
 * window.dataLayer, which is what the E2E tests read; with no gtag config,
 * nothing leaves the browser.
 *
 * Why: 205 of the 214 contact_form_submit key events from Sep 28 to Oct 30,
 * 2026 came from 127.0.0.1, and 19 of 22 again in Oct 31 to Nov 27, 2026.
 *
 * Include it in <head> before the GA4 snippet (Layout.astro and the
 * standalone book pages that carry their own snippet).
 */
---

<script is:inline>
  window.__lucaNoAnalytics = (function () {
    var h = String(window.location.hostname || '').toLowerCase().replace(/^\[|\]$/g, '');
    return h === '' || h === 'localhost' || h === '0.0.0.0' || h === '::1' ||
      /^127\./.test(h) || /\.localhost$/.test(h) || /\.local$/.test(h) || /\.ts\.net$/.test(h) ||
      navigator.webdriver === true;
  })();
</script>
