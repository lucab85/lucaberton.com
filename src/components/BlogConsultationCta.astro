---
/**
 * Per-post, topic-aware consultation CTA for blog posts. Uses the same
 * category/tags -> service lookup as RelatedServices.astro (src/utils/serviceMatches.ts)
 * to personalize the headline and target link, so every post gets a CTA
 * relevant to its own topic without any manual per-post edits.
 */
import { matchServices } from "@utils/serviceMatches";
import MagneticButton from "@components/react/MagneticButton.tsx";

export interface Props {
  category: string;
  tags: string[];
}

const { category, tags } = Astro.props;
const [best] = matchServices(category, tags, 1);

const headline = best ? `Need help with ${best.title}?` : "Need help implementing this?";
const body = best
  ? best.description
  : "I help enterprises design AI infrastructure, Kubernetes platforms, and automation strategies. Free 30-minute discovery call.";
const chipLabel = best ? best.title : "Free Consultation";
---

<div class="grad-border relative overflow-hidden rounded-2xl p-8 mt-12 bg-gray-900">
  <div
    aria-hidden="true"
    class="absolute -top-20 -right-20 w-64 h-64 rounded-full opacity-30 blur-3xl pointer-events-none"
    style="background: var(--grad-brand);"
  ></div>
  <div class="relative">
    <span class="chip bg-white/10 text-amber-200 border border-white/10">
      <span class="chip-dot"></span>
      {chipLabel}
    </span>
    <h3 class="mt-4 text-2xl font-bold text-white">{headline}</h3>
    <p class="mt-3 text-gray-300 leading-relaxed max-w-2xl">{body}</p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <MagneticButton client:load>
        <a
          href="https://calendly.com/lucaberton/"
          class="inline-flex items-center justify-center px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl shadow-lg shadow-red-600/25 active:scale-[0.98] transition-all duration-200">
          Schedule Free Assessment →
        </a>
      </MagneticButton>
      {best && (
        <a
          href={best.url}
          class="inline-flex items-center justify-center px-6 py-3 border border-white/20 text-white font-semibold rounded-xl hover:bg-white/10 active:scale-[0.98] transition-all duration-200">
          Learn more about {best.title}
        </a>
      )}
    </div>
  </div>
</div>
