---
/**
 * Topic-aware enterprise consulting CTA.
 *
 * Broad posts fall back to serviceMatches.ts. High-value organic landing pages
 * can pass explicit copy from blogConsultingCtas.ts so the CTA bridges the
 * reader's technical problem to an organization-level assessment.
 *
 * Analytics are declarative and consumed by ConversionTracker.astro.
 */
import { matchServices } from "@utils/serviceMatches";

export interface Props {
  category: string;
  tags: string[];

  eyebrow?: string;
  headline?: string;
  body?: string;
  benefits?: string[];

  ctaLabel?: string;
  ctaHref?: string;

  targetOffer?: string;
  ctaPosition?: string;
  ctaVariant?: string;
}

const {
  category,
  tags,

  eyebrow = "FOR ENGINEERING LEADERS",
  headline: headlineOverride,
  body: bodyOverride,
  benefits = [],

  ctaLabel = "Assess Your AI Platform →",
  ctaHref = "/production-ai-assessment/",

  targetOffer = "production_ai_assessment",
  ctaPosition = "post_conclusion",
  ctaVariant = "contextual_enterprise_problem",
} = Astro.props;

const [best] = matchServices(category, tags, 1);

const headline =
  headlineOverride ??
  (best
    ? `Taking ${best.title} into production?`
    : "Taking this into production?");

const body =
  bodyOverride ??
  (best
    ? `${best.description} Get an independent view of the architecture, operational risks, and highest-priority gaps before you scale.`
    : "Identify architecture, security, governance, observability, and cost gaps before they become production constraints.");

const secondaryOffer = best
  ? best.url.replace(/[\/-]/g, "_").replace(/^_+|_+$/g, "")
  : undefined;

const headingId = `consulting-cta-${ctaVariant.replace(/[^a-z0-9_-]/gi, "-")}`;
---

<aside
  class="not-prose grad-border relative overflow-hidden rounded-2xl border border-slate-700/70 bg-slate-950 p-6 sm:p-8 mt-10 mb-10 shadow-xl shadow-slate-950/10"
  aria-labelledby={headingId}
>
  <div
    aria-hidden="true"
    class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"
  ></div>

  <div class="relative">
    <p class="text-[0.72rem] font-black uppercase tracking-[0.15em] text-blue-300">
      {eyebrow}
    </p>

    <h3 id={headingId} class="mt-3 max-w-2xl text-2xl sm:text-[1.7rem] font-extrabold leading-tight tracking-tight text-white">
      {headline}
    </h3>

    <p class="mt-3 max-w-2xl text-[0.98rem] leading-7 text-slate-300">
      {body}
    </p>

    {benefits.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Assessment areas">
        {benefits.map((benefit) => (
          <li class="rounded-full border border-white/10 bg-white/[0.06] px-3 py-1.5 text-xs font-semibold text-slate-200">
            {benefit}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href={ctaHref}
        data-track-event="consulting_cta_click"
        data-tp-target-offer={targetOffer}
        data-tp-cta-position={ctaPosition}
        data-tp-cta-variant={ctaVariant}
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-center font-bold text-white shadow-lg shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-300 active:translate-y-0"
      >
        {ctaLabel}
      </a>

      {best && (
        <a
          href={best.url}
          data-track-event="consulting_cta_click"
          data-tp-target-offer={secondaryOffer}
          data-tp-cta-position={ctaPosition}
          data-tp-cta-variant={`${ctaVariant}_service_detail`}
          class="inline-flex min-h-11 items-center justify-center px-2 py-2 text-sm font-semibold text-slate-300 underline decoration-slate-500 underline-offset-4 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-300"
        >
          See the related service
        </a>
      )}
    </div>

    <p class="mt-5 flex items-start gap-2 text-xs leading-5 text-slate-400">
      <span aria-hidden="true" class="mt-0.5 text-emerald-400">✓</span>
      <span>Directly with Luca · Former Red Hat engineer · Docker Captain · KubeCon speaker</span>
    </p>
  </div>
</aside>
