---
// src/components/BlogPromoCard.astro
// Mid-article promotional card for books, courses, and services
// Books and courses rotate based on the page slug hash for deterministic variety
interface Props {
  variant?:
    | 'book'
    | 'course'
    | 'service'
    | 'newsletter'
    | 'vps'
    | 'atoms'
    | 'claudeBootcamp'
    | 'nordicApis'
    | 'udemyCertification'
    | 'udemySecondChance'
    | 'pocket'
    | 'flatpay'
    | 'linuxFoundation';
}

const { variant = 'book' } = Astro.props;

// --- Books rotation pool (actual covers) ---
const books = [
  {
    title: 'Practical RHEL AI',
    description: 'Designing, Deploying and Scaling AI Solutions with Red Hat Enterprise Linux.',
    cover: '/blog/books/practical_RHEL_AI.jpg',
    buyUrl: 'https://amzn.to/4qjORdC',
    blogUrl: '/practical-rhel-ai/',
  },
  {
    title: 'Kubernetes Recipes',
    description: 'A Practical Guide for Container Orchestration and Deployment.',
    cover: '/blog/thumbnails/kubernetes-recipes-book-cover.jpg',
    buyUrl: 'https://amzn.to/3DzC8QA',
    blogUrl: '/kubernetes-recipes/',
  },
  {
    title: 'Red Hat Enterprise Linux 9 for SysAdmins',
    description: 'A technical guide for building secure production systems using RHEL 9.',
    cover: '/blog/books/9365891175.jpg',
    buyUrl: 'https://amzn.to/4hRsc3Z',
    blogUrl: '/books/',
  },
  {
    title: 'Mastering the RHCE Exam',
    description: 'Your complete guide to Linux administration, automation, and certification.',
    cover: '/blog/books/RHCE.jpg',
    buyUrl: 'https://amzn.to/3ZOJ2IM',
    blogUrl: '/books/',
  },
  {
    title: 'Red Hat Ansible Automation',
    description: 'Advanced Ansible techniques covering complex playbooks, modules, and integrations.',
    cover: '/blog/books/9355518994.jpg',
    buyUrl: 'https://amzn.to/41K0cbm',
    blogUrl: '/books/',
  },
  {
    title: 'Hands-on Ansible Automation',
    description: 'Managing hybrid cloud environments with Ansible and multi-cloud orchestration.',
    cover: '/blog/books/9789355515599.jpg',
    buyUrl: 'https://amzn.to/43HEMuL',
    blogUrl: '/books/',
  },
  {
    title: 'Ansible for Kubernetes by Example',
    description: 'Learn how to automate Kubernetes clusters with Ansible.',
    cover: '/blog/books/9781484292853.jpg',
    buyUrl: 'https://amzn.to/3NLCAMB',
    blogUrl: '/books/',
  },
  {
    title: 'Ansible for VMware by Examples',
    description: 'Automate VMware environments with Ansible for infrastructure management.',
    cover: '/blog/books/9781484288795.jpg',
    buyUrl: 'https://amzn.to/3XHeDLd',
    blogUrl: '/books/',
  },
];

// --- Courses rotation pool ---
const courses = [
  {
    title: 'Federated RAGs with LangChain',
    description: 'Build production-ready Retrieval Augmented Generation pipelines.',
    cover: '/blog/courses/pluralsight-federated-rags.jpg',
    url: '/courses/',
    platform: 'Pluralsight',
  },
  {
    title: 'RAG with LangChain',
    description: 'Master Retrieval Augmented Generation for AI applications.',
    cover: '/blog/courses/pluralsight-rag.jpg',
    url: '/courses/',
    platform: 'Pluralsight',
  },
  {
    title: 'MLOps Fundamentals',
    description: 'Learn machine learning operations for production AI systems.',
    cover: '/blog/courses/coursera-mlops.jpg',
    url: '/courses/',
    platform: 'Coursera',
  },
  {
    title: 'Observability in Cloud',
    description: 'Master observability patterns for cloud-native applications.',
    cover: '/blog/courses/coursera-observability.jpg',
    url: '/courses/',
    platform: 'Coursera',
  },
  {
    title: 'Infrastructure Servers & Security',
    description: 'Secure APIs and back-end infrastructure patterns.',
    cover: '/blog/courses/coursera-infrastructure-servers.jpg',
    url: '/courses/',
    platform: 'Coursera',
  },
  {
    title: 'Root Cause Analysis',
    description: 'Systematic troubleshooting for production systems.',
    cover: '/blog/courses/coursera-rca.jpg',
    url: '/courses/',
    platform: 'Coursera',
  },
  {
    title: 'CI/CD Pipelines',
    description: 'Build and optimize continuous integration and delivery workflows.',
    cover: '/blog/courses/coursera-pipeline.jpg',
    url: '/courses/',
    platform: 'Coursera',
  },
  {
    title: 'Ansible Automation',
    description: 'Complete Ansible course from basics to advanced automation.',
    cover: '/blog/courses/educative-ansible.jpg',
    url: '/courses/',
    platform: 'Educative',
  },
  {
    title: 'Securing Cloud Operations',
    description: 'Cloud security best practices and operational hardening.',
    cover: '/blog/courses/starweaver-securing-cloud-operations.jpg',
    url: '/courses/',
    platform: 'Starweaver',
  },
  {
    title: 'Azure DevTest Labs',
    description: 'Optimize development and testing environments on Azure.',
    cover: '/blog/courses/pluralsight-azure-devtest.jpg',
    url: '/courses/',
    platform: 'Pluralsight',
  },
];

// Deterministic rotation based on URL path
const url = Astro.url.pathname || '';
let hash = 0;
for (let i = 0; i < url.length; i++) {
  hash = ((hash << 5) - hash + url.charCodeAt(i)) | 0;
}
hash = Math.abs(hash);

const book = books[hash % books.length];
const course = courses[hash % courses.length];

// Static promos
const staticPromos = {
  service: {
    eyebrow: '🤝 Need Expert Help?',
    title: 'The Production AI Experty Services',
    description: 'From architecture assessment to hands-on delivery. Let me help your team adopt AI and cloud-native technologies the right way.',
    cta: 'Book a Call',
    ctaUrl: '/contact/',
    accent: 'border-purple-500',
    image: '/blog/promo/service.jpg',
  },
  newsletter: {
    eyebrow: '📬 Stay in the Loop',
    title: 'Get Weekly Production AI Insights',
    description: 'Practical notes on AI agents, Claude Code, Kubernetes and GPU platforms from real projects. No spam, unsubscribe anytime.',
    cta: 'Subscribe Free',
    ctaUrl: 'https://luca-berton.kit.com/ce74a48bfa',
    accent: 'border-amber-500',
    image: '/blog/promo/newsletter.jpg',
    external: true,
  },
  vps: {
    eyebrow: '🖥️ Recommended Hosting (Affiliate)',
    title: 'Run It 24/7: RackNerd 4GB KVM VPS',
    description: "Self-hosted agents, Docker stacks and automations need a machine that stays on. RackNerd's KVM VPS gives you 3 vCPU cores, 4GB RAM, 60GB SSD, and 7TB bandwidth for $59.99/year — dedicated resources with no free-tier capacity queue, enough for OpenClaw, Hermes Agent, n8n, Coolify or a single-node K3s.",
    cta: 'Get the 4GB VPS Deal',
    ctaUrl: 'https://my.racknerd.com/aff.php?aff=20981&pid=954',
    accent: 'border-orange-500',
    image: 'https://racknerd.com/banners/970x250.gif',
    imageAlt: 'RackNerd',
    imgWidth: 970,
    imgHeight: 250,
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  atoms: {
    eyebrow: '⚛️ AI App Builder (Affiliate)',
    title: 'Build and Ship AI Apps with Atoms.dev — 10% Off',
    description: 'Atoms.dev is an AI-powered app builder for creating production-ready applications with hosting, authentication, payments, SEO, and more. Use code LUCA10 for 10% off.',
    cta: 'Try Atoms.dev — Use LUCA10',
    ctaUrl: 'https://atoms.dev/register',
    accent: 'border-violet-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  claudeBootcamp: {
    eyebrow: '🤖 Claude Code Workshop (Affiliate)',
    title: 'Claude Code Bootcamp — Save with LUCA20',
    description: 'Join the Packt Claude Code Bootcamp and work through practical Claude Code projects and workflows. Use the exclusive community code LUCA20 when registering.',
    cta: 'Join the Claude Code Bootcamp',
    ctaUrl: 'https://luma.com/claude-code-bootcamp?coupon=LUCA20&utm_source=luca',
    accent: 'border-amber-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  nordicApis: {
    eyebrow: '🔌 API Conference (Partner)',
    title: 'Nordic APIs Summit 2026 — Save 15%',
    description: 'Join the Nordic APIs Summit 2026 in Stockholm and use the community discount code napi26-luca for 15% off your ticket at checkout.',
    cta: 'Get Nordic APIs Summit Tickets',
    ctaUrl: 'https://nordicapis.com/events/platform-summit-2026/?utm_source=lucasbarton&utm_medium=media_partner&utm_campaign=website_listing',
    accent: 'border-blue-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
    // Summit runs Oct 12–14, 2026; the card disappears on the first build after.
    validUntil: '2026-10-14',
  },
  udemyCertification: {
    eyebrow: '🎓 Certification Vouchers (Affiliate)',
    title: 'Udemy AWS Exam Vouchers + Second Chance',
    description: 'Book AWS certification exam vouchers through Udemy and get a Second Chance retake option, with savings of up to 40%.',
    cta: 'View the AWS Voucher Deal',
    ctaUrl: 'https://trk.udemy.com/c/3982066/4052982/39854',
    accent: 'border-purple-500',
    image: 'https://a.impactradius-go.com/display-ad/39854-4052982',
    imageAlt: 'Udemy Certification Exam Vouchers',
    imgWidth: 728,
    imgHeight: 250,
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  udemySecondChance: {
    eyebrow: '🎓 AWS Certification (Affiliate)',
    title: 'Your AWS Exam Retake, Covered',
    description: 'Udemy Second Chance gives AWS certification candidates an exam-retake safety net — up to 40% off two AWS Exam Vouchers.',
    cta: 'Get the AWS Second Chance Deal',
    ctaUrl: 'https://trk.udemy.com/c/3982066/4053014/39854',
    accent: 'border-purple-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  pocket: {
    eyebrow: '🎙️ AI Meeting Recorder (Affiliate)',
    title: 'Pocket — A Dedicated Recorder for Meetings and Calls',
    description: 'Prefer dedicated capture hardware over another meeting bot? Pocket records conversations and turns them into summaries and to-dos you can review after the meeting.',
    cta: 'See the Pocket Launch Offer',
    // Pocket affiliate programme explicitly prohibits referrals from Google Ads.
    // Keep this URL in organic/editorial placements only.
    ctaUrl: 'https://heypocket.com/products/launch?sca_ref=10797518.7Bg39mVX9D',
    accent: 'border-sky-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  flatpay: {
    eyebrow: '💳 Business Payments (Affiliate)',
    title: 'Flatpay — Simple Card Payments for European Merchants',
    description: 'Flatpay offers business payment terminals with transparent flat pricing, zero setup cost, and daily payouts. A practical option for founders and merchants comparing payment providers.',
    cta: 'Explore Flatpay',
    ctaUrl: 'https://try.flatpay.com/lmd1w8x5omhj',
    accent: 'border-emerald-500',
    image: '',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
  linuxFoundation: {
    eyebrow: '🐧 Linux & Kubernetes Training (Affiliate)',
    title: 'Linux Foundation Training & Certification',
    description: 'Explore official Linux Foundation training and certification paths for Linux, Kubernetes, cloud-native, security, and open-source technologies.',
    cta: 'Explore Linux Foundation Training',
    // Evergreen Awin creative supplied by the Linux Foundation affiliate programme.
    ctaUrl: 'https://www.awin1.com/cread.php?s=3740967&v=85919&q=500799&r=1937397',
    accent: 'border-blue-600',
    image: 'https://www.awin1.com/cshow.php?s=3740967&v=85919&q=500799&r=1937397',
    imageAlt: 'Linux Foundation training and certification',
    external: true,
    rel: 'nofollow sponsored noopener noreferrer',
  },
};

const cardVariants = ['service', 'vps', 'atoms', 'claudeBootcamp', 'nordicApis', 'udemyCertification', 'udemySecondChance', 'pocket', 'flatpay', 'linuxFoundation'];

// Time-boxed offers (event discounts, coupon codes) set `validUntil`
// (YYYY-MM-DD, inclusive). Evaluated at build time; the site rebuilds on every
// push, so an expired offer drops out instead of promoting a dead code.
const promoValidUntil = (staticPromos as Record<string, { validUntil?: string }>)[variant]?.validUntil;
const promoExpired = !!promoValidUntil && new Date() > new Date(`${promoValidUntil}T23:59:59`);

// GA4 conversion tracking (read by ConversionTracker.astro). One canonical
// affiliate_click event, differentiated by company/offer_id — never
// per-partner event names.
const affiliateMeta: Record<string, { company: string; offerId: string; offerType: string }> = {
  vps: { company: 'racknerd', offerId: 'racknerd_vps_4gb', offerType: 'affiliate' },
  atoms: { company: 'atoms', offerId: 'atoms_luca10', offerType: 'affiliate' },
  claudeBootcamp: { company: 'packt', offerId: 'packt_claude_bootcamp_luca20', offerType: 'affiliate' },
  nordicApis: { company: 'nordic_apis', offerId: 'nordic_apis_summit_2026', offerType: 'partner' },
  udemyCertification: { company: 'udemy', offerId: 'udemy_aws_vouchers', offerType: 'affiliate' },
  udemySecondChance: { company: 'udemy', offerId: 'udemy_second_chance', offerType: 'affiliate' },
  pocket: { company: 'pocket', offerId: 'pocket_launch', offerType: 'affiliate' },
  flatpay: { company: 'flatpay', offerId: 'flatpay_partner_referral', offerType: 'affiliate' },
  linuxFoundation: { company: 'linux_foundation', offerId: 'linux_foundation_training', offerType: 'affiliate' },
};

const trackingAttrs = affiliateMeta[variant]
  ? {
      'data-track-event': 'affiliate_click',
      'data-tp-company': affiliateMeta[variant].company,
      'data-tp-offer-id': affiliateMeta[variant].offerId,
      'data-tp-offer-type': affiliateMeta[variant].offerType,
      'data-tp-cta-position': 'post_conclusion',
      'data-tp-cta-variant': variant,
    }
  : variant === 'service'
    ? {
        'data-track-event': 'consulting_cta_click',
        'data-tp-target-offer': 'discovery_call',
        'data-tp-cta-position': 'post_conclusion',
        'data-tp-cta-variant': 'promo_card_service',
      }
    : {};
---

{variant === 'book' && (
  <aside class="not-prose my-10 rounded-xl overflow-hidden border-l-4 border-blue-500 bg-white shadow-sm" role="complementary">
    <a href={book.blogUrl || book.buyUrl} class="block group">
      <div class="flex flex-col sm:flex-row items-center gap-4 p-5 sm:p-6">
        <img
          src={book.cover}
          alt={`${book.title} book cover`}
          width="120"
          height="160"
          loading="lazy"
          decoding="async"
          class="w-24 sm:w-28 h-auto rounded shadow-md flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
        />
        <div class="text-center sm:text-left">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">📘 By Luca Berton</p>
          <p class="text-lg font-bold text-gray-900 mb-1 group-hover:text-blue-600 transition-colors">{book.title}</p>
          <p class="text-sm text-gray-600 mb-3 leading-relaxed">{book.description}</p>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 group-hover:text-blue-800 transition-colors">
            Read about {book.title}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </aside>
)}

{variant === 'course' && (
  <aside class="not-prose my-10 rounded-xl overflow-hidden border-l-4 border-green-500 bg-white shadow-sm" role="complementary">
    <a href={course.url} class="block group">
      <div class="flex flex-col sm:flex-row items-center gap-4 p-5 sm:p-6">
        <img
          src={course.cover}
          alt={`${course.title} course cover`}
          width="200"
          height="120"
          loading="lazy"
          decoding="async"
          class="w-40 sm:w-48 h-auto rounded shadow-md flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
        />
        <div class="text-center sm:text-left">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">🎓 {course.platform} Course</p>
          <p class="text-lg font-bold text-gray-900 mb-1 group-hover:text-green-600 transition-colors">{course.title}</p>
          <p class="text-sm text-gray-600 mb-3 leading-relaxed">{course.description}</p>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-green-600 group-hover:text-green-800 transition-colors">
            Browse Courses
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </aside>
)}

{variant === 'newsletter' && (
  <aside class="not-prose my-10 overflow-hidden rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-sky-50 shadow-sm" aria-label="Newsletter">
    <div class="p-6 sm:p-8">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-indigo-600/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-indigo-700">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Free newsletter
        </p>
        <p class="mt-3 text-2xl font-black tracking-tight text-slate-900">Production AI notes, once a week</p>
        <p class="mt-2 text-[15px] leading-relaxed text-slate-600">The fixes, configs and talk notes I write up from real projects: AI agents, Claude Code, Kubernetes and GPU platforms.</p>
        <form
          class="newsletter-inline mt-5 flex flex-col gap-2 sm:flex-row"
          action="https://app.kit.com/forms/9153490/subscriptions"
          method="post"
          target="_blank"
          data-track-start-event="email_signup_start"
          data-tp-form-id="kit_ce74a48bfa"
          data-tp-cta-position="inline_25"
          data-tp-cta-variant="inline_email_form"
        >
          <label class="contents">
          <span class="sr-only">Email address</span>
          <input
            type="email"
            name="email_address"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-base text-slate-900 placeholder-slate-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 sm:max-w-xs"
          />
          </label>
          <button
            type="submit"
            class="min-h-12 whitespace-nowrap rounded-xl bg-indigo-600 px-6 font-bold text-white shadow-md shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-500"
          >
            Subscribe free
          </button>
        </form>
        <p class="newsletter-status mt-2 text-xs text-slate-500" role="status">No spam. One click to unsubscribe.</p>
      </div>
    </div>
  </aside>
)}

{variant === 'newsletter' && (
  <script is:inline>
    (function () {
      if (window.__newsletterInlineBound) return;
      window.__newsletterInlineBound = true;
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form.classList || !form.classList.contains('newsletter-inline')) return;
        e.preventDefault();
        var status = form.parentNode.querySelector('.newsletter-status');
        var button = form.querySelector('button');
        button.disabled = true;
        button.textContent = 'Subscribing...';
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json().catch(function () { return {}; }); })
          .then(function () {
            form.style.display = 'none';
            status.className = 'newsletter-status mt-3 text-sm font-semibold text-emerald-700';
            status.textContent = 'Almost there: check your inbox and confirm your email.';
            var params = { form_id: 'kit_ce74a48bfa' };
            if (typeof window.lucaTrack === 'function') window.lucaTrack('email_signup', params);
            else if (typeof window.gtag === 'function') window.gtag('event', 'email_signup', params);
          })
          .catch(function () {
            // Fall back to Kit's own page in a new tab, with the email already typed.
            button.disabled = false;
            button.textContent = 'Subscribe free';
            form.submit();
          });
      });
    })();
  </script>
)}

{cardVariants.includes(variant) && !promoExpired && (() => {
  const promo = staticPromos[variant];
  return (
    <aside class={`not-prose my-10 rounded-xl overflow-hidden border-l-4 ${promo.accent}`} role="complementary">
      <a
        href={promo.ctaUrl}
        target={promo.external ? '_blank' : undefined}
        rel={promo.external ? (promo.rel || 'noopener') : undefined}
        class="block group"
        {...trackingAttrs}
      >
        {promo.image && (
          <img
            src={promo.image}
            alt={promo.imageAlt || promo.title}
            width={promo.imgWidth || 1200}
            height={promo.imgHeight || 300}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        )}
        <div class="p-5 sm:p-6 bg-white">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">{promo.eyebrow}</p>
          <p class="text-lg font-bold text-gray-900 mb-1 group-hover:text-blue-600 transition-colors">{promo.title}</p>
          <p class="text-sm text-gray-600 mb-3 leading-relaxed">{promo.description}</p>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 group-hover:text-blue-800 transition-colors">
            {promo.cta}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </a>
    </aside>
  );
})()}
