---
/**
 * One book, with its cover: the shared book visual for the whole site.
 *
 *   layout="row"    cover left, text right, pills and buttons below the text.
 *                   Adapts to its own width (container queries): compact in a
 *                   two-offer box or on a phone, roomy when it has the full
 *                   column. Used by TopicOfferBox, TeamRolloutBox and
 *                   MasterclassFeature.
 *   layout="shelf"  cover standing on a tinted shelf above the text, for the
 *                   book grids on /books/ and the home page. On phones it
 *                   turns into a row so a long list stays short.
 *
 * tone="dark" is for dark panels (TeamRolloutBox). tint picks the soft colour
 * wash from the book's topic (src/data/books.ts).
 *
 * Actions keep whatever attributes the caller passes: an action with `offer`
 * renders data-track-event="offer_click" with data-tp-offer / -placement, so
 * ConversionTracker records it exactly as before.
 */
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import BookCover from "./BookCover.astro";
import type { BookTopic } from "../data/books";

export interface BookAction {
  label: string;
  href: string;
  /** primary: solid button; secondary: outlined button; link: quiet text link. */
  variant?: "primary" | "secondary" | "link";
  ariaLabel?: string;
  target?: string;
  rel?: string;
  /** offer_click: offer id and placement (src/config/analytics-taxonomy.json). */
  offer?: string;
  placement?: string;
}

/** Small secondary link to the book's Leanpub team packs (3–25 copies). */
export interface BookTeamLink {
  href: string;
  /** offer_click offer id; the link adds data-tp-team="true". */
  offer?: string;
  placement?: string;
}

export interface Props {
  title: string;
  blurb: string;
  cover: ImageMetadata;
  eyebrow?: string;
  author?: string;
  pills?: string[];
  actions: BookAction[];
  team?: BookTeamLink | null;
  layout?: "row" | "shelf";
  tone?: "light" | "dark";
  tint?: BookTopic;
  headingLevel?: "h2" | "h3" | "h4" | "p";
  class?: string;
}

const {
  title,
  blurb,
  cover,
  eyebrow = "Ebook by Luca Berton",
  author,
  pills = ["Ebook", "Leanpub"],
  actions,
  team,
  layout = "row",
  tone = "light",
  tint = "ai",
  headingLevel = "p",
  class: className,
} = Astro.props;

const Heading = headingLevel;
const coverSizes = layout === "shelf" ? "(max-width: 639px) 88px, 128px" : "(max-width: 639px) 104px, 136px";
---

<article
  class:list={["bc-card bc-lift", `bc-card--${layout}`, className]}
  data-bc-tint={tint}
  data-bc-tone={tone}
  data-book-card
>
  <div class="bc-grid">
    <div class="bc-stage">
      <BookCover src={cover} title={title} class="bc-stage__cover" sizes={coverSizes} widths={[104, 136, 208, 272]} />
    </div>

    <div class="bc-text">
      <p class="bc-eyebrow">{eyebrow}</p>
      <Heading class="bc-title">{title}</Heading>
      {author && <p class="bc-author">by {author}</p>}
      <p class="bc-blurb">{blurb}</p>
    </div>

    <div class="bc-actions">
      {pills.length > 0 && (
        <ul class="bc-pills" aria-label="Format">
          {pills.map((p, i) => (
            <li class="bc-pill">
              {i === 0 && <Icon name="bx:bxs-book-open" class="bc-pill__icon" aria-hidden="true" />}
              {p}
            </li>
          ))}
        </ul>
      )}
      <div class="bc-buttons">
        {actions.map((a) =>
          a.offer ? (
            <a
              href={a.href}
              target={a.target}
              rel={a.rel}
              aria-label={a.ariaLabel}
              data-track-event="offer_click"
              data-tp-offer={a.offer}
              data-tp-placement={a.placement}
              class:list={["bc-btn", `bc-btn--${a.variant ?? "primary"}`]}
            >
              <span>{a.label}</span>
              <span class="bc-btn__arrow" aria-hidden="true">→</span>
            </a>
          ) : (
            <a
              href={a.href}
              target={a.target}
              rel={a.rel}
              aria-label={a.ariaLabel}
              class:list={["bc-btn", `bc-btn--${a.variant ?? "primary"}`]}
            >
              <span>{a.label}</span>
              <span class="bc-btn__arrow" aria-hidden="true">→</span>
            </a>
          ),
        )}
      </div>
      {team && (team.offer ? (
        <a
          href={team.href}
          data-track-event="offer_click"
          data-tp-offer={team.offer}
          data-tp-placement={team.placement}
          data-tp-team="true"
          aria-label={`Buying for your team? Team packs from 3 copies: ${title} on Leanpub`}
          class="bc-team"
        >
          <span>Buying for your team? <span class="bc-team__em">Team packs from 3 copies <span class="bc-btn__arrow" aria-hidden="true">→</span></span></span>
        </a>
      ) : (
        <a
          href={team.href}
          aria-label={`Buying for your team? Team packs from 3 copies: ${title} on Leanpub`}
          class="bc-team"
        >
          <span>Buying for your team? <span class="bc-team__em">Team packs from 3 copies <span class="bc-btn__arrow" aria-hidden="true">→</span></span></span>
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  /* ---- Tints (soft washes from the book's topic) ------------------------ */
  :global([data-bc-tint="ai"]) {
    --bc-wash: #fff4ea;
    --bc-wash-2: #ffe8d6;
    --bc-glow: rgb(251 146 60 / 0.3);
    --bc-line: rgb(234 88 12 / 0.2);
    --bc-accent: #c2410c;
  }
  :global([data-bc-tint="kubernetes"]) {
    --bc-wash: #eef4ff;
    --bc-wash-2: #dde8ff;
    --bc-glow: rgb(96 165 250 / 0.32);
    --bc-line: rgb(37 99 235 / 0.2);
    --bc-accent: #1d4ed8;
  }
  :global([data-bc-tint="ansible"]) {
    --bc-wash: #ebfaf6;
    --bc-wash-2: #d3f3ea;
    --bc-glow: rgb(45 212 191 / 0.3);
    --bc-line: rgb(13 148 136 / 0.22);
    --bc-accent: #0f766e;
  }
  :global([data-bc-tint="linux_cloud"]) {
    --bc-wash: #fff1f2;
    --bc-wash-2: #ffe1e5;
    --bc-glow: rgb(251 113 133 / 0.28);
    --bc-line: rgb(225 29 72 / 0.18);
    --bc-accent: #be123c;
  }

  /* ---- Card ------------------------------------------------------------- */
  .bc-card {
    --bc-surface: linear-gradient(135deg, var(--bc-wash) 0%, #ffffff 58%);
    --bc-border: var(--bc-line);
    --bc-title: #0f172a;
    --bc-body: #475569;
    --bc-muted: #64748b;
    --bc-pill-bg: rgb(255 255 255 / 0.85);
    --bc-pill-text: var(--bc-accent);
    --bc-btn-bg: #0f172a;
    --bc-btn-bg-hover: #1e293b;
    --bc-btn-text: #ffffff;
    --bc-btn2-text: #0f172a;
    --bc-btn2-border: rgb(15 23 42 / 0.22);
    --bc-btn2-hover: rgb(15 23 42 / 0.05);
    --bc-ring: #2563eb;

    position: relative;
    container-type: inline-size;
    height: 100%;
    border: 1px solid var(--bc-border);
    border-radius: 1rem;
    background: var(--bc-surface);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    text-align: left;
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .bc-card:hover {
    box-shadow:
      0 1px 2px rgb(15 23 42 / 0.05),
      0 14px 32px -18px rgb(15 23 42 / 0.28);
  }

  .bc-card[data-bc-tone="dark"] {
    --bc-surface: linear-gradient(135deg, rgb(255 255 255 / 0.08) 0%, rgb(255 255 255 / 0.03) 60%);
    --bc-border: rgb(255 255 255 / 0.12);
    --bc-title: #ffffff;
    --bc-body: #cbd5e1;
    --bc-muted: #94a3b8;
    --bc-accent: #5eead4;
    --bc-pill-bg: rgb(255 255 255 / 0.07);
    --bc-pill-text: #ccfbf1;
    --bc-btn-bg: #2dd4bf;
    --bc-btn-bg-hover: #5eead4;
    --bc-btn-text: #020617;
    --bc-btn2-text: #ffffff;
    --bc-btn2-border: rgb(255 255 255 / 0.3);
    --bc-btn2-hover: rgb(255 255 255 / 0.08);
    --bc-ring: #5eead4;
    box-shadow: none;
  }

  /* ---- Row layout ------------------------------------------------------- */
  .bc-card--row {
    padding: 1.125rem;
  }
  .bc-card--row .bc-grid {
    display: grid;
    height: 100%;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "stage text"
      "actions actions";
    gap: 1rem 1.125rem;
  }
  @container (min-width: 18rem) {
    .bc-card--row .bc-grid {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }
  @container (min-width: 32rem) {
    .bc-card--row {
      padding: 1.5rem;
    }
    .bc-card--row .bc-grid {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      grid-template-areas:
        "stage text"
        "stage actions";
      column-gap: 1.75rem;
    }
  }
  @container (min-width: 40rem) {
    .bc-card--row .bc-grid {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }
  }
  .bc-card--row .bc-stage {
    grid-area: stage;
    padding-top: 0.125rem;
  }
  .bc-card--row .bc-actions {
    align-self: end;
  }
  @container (min-width: 32rem) {
    .bc-card--row .bc-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem 1rem;
    }
    .bc-card--row .bc-actions .bc-pills {
      margin: 0;
    }
    .bc-card--row .bc-buttons {
      flex: 0 1 auto;
    }
  }

  /* ---- Shelf layout ----------------------------------------------------- */
  .bc-card--shelf {
    overflow: hidden;
  }
  .bc-card--shelf .bc-grid {
    display: grid;
    height: 100%;
    grid-template-columns: 7rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "stage text"
      "actions actions";
  }
  .bc-card--shelf .bc-stage {
    grid-area: stage;
    padding: 1.125rem 0 0 1.125rem;
  }
  .bc-card--shelf .bc-text {
    padding: 1.125rem 1.125rem 0 1rem;
  }
  .bc-card--shelf .bc-actions {
    padding: 1rem 1.125rem 1.125rem;
    align-self: end;
  }
  @media (min-width: 640px) {
    .bc-card--shelf {
      --bc-surface: #ffffff;
    }
    .bc-card--shelf .bc-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "stage" "text" "actions";
    }
    .bc-card--shelf .bc-stage {
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      height: 16rem;
      padding: 1.5rem 1.5rem 0.875rem;
      background:
        radial-gradient(120% 70% at 50% 0%, var(--bc-glow) 0%, transparent 70%),
        linear-gradient(180deg, var(--bc-wash) 0%, var(--bc-wash-2) 100%);
      border-bottom: 1px solid var(--bc-line);
    }
    /* The shelf the book stands on. */
    .bc-card--shelf .bc-stage::after {
      content: "";
      position: absolute;
      left: 14%;
      right: 14%;
      bottom: 0.5rem;
      height: 0.625rem;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(15 23 42 / 0.22), transparent);
      z-index: 0;
    }
    .bc-card--shelf .bc-text {
      padding: 1.25rem 1.375rem 0;
    }
    .bc-card--shelf .bc-actions {
      padding: 1rem 1.375rem 1.375rem;
    }
  }

  .bc-stage :global(.bc-stage__cover) {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  @media (min-width: 640px) {
    .bc-card--shelf .bc-stage :global(.bc-stage__cover) {
      width: 8rem;
      max-height: 100%;
    }
  }

  /* ---- Text ------------------------------------------------------------- */
  .bc-text {
    grid-area: text;
    min-width: 0;
  }
  .bc-eyebrow {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bc-accent);
  }
  .bc-title {
    margin: 0.35rem 0 0;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--bc-title);
    text-wrap: balance;
  }
  @container (min-width: 32rem) {
    .bc-card--row .bc-title {
      font-size: 1.3rem;
    }
  }
  .bc-author {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: var(--bc-muted);
  }
  .bc-blurb {
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--bc-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  .bc-card--shelf .bc-blurb {
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }
  /* Offer cards: short blurbs, show them whole. */
  .bc-card--row .bc-blurb {
    display: block;
    overflow: visible;
  }

  /* ---- Pills and buttons ------------------------------------------------ */
  .bc-actions {
    grid-area: actions;
    min-width: 0;
  }
  .bc-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .bc-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--bc-line);
    border-radius: 999px;
    background: var(--bc-pill-bg);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--bc-pill-text);
  }
  .bc-card[data-bc-tone="dark"] .bc-pill {
    border-color: rgb(255 255 255 / 0.14);
  }
  .bc-pill :global(.bc-pill__icon) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .bc-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .bc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.625rem;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .bc-btn--primary {
    background: var(--bc-btn-bg);
    color: var(--bc-btn-text);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 6px 14px -8px rgb(15 23 42 / 0.55);
  }
  .bc-btn--primary:hover {
    background: var(--bc-btn-bg-hover);
  }
  .bc-btn--secondary {
    border: 1px solid var(--bc-btn2-border);
    background: transparent;
    color: var(--bc-btn2-text);
    font-weight: 700;
  }
  .bc-btn--secondary:hover {
    background: var(--bc-btn2-hover);
  }
  .bc-btn--link {
    min-height: 2.75rem;
    padding: 0.5rem 0.25rem;
    color: var(--bc-accent);
    font-weight: 700;
  }
  .bc-btn--link:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bc-team {
    display: inline-flex;
    flex-basis: 100%;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--bc-muted);
    text-decoration: none;
  }
  .bc-team__em {
    white-space: nowrap;
    font-weight: 700;
    color: var(--bc-accent);
  }
  .bc-team:hover .bc-team__em {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bc-team .bc-btn__arrow {
    display: inline-block;
  }
  .bc-team:hover .bc-btn__arrow {
    transform: translateX(3px);
  }
  .bc-card[data-bc-tone="dark"] :global(.bc-cover__edge) {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  .bc-team:focus-visible {
    outline: 3px solid var(--bc-ring);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }
  .bc-btn__arrow {
    transition: transform 0.2s ease;
  }
  .bc-btn:hover .bc-btn__arrow {
    transform: translateX(3px);
  }
  .bc-btn:focus-visible {
    outline: 3px solid var(--bc-ring);
    outline-offset: 2px;
    border-radius: 0.625rem;
  }
</style>
