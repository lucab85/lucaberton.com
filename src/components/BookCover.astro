---
/**
 * A book cover with the physical treatment: rounded corners, a layered
 * shadow, a subtle spine edge and a gentle lift when the surrounding card
 * (any ancestor with class "bc-lift") is hovered or holds focus.
 *
 * The parent sets the cover's width (class or style); height follows the
 * image's own aspect ratio, and the image element carries real width/height, so there
 * is no layout shift. Astro resizes the source at build time (no hotlinking).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: ImageMetadata;
  /** Book title; the alt text is "Cover of <title>". */
  title: string;
  class?: string;
  style?: string;
  /** `sizes` for the responsive image; match the widths the parent sets. */
  sizes?: string;
  /** Candidate widths in px (filtered to the source width). */
  widths?: number[];
  loading?: "lazy" | "eager";
}

const { src, title, class: className, style, sizes = "128px", widths = [128, 256, 384], loading = "lazy" } = Astro.props;
let candidates = widths.filter((w) => w < src.width);
if (candidates.length < widths.length) candidates.push(src.width);
candidates = [...new Set(candidates)];
---

<span class:list={["bc-cover", className]} style={style}>
  <Image
    src={src}
    alt={`Cover of ${title}`}
    widths={candidates}
    sizes={sizes}
    loading={loading}
    decoding="async"
    class="bc-cover__img"
  />
  <span class="bc-cover__edge" aria-hidden="true"></span>
</span>

<style>
  .bc-cover {
    position: relative;
    display: block;
    flex-shrink: 0;
    border-radius: 3px 6px 6px 3px;
    background: #e2e8f0;
    box-shadow:
      0 1px 1px rgb(15 23 42 / 0.12),
      0 3px 6px -2px rgb(15 23 42 / 0.16),
      0 12px 22px -10px rgb(15 23 42 / 0.34),
      0 26px 44px -22px rgb(15 23 42 / 0.4);
    transform: translateZ(0);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .bc-cover__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  /* Spine: a dark crease, a highlight, then the board; plus a soft top sheen. */
  .bc-cover__edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgb(0 0 0 / 0.3) 0,
        rgb(0 0 0 / 0.12) 1.6%,
        rgb(255 255 255 / 0.28) 3%,
        rgb(255 255 255 / 0) 5.5%,
        rgb(0 0 0 / 0.07) 7%,
        rgb(0 0 0 / 0) 10%
      ),
      linear-gradient(165deg, rgb(255 255 255 / 0.16) 0, rgb(255 255 255 / 0) 38%);
    box-shadow: inset 0 0 0 1px rgb(15 23 42 / 0.1);
  }

  :global(.bc-lift:hover) .bc-cover,
  :global(.bc-lift:focus-within) .bc-cover {
    transform: translateY(-4px) rotate(-0.6deg);
    box-shadow:
      0 1px 1px rgb(15 23 42 / 0.12),
      0 6px 10px -4px rgb(15 23 42 / 0.18),
      0 18px 30px -12px rgb(15 23 42 / 0.38),
      0 36px 60px -26px rgb(15 23 42 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.bc-lift:hover) .bc-cover,
    :global(.bc-lift:focus-within) .bc-cover {
      transform: none;
    }
  }
</style>
