---
/**
 * The /books/ catalogue: a featured card for Claude Code Masterclass, then
 * every book from src/data/books.ts on shelves grouped by topic. Purchase
 * links keep their destinations (Leanpub via leanpubUrl, with the coupon for
 * Claude Code Masterclass; Amazon short links unchanged).
 */
import BookCard from "./BookCard.astro";
import BookCover from "./BookCover.astro";
import { BOOKS, BOOKS_BY_ID, BOOK_TOPICS, bookActions, bookByline, bookTeamLink, bookEyebrow, bookPills } from "../data/books";

const featured = BOOKS_BY_ID["claude-code"];
const featuredTeam = bookTeamLink(featured)!;
// Taken from the book's own blurbs (books.ts, MasterclassFeature): no new claims.
const featuredPoints = [
  "Hands-on and project-based: build real-world software with Claude Code",
  "Planning, testing and refactoring with an AI pair",
  "Git workflows and production readiness",
];
const shelves = BOOK_TOPICS.map((t) => ({
  ...t,
  anchor: `shelf-${t.id.replace(/_/g, "-")}`,
  books: BOOKS.filter((b) => b.topic === t.id && b.id !== featured.id),
})).filter((s) => s.books.length > 0);
---

<div class="book-shelf" data-book-shelf>
  <!-- Featured ebook -->
  <section class="featured bc-lift" aria-labelledby="featured-book-title" data-featured-book>
    <div class="featured__cover">
      <BookCover src={featured.cover} title={featured.title} sizes="(max-width: 639px) 160px, 232px" widths={[160, 232, 320, 464, 640]} loading="eager" />
    </div>
    <div class="featured__text">
      <p class="featured__eyebrow">Featured ebook · by Luca Berton</p>
      <h2 id="featured-book-title" class="featured__title">{featured.title}</h2>
      <p class="featured__blurb">{featured.blurb}</p>
      <ul class="featured__points">
        {featuredPoints.map((p) => (
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.6 13.2 4.4 10l-1.1 1.1 4.3 4.3 9.1-9.1-1.1-1.1z" fill="currentColor" /></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <ul class="featured__pills" aria-label="Format">
        <li>Ebook · Leanpub</li>
        <li>PDF · EPUB</li>
        <li>Also on Amazon</li>
      </ul>
      <div class="featured__buttons">
        <a href={featured.leanpub} class="featured__btn featured__btn--primary" aria-label={`Get the ebook on Leanpub: ${featured.title}`}>
          Get the ebook on Leanpub <span aria-hidden="true">→</span>
        </a>
        <a href={featured.amazon} class="featured__btn featured__btn--secondary" aria-label={`Buy on Amazon: ${featured.title}`}>
          Buy on Amazon
        </a>
      </div>
      <a href={featuredTeam} class="featured__team" aria-label={`Buying for your team? Team packs from 3 copies: ${featured.title} on Leanpub`}>
        <span>Buying for your team? <strong>Team packs from 3 copies <span aria-hidden="true">→</span></strong></span>
      </a>
    </div>
  </section>

  <!-- Topic jump links -->
  <nav class="shelf-nav" aria-label="Book topics">
    {shelves.map((s) => (
      <a href={`#${s.anchor}`} data-bc-tint={s.id} class="shelf-nav__link">
        {s.title} <span class="shelf-nav__count">{s.books.length}</span>
      </a>
    ))}
  </nav>

  {shelves.map((s) => (
    <section class="shelf" id={s.anchor} aria-labelledby={`${s.anchor}-title`} data-bc-tint={s.id}>
      <header class="shelf__head">
        <h2 id={`${s.anchor}-title`} class="shelf__title">{s.title}</h2>
        <p class="shelf__blurb">{s.blurb}</p>
      </header>
      <ul class="shelf__grid" role="list">
        {s.books.map((book) => (
          <li>
            <BookCard
              layout="shelf"
              headingLevel="h3"
              title={book.title}
              author={bookByline(book)}
              blurb={book.blurb}
              cover={book.cover}
              eyebrow={bookEyebrow(book)}
              pills={bookPills(book)}
              tint={book.topic}
              actions={bookActions(book)}
              team={bookTeamLink(book) ? { href: bookTeamLink(book)! } : null}
            />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .book-shelf {
    max-width: 72rem;
    margin: 0 auto 4rem;
    text-align: left;
  }

  /* ---- Featured --------------------------------------------------------- */
  .featured {
    position: relative;
    display: grid;
    gap: 1.75rem;
    overflow: hidden;
    padding: 1.75rem 1.25rem;
    border: 1px solid rgb(251 146 60 / 0.25);
    border-radius: 1.5rem;
    background:
      radial-gradient(60% 80% at 18% 30%, rgb(234 88 12 / 0.35) 0%, transparent 70%),
      radial-gradient(50% 60% at 100% 0%, rgb(251 146 60 / 0.16) 0%, transparent 70%),
      linear-gradient(160deg, #1c1410 0%, #0b0a0f 60%, #0f172a 100%);
    color: #ffffff;
    box-shadow: 0 30px 60px -36px rgb(15 23 42 / 0.6);
  }
  @media (min-width: 768px) {
    .featured {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
      padding: 3rem;
    }
  }
  .featured__cover {
    display: flex;
    justify-content: center;
  }
  .featured__cover :global(.bc-cover) {
    width: 10rem;
  }
  @media (min-width: 768px) {
    .featured__cover :global(.bc-cover) {
      width: 14.5rem;
    }
  }
  .featured__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fdba74;
  }
  .featured__title {
    margin: 0.5rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  @media (min-width: 768px) {
    .featured__title {
      font-size: 2.6rem;
    }
  }
  .featured__blurb {
    margin: 0.875rem 0 0;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #e2e8f0;
  }
  .featured__points {
    display: grid;
    gap: 0.5rem;
    margin: 1.125rem 0 0;
    padding: 0;
    list-style: none;
  }
  .featured__points li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #f1f5f9;
  }
  .featured__points svg {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    padding: 0.15rem;
    border-radius: 999px;
    background: rgb(251 146 60 / 0.18);
    color: #fdba74;
  }
  .featured__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .featured__pills li {
    padding: 0.25rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-size: 0.75rem;
    font-weight: 700;
    color: #fed7aa;
  }
  .featured__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .featured__btn {
    display: inline-flex;
    flex: 1 1 14rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .featured__btn {
      flex: 0 0 auto;
    }
  }
  .featured__btn--primary {
    background: linear-gradient(180deg, #fb923c, #f97316);
    color: #1c0a00;
    box-shadow: 0 10px 24px -12px rgb(249 115 22 / 0.8);
  }
  .featured__btn--primary:hover {
    background: linear-gradient(180deg, #fdba74, #fb923c);
  }
  .featured__btn--secondary {
    border: 1px solid rgb(255 255 255 / 0.35);
    color: #ffffff;
  }
  .featured__btn--secondary:hover {
    background: rgb(255 255 255 / 0.08);
  }
  .featured__team {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #cbd5e1;
    text-decoration: none;
  }
  .featured__team strong {
    white-space: nowrap;
    color: #fdba74;
  }
  .featured__team:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .featured__team:focus-visible,
  .featured__btn:focus-visible {
    outline: 3px solid #fdba74;
    outline-offset: 3px;
  }

  /* ---- Topic nav -------------------------------------------------------- */
  .shelf-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 2.5rem 0 0;
  }
  .shelf-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--bc-line);
    border-radius: 999px;
    background: var(--bc-wash);
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
  }
  .shelf-nav__link:hover {
    background: var(--bc-wash-2);
  }
  .shelf-nav__count {
    min-width: 1.5rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: #ffffff;
    font-size: 0.75rem;
    text-align: center;
    color: var(--bc-accent);
  }

  /* ---- Shelves ---------------------------------------------------------- */
  .shelf {
    margin-top: 3.5rem;
    scroll-margin-top: 6rem;
  }
  .shelf__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-bottom: 0.875rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--bc-line);
  }
  .shelf__title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: #0f172a;
  }
  .shelf__blurb {
    margin: 0;
    font-size: 0.95rem;
    color: #475569;
  }
  .shelf__grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .shelf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .shelf__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .shelf__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
