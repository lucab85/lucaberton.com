---
/**
 * AI Platform Engineer Bootcamp application form.
 * Same Web3Forms pattern as contactform.astro, extended with the
 * qualification fields from the bootcamp landing page, plus a gtag
 * conversion event and an inline thank-you swap on success.
 */
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="bootcamp-application-form"
  class="needs-validation bg-white rounded-2xl shadow-xl border border-gray-200 p-6 sm:p-8"
  novalidate>

  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value="New AI Platform Engineer Bootcamp application" />
  <input type="hidden" name="from_name" value="AI Platform Engineer Bootcamp" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" tabindex="-1" aria-hidden="true" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="bc-name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
      <input id="bc-name" type="text" name="name" autocomplete="name" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500" />
      <div class="invalid-feedback text-red-600 text-sm mt-1">Please enter your full name.</div>
    </div>
    <div>
      <label for="bc-email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
      <input id="bc-email" type="email" name="email" autocomplete="email" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500" />
      <div class="invalid-feedback text-red-600 text-sm mt-1">Please provide a valid email address.</div>
    </div>
  </div>

  <div class="mt-5">
    <label for="bc-role" class="block text-sm font-medium text-gray-700 mb-1">Current role</label>
    <input id="bc-role" type="text" name="current_role" placeholder="e.g. Senior DevOps Engineer" required aria-required="true"
      class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500" />
    <div class="invalid-feedback text-red-600 text-sm mt-1">Please enter your current role.</div>
  </div>

  <div class="grid sm:grid-cols-3 gap-5 mt-5">
    <div>
      <label for="bc-years" class="block text-sm font-medium text-gray-700 mb-1">Years of experience</label>
      <select id="bc-years" name="years_experience" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500">
        <option value="">Select one</option>
        <option>Under 2 years</option>
        <option>2–5 years</option>
        <option>5–10 years</option>
        <option>10+ years</option>
      </select>
    </div>
    <div>
      <label for="bc-k8s" class="block text-sm font-medium text-gray-700 mb-1">Kubernetes experience</label>
      <select id="bc-k8s" name="kubernetes_experience" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500">
        <option value="">Select one</option>
        <option>None yet</option>
        <option>Basic — deployed workloads, used kubectl</option>
        <option>Intermediate — operate clusters day-to-day</option>
        <option>Advanced — design/run production clusters</option>
      </select>
    </div>
    <div>
      <label for="bc-ai" class="block text-sm font-medium text-gray-700 mb-1">AI infrastructure experience</label>
      <select id="bc-ai" name="ai_infrastructure_experience" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500">
        <option value="">Select one</option>
        <option>None yet</option>
        <option>Some experimentation</option>
        <option>Some production exposure</option>
        <option>Extensive</option>
      </select>
    </div>
  </div>

  <div class="mt-5">
    <label for="bc-outcome" class="block text-sm font-medium text-gray-700 mb-1">What do you want to be able to do after this bootcamp?</label>
    <textarea id="bc-outcome" name="desired_result" required aria-required="true"
      class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md h-24 focus:ring-2 focus:ring-red-500 focus:border-red-500"></textarea>
    <div class="invalid-feedback text-red-600 text-sm mt-1">Please share your desired outcome.</div>
  </div>

  <div class="mt-5">
    <label for="bc-concern" class="block text-sm font-medium text-gray-700 mb-1">Biggest concern about joining (optional)</label>
    <textarea id="bc-concern" name="biggest_concern"
      placeholder="GPU access, time commitment, Kubernetes depth, etc."
      class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md h-20 focus:ring-2 focus:ring-red-500 focus:border-red-500"></textarea>
  </div>

  <div class="grid sm:grid-cols-2 gap-5 mt-5">
    <div>
      <span class="block text-sm font-medium text-gray-700 mb-1">Personal or employer-funded?</span>
      <div class="flex flex-col gap-1.5 mt-1">
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <input type="radio" name="funding" value="Personal" required class="text-red-600 focus:ring-red-500" /> Personal
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <input type="radio" name="funding" value="Employer-funded" class="text-red-600 focus:ring-red-500" /> Employer-funded
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <input type="radio" name="funding" value="Not sure yet" class="text-red-600 focus:ring-red-500" /> Not sure yet
        </label>
      </div>
    </div>
    <div>
      <label for="bc-times" class="block text-sm font-medium text-gray-700 mb-1">Preferred cohort times</label>
      <select id="bc-times" name="preferred_times" required aria-required="true"
        class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500">
        <option value="">Select one</option>
        <option>Europe/UK-friendly evenings</option>
        <option>US-friendly evenings</option>
        <option>APAC-friendly</option>
        <option>Flexible / no preference</option>
      </select>
    </div>
  </div>

  <div class="mt-5">
    <label for="bc-linkedin" class="block text-sm font-medium text-gray-700 mb-1">LinkedIn profile (optional)</label>
    <input id="bc-linkedin" type="url" name="linkedin_profile" placeholder="https://linkedin.com/in/..."
      class="w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 focus:border-red-500" />
  </div>

  <div class="mt-5">
    <label class="inline-flex items-start gap-2 text-sm text-gray-700">
      <input type="checkbox" name="contact_consent" value="yes" required aria-required="true" class="mt-1 text-red-600 focus:ring-red-500" />
      I'm open to a short reply from Luca about my application.
    </label>
    <div class="invalid-feedback text-red-600 text-sm mt-1">Please confirm you're open to a reply.</div>
  </div>

  <button type="submit"
    class="mt-7 w-full inline-flex items-center justify-center px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl shadow-lg shadow-red-600/25 hover:shadow-xl active:scale-[0.98] transition-all duration-200 text-lg">
    Submit Application
  </button>

  <div id="bootcamp-form-result" role="status" aria-live="polite" class="mt-3 text-center text-red-700"></div>
  <p class="mt-3 text-center text-xs text-gray-400">Applying doesn't commit you to purchasing.</p>
</form>

<div id="bootcamp-thank-you" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-8 text-center">
  <h3 class="text-2xl font-bold text-gray-900">Application received</h3>
  <p class="mt-3 text-gray-600 leading-relaxed">
    Thanks — Luca reads every application personally. Founding-cohort dates are confirmed
    by email as seats fill, so keep an eye on your inbox.
  </p>
  <p class="mt-3 text-gray-600 leading-relaxed">
    While you wait, take the
    <a href="/ai-platform-engineer-readiness-scorecard/" class="text-red-600 font-semibold hover:text-red-700">AI Platform Engineer Readiness Scorecard</a>
    to see exactly which skills to focus on first.
  </p>
  <p class="mt-3 text-sm text-gray-500">
    Have a question already? Just reply to the confirmation email. Need an employer
    sponsorship one-pager? Ask and Luca will send it over.
  </p>
</div>

<style>
  .invalid-feedback {
    display: none;
  }
  .was-validated :invalid ~ .invalid-feedback {
    display: block;
  }
</style>

<script is:inline>
  document.getElementById("bootcamp-application-form").addEventListener("submit", function (e) {
    e.preventDefault();
    this.classList.add("was-validated");

    if (!this.checkValidity()) {
      this.querySelector(":invalid").focus();
      return;
    }

    const form = this;
    const formData = new FormData(form);
    const json = JSON.stringify(Object.fromEntries(formData));
    const resultEl = document.getElementById("bootcamp-form-result");
    resultEl.innerText = "Sending...";

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: json,
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.success) {
          form.classList.add("hidden");
          document.getElementById("bootcamp-thank-you").classList.remove("hidden");
          document.getElementById("bootcamp-thank-you").scrollIntoView({ behavior: "smooth", block: "start" });
          if (typeof window.gtag === "function") {
            window.gtag("event", "bootcamp_application_submitted", {
              event_category: "conversion",
            });
          }
        } else {
          resultEl.innerText = data.message || "Something went wrong!";
        }
      })
      .catch(() => {
        resultEl.innerText = "Something went wrong!";
      });
  });
</script>
