---
interface Props {
  campaign?: "managed_agents" | "inference" | "general_cloud";
  placement?: "inline" | "sidebar";
}
const { campaign = "managed_agents", placement = "inline" } = Astro.props;
const creatives = {
  managed_agents: { id: "4977900", group: "622311", width: 600, height: 300, label: "Managed Agents by DigitalOcean", mobileId: "4977895", wideId: "4977904", tallId: "4977902", tallWidth: 600, tallHeight: 900 },
  inference: { id: "4955787", group: "604641", width: 300, height: 250, label: "DigitalOcean Inference Engine", mobileId: "4955787", wideId: "4955790", tallId: "4955788", tallWidth: 300, tallHeight: 600 },
  general_cloud: { id: "4757507", group: "601070", width: 300, height: 250, label: "DigitalOcean cloud infrastructure", mobileId: "4757507", wideId: "4937156", tallId: "4757505", tallWidth: 300, tallHeight: 600 },
} as const;
const creative = creatives[campaign];
const query = (id: string) => `s=${id}&v=123996&q=${creative.group}&r=1937397`;
const href = "https://www.awin1.com/cread.php?" + query(creative.id);
const image = "https://www.awin1.com/cshow.php?" + query(creative.id);
const mobileHref = "https://www.awin1.com/cread.php?" + query(creative.mobileId);
const mobileImage = "https://www.awin1.com/cshow.php?" + query(creative.mobileId);
---
<do-managed-agents-banner class="not-prose my-6 block rounded-lg border border-slate-200 p-4" data-creative-id={creative.id} data-mobile-creative-id={creative.mobileId} data-campaign={campaign} data-placement={placement} data-wide-id={creative.wideId} data-tall-id={creative.tallId} data-tall-width={creative.tallWidth} data-tall-height={creative.tallHeight} data-group={creative.group}>
  <p class="m-0 text-xs font-semibold uppercase text-slate-600">Advertisement · Affiliate link</p>
  <a href={href} data-mobile-href={mobileHref} target="_blank" rel="nofollow sponsored noopener noreferrer"
    data-track-event="affiliate_click" data-tp-company="digitalocean"
    data-tp-offer-id={`digitalocean_${campaign}_${creative.id}`} data-tp-offer-type="affiliate"
    data-tp-cta-position="inline" data-tp-cta-variant="awin_creative"
    class="mt-2 block font-semibold text-blue-700 hover:underline">
    Explore {creative.label}
    <img data-awin-src={image} data-mobile-src={mobileImage} width={creative.width} height={creative.height} alt={creative.label}
      loading="lazy" decoding="async" referrerpolicy="no-referrer" hidden
      class="mt-2 mx-auto h-auto max-w-full rounded" />
  </a>
  <p class="mt-3 text-sm text-slate-600">Loading this optional banner contacts Awin, which may collect advertising measurement data and use cookies. You can use the text link without loading the banner.</p>
  <button type="button" data-load-awin class="mt-2 rounded border border-slate-300 px-3 py-2 text-sm font-semibold">Allow and load advertising banner</button>
</do-managed-agents-banner>
<script>
  class DigitalOceanManagedAgentsBanner extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-load-awin]');
      const image = this.querySelector<HTMLImageElement>('img[data-awin-src]');
      const link = this.querySelector<HTMLAnchorElement>('a[data-mobile-href]');
      if (!button || !image || !link) return;
      button.addEventListener('click', () => {
        const available = this.clientWidth - 32;
        let id = this.dataset.creativeId;
        let width = image.width;
        let height = image.height;
        const tallWidth = Number(this.dataset.tallWidth);
        if (this.dataset.placement === 'sidebar' && available >= tallWidth) {
          id = this.dataset.tallId;
          width = tallWidth;
          height = Number(this.dataset.tallHeight);
        } else if (this.dataset.campaign !== 'managed_agents' && available >= 728) {
          id = this.dataset.wideId;
          width = 728;
          height = 90;
        } else if (available < width) {
          id = this.dataset.mobileCreativeId;
          width = 300;
          height = 250;
        }
        if (!id || !this.dataset.group) return;
        const query = 's=' + id + '&v=123996&q=' + this.dataset.group + '&r=1937397';
        link.href = 'https://www.awin1.com/cread.php?' + query;
        link.dataset.tpOfferId = 'digitalocean_' + this.dataset.campaign + '_' + id;
        this.dataset.creativeId = id;
        image.width = width;
        image.height = height;
        image.src = 'https://www.awin1.com/cshow.php?' + query;
        image.hidden = false;
        button.hidden = true;
      }, { once: true });
    }
  }
  if (!customElements.get('do-managed-agents-banner')) {
    customElements.define('do-managed-agents-banner', DigitalOceanManagedAgentsBanner);
  }
</script>
