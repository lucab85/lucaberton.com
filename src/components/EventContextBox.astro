---
/**
 * Under an event recap: the other write-ups from the same event, the topic and
 * company hubs it belongs to, Luca's evergreen guides on the topic and the
 * matching offer. Everything links only to pages that exist (hubs above their
 * minimum size).
 */
import { formatEventDate, type EventContext, type EventPost } from "@utils/eventGraph";

interface Props {
  event: EventPost["data"]["event"];
  ctx: EventContext;
  /** False on posts that already carry a configured consulting CTA. */
  showOffer?: boolean;
}
const { event, ctx, showOffer = true } = Astro.props;
const offer = showOffer ? ctx.offer : undefined;
const hasLinks = ctx.siblings.length || ctx.topics.length || ctx.companies.length || ctx.guides.length || offer;
---

{hasLinks && (
  <aside class="not-prose mt-12 rounded-xl border border-gray-200 bg-gray-50/60 p-6" aria-label="More from this event">
    <p class="text-xs font-bold uppercase tracking-wider text-gray-500">
      {event.series ? "Event roundup" : `${formatEventDate(event)} · ${event.name}${event.city ? ` · ${event.city}` : ""}`}
    </p>

    {ctx.siblings.length > 0 && (
      <div class="mt-4">
        <p class="font-bold text-gray-900">More from {event.name}</p>
        <ul class="mt-2 space-y-1.5">
          {ctx.siblings.map((p) => (
            <li><a href={`/blog/${p.slug}/`} class="text-blue-600 hover:underline">{p.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    {(ctx.topics.length > 0 || ctx.companies.length > 0) && (
      <div class="mt-5">
        <p class="font-bold text-gray-900">Every event I've written up on</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {ctx.topics.map((t) => (
            <a href={`/events/topics/${t.slug}/`} class="rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium text-gray-800 hover:border-blue-400">{t.label} ({t.count})</a>
          ))}
          {ctx.companies.map((c) => (
            <a href={`/events/companies/${c.slug}/`} class="rounded-full bg-gray-200 px-3 py-1 text-sm font-medium text-gray-800 hover:bg-gray-300">{c.name} ({c.count})</a>
          ))}
        </div>
      </div>
    )}

    {ctx.guides.length > 0 && (
      <div class="mt-5">
        <p class="font-bold text-gray-900">Go deeper</p>
        <ul class="mt-2 space-y-1.5">
          {ctx.guides.map((g) => (
            <li><a href={`/blog/${g.slug}/`} class="text-blue-600 hover:underline">{g.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    {offer && (
      <div class="mt-5 border-t border-gray-200 pt-5">
        <p class="text-gray-700">{offer.blurb}</p>
        <a
          href={offer.href}
          class="mt-3 inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 font-semibold text-white hover:bg-blue-500"
          data-track-event="consulting_cta_click"
          data-tp-target-offer={offer.targetOffer}
          data-tp-cta-position="post_conclusion"
          data-tp-cta-variant="event_recap_context"
        >{offer.label} →</a>
      </div>
    )}
  </aside>
)}
