---
// Responsive event-photo gallery.
//
// Renders a 2-up (desktop) / 1-up (mobile) grid of Astro Image components.
// Each photo is emitted as AVIF + WebP + JPEG with a responsive `srcset`
// (generated by the Sharp image service configured in astro.config.mjs),
// so the browser downloads the smallest format/width it needs — roughly
// half the bytes of shipping a plain JPEG.
//
// Usage (in MDX):
//   import { Image } from "astro:assets";
//   import welcome1 from "../assets/blog/events/<slug>/welcome/IMG.jpg";
//   import EventGallery from "../../components/EventGallery.astro";
//   <EventGallery
//     images={[
//       { src: welcome1, alt: "..." },
//       ...
//     ]}
//   />
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  widths?: number[];
  sizes?: string;
}

const {
  images,
  widths = [320, 640, 960, 1280],
  sizes = "(min-width: 1024px) 50vw, 100vw",
} = Astro.props;
---

<div class="event-gallery">
  {
    images.map((img) => (
      <figure class="event-gallery__item">
        <Image
          src={img.src}
          alt={img.alt}
          formats={["avif", "webp", "jpeg"]}
          widths={widths}
          sizes={sizes}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))
  }
</div>

<style>
  .event-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .event-gallery__item {
    margin: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg-subtle, #f3f4f6);
    line-height: 0;
  }

  .event-gallery__item :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
