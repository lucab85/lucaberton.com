---
/** Event recaps grouped by year: date, event name, city, then the post. */
import { formatEventDate, type EventPost } from "@utils/eventGraph";

interface Props {
  posts: EventPost[];
}
const { posts } = Astro.props;
const years = new Map<string, EventPost[]>();
for (const p of posts) {
  const y = p.data.event.startDate.slice(0, 4);
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(p);
}
---

{[...years].map(([year, ps]) => (
  <section class="mt-10">
    <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 border-b border-gray-100 pb-2">{year}</h2>
    <ul class="mt-4 divide-y divide-gray-100">
      {ps.map((p) => (
        <li class="py-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
            {formatEventDate(p.data.event)} · {p.data.event.name}{p.data.event.city ? ` · ${p.data.event.city}` : ""}
          </p>
          <a href={`/blog/${p.slug}/`} class="mt-1 block text-lg font-bold text-gray-900 hover:text-blue-600">
            {p.data.title}
          </a>
          <p class="mt-1 text-sm text-gray-600">{p.data.snippet}</p>
        </li>
      ))}
    </ul>
  </section>
))}
