---
/**
 * Slim hosting strip at eye level (the Udienza slot) on Hermes Agent and
 * OpenClaw posts: readers there are about to put an agent on a server, and
 * Hostinger has a one-click template for both. The link is Luca's Hostinger
 * referral (sales.hosting), so the post shows the affiliate disclosure and
 * the link is rel="sponsored". The RackNerd card some posts carry at the end
 * stays as the budget option.
 */
import { sales } from "../data/sales";

const { slug, agent } = Astro.props as { slug: string; agent: string };

const LINES: Record<string, string> = {
  "hermes-agent-oracle-cloud-free-tier-deployment": "No free-tier capacity in your region? Hostinger has a one-click Hermes Agent template on its VPS plans.",
  "hermes-agent-low-memory-vps-troubleshooting": "Still short of memory? Move to a VPS with 4 GB or more and install Hermes Agent with Hostinger's one-click template.",
  "openclaw-vps-deployment-always-on-ai-agent": "Want it always on without the setup? Hostinger has a one-click OpenClaw template on its VPS plans.",
};
const line = LINES[slug] ?? `Run ${agent} 24/7 on a VPS: Hostinger has a one-click ${agent} template.`;
---

<aside class="not-prose my-8 flex flex-col gap-3 rounded-xl border border-violet-400/30 bg-gradient-to-r from-slate-950 to-[#1d1438] px-5 py-4 sm:flex-row sm:items-center sm:justify-between" aria-label="Hostinger VPS (referral)" data-hosting-strip>
  <p class="text-sm leading-relaxed text-slate-200">
    <span class="font-bold text-violet-300">🖥️ Host it yourself.</span> {line} My referral link applies a discount.
  </p>
  <a
    href={sales.hosting.url}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    data-track-event="affiliate_click"
    data-tp-company={sales.hosting.company}
    data-tp-offer-id={sales.hosting.offerId}
    data-tp-offer-type="affiliate"
    data-tp-cta-position="inline"
    data-tp-cta-variant="hosting_strip"
    class="inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-violet-400 px-4 py-2 text-sm font-extrabold text-slate-950 transition hover:bg-violet-300"
  >
    See Hostinger VPS →
  </a>
</aside>
