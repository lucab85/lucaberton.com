---
interface Props { variant?: "forms" | "ai_agents"; }
const { variant = "forms" } = Astro.props;
const files = import.meta.glob<string>("../assets/affiliate/jotform/*.png", { eager: true, query: "?url", import: "default" });
const asset = (number: number) => files[`../assets/affiliate/jotform/Jotform_Banner_${number}.png`];
const ai = variant === "ai_agents";
const wide = asset(ai ? 4 : 11);
const compact = asset(ai ? 4 : 13);
const bfWide = ai ? undefined : asset(3);
const bfCompact = ai ? undefined : asset(2);
const href = ai ? "https://www.jotform.com/ai/agents/?partner=lucaberton" : "https://www.jotform.com/?partner=lucaberton";
const alt = ai ? "Jotform: Create your AI agent for customer service" : "Jotform: Create your first form";
---
{wide && compact && (
  <jotform-creative class="not-prose my-4 block" data-variant={variant}
    data-bf-wide={bfWide} data-bf-compact={bfCompact}
    data-wide={wide} data-compact={compact} data-alt={alt} data-href={href}>
    <p class="mb-1 text-xs font-semibold text-slate-600">Advertisement · Affiliate link</p>
    <a href={href} target="_blank" rel="nofollow sponsored noopener noreferrer"
      data-track-event="affiliate_click" data-tp-company="jotform"
      data-tp-offer-type="affiliate" data-tp-offer-id={ai ? "jotform_ai_agents_banner" : "jotform_forms_banner"}
      data-tp-cta-position="inline" data-tp-cta-variant="jotform_creative"
      class="block">
      <picture>
        <source media="(min-width: 640px)" srcset={wide} width={ai ? 1200 : 2400} height={ai ? 1200 : 1000} />
        <img src={compact} alt={alt} width="1200" height={ai ? 1200 : 1000}
          loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-[600px] rounded-lg" />
      </picture>
    </a>
  </jotform-creative>
)}
<script>
  class JotformCreative extends HTMLElement {
    private controller?: AbortController;
    private timer?: number;
    connectedCallback() {
      this.controller?.abort();
      if (this.timer !== undefined) window.clearTimeout(this.timer);
      this.controller = new AbortController();
      const link = this.querySelector<HTMLAnchorElement>("a");
      const source = this.querySelector<HTMLSourceElement>("source");
      const img = this.querySelector<HTMLImageElement>("img");
      if (!link || !source || !img) return;
      const expiry = Date.parse("2026-11-30T07:59:59Z");
      const refresh = () => {
        const seasonal = this.dataset.variant === "forms" && Date.now() < expiry && !!this.dataset.bfWide && !!this.dataset.bfCompact;
        source.srcset = seasonal ? this.dataset.bfWide! : this.dataset.wide!;
        source.width = seasonal ? 3880 : this.dataset.variant === "ai_agents" ? 1200 : 2400;
        source.height = this.dataset.variant === "ai_agents" ? 1200 : 1000;
        img.src = seasonal ? this.dataset.bfCompact! : this.dataset.compact!;
        img.alt = seasonal ? "Jotform Black Friday: 60% off eligible annual plans, ends November 30" : this.dataset.alt!;
        link.href = seasonal ? "https://www.jotform.com/discounts/black-friday/?partner=lucaberton" : this.dataset.href!;
        link.dataset.tpOfferId = seasonal ? "jotform_black_friday_banner" : this.dataset.variant === "ai_agents" ? "jotform_ai_agents_banner" : "jotform_forms_banner";
      };
      refresh();
      window.addEventListener("pageshow", refresh, { signal: this.controller.signal });
      document.addEventListener("visibilitychange", refresh, { signal: this.controller.signal });
      const delay = expiry - Date.now();
      if (delay > 0 && delay <= 2147483647) this.timer = window.setTimeout(refresh, delay);
    }
    disconnectedCallback() {
      this.controller?.abort();
      if (this.timer !== undefined) window.clearTimeout(this.timer);
    }
  }
  if (!customElements.get("jotform-creative")) customElements.define("jotform-creative", JotformCreative);
</script>
