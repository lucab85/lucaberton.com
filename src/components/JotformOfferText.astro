<a data-jotform-offer href="https://www.jotform.com/pricing/?partner=lucaberton"
  target="_blank" rel="nofollow sponsored noopener noreferrer"
  data-track-event="affiliate_click" data-tp-company="jotform"
  data-tp-offer-id="jotform_partner_offer" data-tp-offer-type="affiliate"
  data-tp-cta-position="inline" data-tp-cta-variant="jotform_offer"
  class="font-semibold underline">Partner offer: 50% off annual plans.</a>
<script is:inline>
  (() => {
    const expiry = Date.parse("2026-12-01T00:00:00+01:00");
    const refresh = () => {
      const active = Date.now() < expiry;
      for (const node of document.querySelectorAll("[data-jotform-offer]")) {
        node.textContent = active
          ? "Black Friday: 60% off eligible annual plans through November 30, 2026."
          : "Partner offer: 50% off annual plans.";
        node.href = active
          ? "https://www.jotform.com/discounts/black-friday/?partner=lucaberton"
          : "https://www.jotform.com/pricing/?partner=lucaberton";
        node.dataset.tpOfferId = active ? "jotform_black_friday_2026" : "jotform_partner_offer";
      }
    };
    refresh();
    window.addEventListener("pageshow", refresh);
    document.addEventListener("visibilitychange", refresh);
    const delay = expiry - Date.now();
    if (delay > 0 && delay <= 2147483647) window.setTimeout(refresh, delay);
  })();
</script>
