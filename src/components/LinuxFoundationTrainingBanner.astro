---
import schedule from "../config/linux-foundation-banners.json";
interface Props {
  audience?: "linux" | "cncf";
}
interface Creative {
  id: string;
  group: string;
  width: number;
  height: number;
  label: string;
  offerId: string;
}
interface Campaign {
  audience: "linux" | "cncf";
  start: string;
  end: string;
  creative: Creative;
}
const { audience = "linux" } = Astro.props;
const evergreen: Creative = {
  id: "3740967", group: "500799", width: 1200, height: 300,
  label: "Linux Foundation Training & Certification", offerId: "linux_foundation_training",
};
const campaigns = (schedule.campaigns as Campaign[]).filter(c => c.audience === audience);
const query = `s=${evergreen.id}&v=85919&q=${evergreen.group}&r=1937397`;
---
<lf-training-banner class="not-prose my-10 block rounded-xl border border-slate-200 p-4"
  data-audience={audience} data-evergreen={JSON.stringify(evergreen)} data-campaigns={JSON.stringify(campaigns)}>
  <a href={"https://www.awin1.com/cread.php?" + query} target="_blank" rel="nofollow sponsored noopener noreferrer"
    data-track-event="affiliate_click" data-tp-company="linux_foundation"
    data-tp-offer-id="linux_foundation_training" data-tp-offer-type="affiliate"
    data-tp-cta-position="inline" data-tp-cta-variant="lf_training_banner"
    class="block font-semibold text-blue-700 hover:underline">
    <span class="block text-xs uppercase text-slate-600">Linux & Kubernetes Training (Affiliate)</span>
    <span data-lf-title>{evergreen.label}</span>
    <img data-lf-image width={evergreen.width} height={evergreen.height} alt={evergreen.label}
      loading="lazy" decoding="async" referrerpolicy="no-referrer" hidden
      class="mt-3 h-auto max-w-full mx-auto rounded" />
  </a>
  <p class="mt-3 text-sm text-slate-600">Loading this optional advertisement contacts Awin, which may use cookies and advertising measurement. The text link works without loading the image.</p>
  <button type="button" data-lf-load class="mt-2 rounded border border-slate-300 px-3 py-2 text-sm font-semibold">Allow and load advertising banner</button>
</lf-training-banner>
<script>
  type Creative = { id: string; group: string; width: number; height: number; label: string; offerId: string };
  type Campaign = { start: string; end: string; creative: Creative };
  class LinuxFoundationTrainingBanner extends HTMLElement {
    private timer?: number;
    private cleanup?: () => void;
    connectedCallback() {
      const link = this.querySelector<HTMLAnchorElement>("a");
      const title = this.querySelector<HTMLElement>("[data-lf-title]");
      const image = this.querySelector<HTMLImageElement>("[data-lf-image]");
      const button = this.querySelector<HTMLButtonElement>("[data-lf-load]");
      if (!link || !title || !image || !button) return;
      const evergreen: Creative = JSON.parse(this.dataset.evergreen || "{}");
      const campaigns: Campaign[] = JSON.parse(this.dataset.campaigns || "[]");
      const query = (c: Creative) => `s=${c.id}&v=85919&q=${c.group}&r=1937397`;
      let selected: Creative = evergreen;
      let current = "";
      const refresh = () => {
        window.clearTimeout(this.timer);
        const now = Date.now();
        selected = campaigns.find(c => Date.parse(c.start) <= now && now < Date.parse(c.end))?.creative ?? evergreen;
        const key = query(selected);
        if (key !== current) {
          current = key;
          image.removeAttribute("src");
          image.hidden = true;
          button.hidden = false;
          title.textContent = selected.label;
          image.alt = selected.label;
          image.width = selected.width;
          image.height = selected.height;
          link.href = "https://www.awin1.com/cread.php?" + key;
          link.dataset.tpOfferId = selected.offerId;
        }
        const next = Math.min(...campaigns.flatMap(c => [Date.parse(c.start), Date.parse(c.end)]).filter(t => t > now));
        if (Number.isFinite(next)) this.timer = window.setTimeout(refresh, Math.min(next - now, 2147483647));
      };
      const load = () => {
        refresh();
        image.src = "https://www.awin1.com/cshow.php?" + query(selected);
        image.hidden = false;
        button.hidden = true;
      };
      button.addEventListener("click", load);
      document.addEventListener("visibilitychange", refresh);
      this.cleanup = () => {
        window.clearTimeout(this.timer);
        button.removeEventListener("click", load);
        document.removeEventListener("visibilitychange", refresh);
      };
      refresh();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get("lf-training-banner")) customElements.define("lf-training-banner", LinuxFoundationTrainingBanner);
</script>
