---
// Featured Claude Code Masterclass — Udemy course + companion book.
// Includes Course and Book JSON-LD structured data for rich search results.
import { Picture } from "astro:assets";
import courseThumb from "assets/courses-full/udemy-claude-code.jpg";
import bookCover from "assets/books/claude-code-masterclass.jpg";

const udemyUrl = "https://www.udemy.com/course/claude-code-masterclass-ai-coding/";
const leanpubUrl = "https://leanpub.com/claude-code";
const amazonUrl = "https://amzn.to/4vpWeSx";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Course",
    name: "Claude Code Masterclass: AI-Powered Development",
    description:
      "Master Claude Code for AI-assisted development — from setup to advanced workflows, MCP servers, and team collaboration.",
    url: udemyUrl,
    provider: {
      "@type": "Organization",
      name: "Udemy",
      sameAs: "https://www.udemy.com",
    },
    author: {
      "@type": "Person",
      name: "Luca Berton",
      url: "https://lucaberton.com/",
    },
    offers: {
      "@type": "Offer",
      availability: "https://schema.org/InStock",
      url: udemyUrl,
    },
    hasCourseInstance: {
      "@type": "CourseInstance",
      courseMode: "online",
      courseWorkload: "PT1H37M",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Book",
    name: "Claude Code Masterclass",
    description:
      "Build real-world software with Claude Code — a hands-on, project-based companion covering planning, testing, refactoring, and shipping with AI.",
    url: leanpubUrl,
    bookFormat: "https://schema.org/EBook",
    inLanguage: "en",
    author: {
      "@type": "Person",
      name: "Luca Berton",
      url: "https://lucaberton.com/",
    },
    offers: [
      {
        "@type": "Offer",
        price: "12.99",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: leanpubUrl,
      },
      {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        url: amazonUrl,
      },
    ],
  },
];
---

<section class="my-16 max-w-6xl mx-auto px-4">
  <div class="rounded-3xl bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 border border-indigo-100 p-8 sm:p-12 shadow-lg">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="inline-block bg-indigo-600 text-white text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-4">
        Featured · New
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">
        Claude Code Masterclass
      </h2>
      <p class="text-lg text-gray-700 mt-4">
        Learn AI-assisted software development end to end — take the self-paced video course and grab the hands-on companion book.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Course Card -->
      <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all border border-gray-200 overflow-hidden flex flex-col">
        <a href={udemyUrl} target="_blank" rel="noopener noreferrer" class="block">
          <Picture
            src={courseThumb}
            alt="Claude Code Masterclass — Udemy course by Luca Berton"
            widths={[300, 600, 900]}
            sizes="(max-width: 768px) 100vw, 500px"
            width={1200}
            height={630}
            loading="lazy"
            decoding="async"
            formats={['avif', 'webp']}
            class="w-full h-auto object-cover"
          />
        </a>
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-indigo-100 text-indigo-700 text-xs font-bold px-2 py-1 rounded">COURSE</span>
            <span class="text-sm text-gray-500">Video course · 1h 37m</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900">Self-Paced Video Course</h3>
          <p class="text-gray-600 mt-2 text-sm flex-grow">
            From setup to advanced workflows, MCP servers, sub-agents, and team collaboration — learn Claude Code by building real projects.
          </p>
          <a
            href={udemyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-block text-center text-white bg-indigo-600 hover:bg-indigo-700 px-5 py-3 rounded-lg font-semibold shadow-md transition-all"
          >
            Enroll on Udemy
          </a>
        </div>
      </div>

      <!-- Book Card -->
      <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all border border-gray-200 overflow-hidden flex flex-col">
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex gap-5">
            <a href={leanpubUrl} target="_blank" rel="noopener noreferrer" class="flex-shrink-0">
              <Picture
                src={bookCover}
                alt="Claude Code Masterclass companion book by Luca Berton"
                widths={[120, 200, 280]}
                sizes="140px"
                width={140}
                height={200}
                loading="lazy"
                decoding="async"
                formats={['avif', 'webp']}
                class="w-32 h-auto rounded-lg shadow-md object-contain"
              />
            </a>
            <div class="flex flex-col">
              <div class="flex items-center gap-2 mb-2">
                <span class="bg-purple-100 text-purple-700 text-xs font-bold px-2 py-1 rounded">EBOOK</span>
                <span class="text-sm text-gray-500">PDF · EPUB</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900">Companion Book</h3>
              <p class="text-gray-600 mt-2 text-sm">
                A project-based guide to planning, coding, testing, refactoring, and shipping software with AI.
              </p>
            </div>
          </div>
          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a
              href={leanpubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 text-center text-white bg-purple-600 hover:bg-purple-700 px-5 py-3 rounded-lg font-semibold shadow-md transition-all"
            >
              Get on Leanpub
            </a>
            <a
              href={amazonUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 text-center text-white bg-blue-600 hover:bg-blue-700 px-5 py-3 rounded-lg font-semibold shadow-md transition-all"
            >
              Buy on Amazon
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
