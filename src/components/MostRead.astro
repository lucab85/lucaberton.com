---
/**
 * "Most read this week": ranked list from src/data/most-read.json, refreshed
 * from GA4 organic traffic by scripts/build-most-read.py. The current post is
 * left out; five entries are shown.
 */
import data from "../data/most-read.json";

const { currentSlug } = Astro.props as { currentSlug: string };
const posts = data.posts.filter((p) => p.slug !== currentSlug).slice(0, 5);
---

{posts.length >= 3 && (
  <section class="mt-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-6" aria-labelledby="most-read-heading">
    <h2 id="most-read-heading" class="text-sm font-bold uppercase tracking-wider text-gray-500">Most read this week</h2>
    <ol class="mt-4 space-y-3">
      {posts.map((p, i) => (
        <li class="flex gap-4">
          <span class="w-6 flex-shrink-0 text-2xl font-black leading-none text-teal-600/70">{i + 1}</span>
          <a href={`/blog/${p.slug}/`} class="font-semibold leading-snug text-gray-900 hover:text-blue-600">{p.title}</a>
        </li>
      ))}
    </ol>
  </section>
)}
