---
/**
 * The three ways to buy from Luca, in one strip right under the homepage hero
 * so they are in the first screen: the Claude Code Guardrails Pack, the
 * Production AI Platform Kit, and a call about an assessment or a team
 * rollout. Product cards appear only when their checkout link is set in
 * src/data/sales.ts; the call card always shows.
 */
import { sales, kitLive, claudePackLive } from "../data/sales";

const cards = [
  claudePackLive && {
    eyebrow: "For developers",
    title: sales.claudePack.name,
    text: "Tested hooks, settings presets, a doctor script and a troubleshooting playbook. Install in one command.",
    price: sales.claudePack.price,
    cta: "Get the pack",
    href: sales.claudePack.page,
    offer: "claude_code_guardrails_pack",
    variant: "home_strip_pack",
    accent: "teal",
  },
  kitLive && {
    eyebrow: "For platform teams",
    title: sales.kit.name,
    text: "Two keynote decks with speaker notes, a 90-minute lab and working agent code with guardrails.",
    price: sales.kit.price,
    cta: "Get the kit",
    href: sales.kit.page,
    offer: "production_ai_kit",
    variant: "home_strip_kit",
    accent: "indigo",
  },
  {
    eyebrow: "For engineering leaders",
    title: "Production AI Readiness Assessment",
    text: "Two weeks, fixed scope: the architecture, security, governance and cost gaps between your AI prototype and production.",
    price: "Free 30-min call",
    cta: "Book the call",
    href: "/production-ai-assessment/",
    offer: "production_ai_assessment",
    variant: "home_strip_assessment",
    accent: "red",
  },
].filter(Boolean) as Array<{ eyebrow: string; title: string; text: string; price: string; cta: string; href: string; offer: string; variant: string; accent: string }>;

const accents: Record<string, { ring: string; chip: string; btn: string }> = {
  teal: { ring: "hover:border-teal-400/60", chip: "bg-teal-400/15 text-teal-200", btn: "bg-teal-400 text-slate-950 hover:bg-teal-300" },
  indigo: { ring: "hover:border-indigo-400/60", chip: "bg-indigo-400/15 text-indigo-200", btn: "bg-indigo-500 text-white hover:bg-indigo-400" },
  red: { ring: "hover:border-red-400/60", chip: "bg-red-400/15 text-red-200", btn: "bg-red-600 text-white hover:bg-red-500" },
};
---

<section class="relative z-10 bg-slate-950 px-6 pb-16 lg:px-12" aria-labelledby="offers-heading">
  <div class="mx-auto max-w-7xl">
    <h2 id="offers-heading" class="sr-only">Work with Luca</h2>
    <ul class="grid gap-4 md:grid-cols-3">
      {cards.map((c) => {
        const a = accents[c.accent];
        return (
          <li class={`group flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur transition ${a.ring}`}>
            <p class={`inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${a.chip}`}>{c.eyebrow}</p>
            <h3 class="mt-4 text-xl font-black leading-tight text-white">{c.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-300">{c.text}</p>
            <div class="mt-5 flex items-center justify-between gap-3">
              <span class="text-base font-extrabold text-white">{c.price}</span>
              <a
                href={c.href}
                data-track-event="consulting_cta_click"
                data-tp-target-offer={c.offer}
                data-tp-cta-position="hero"
                data-tp-cta-variant={c.variant}
                class={`inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-xl px-5 font-bold transition ${a.btn}`}
              >
                {c.cta} →
              </a>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="mt-6 text-center text-sm text-slate-400">
      15+ years in enterprise infrastructure · 8 technical books · 40K+ students · KubeCon and Red Hat Summit speaker · Docker Captain
    </p>
  </div>
</section>
