---
/**
 * Hero for the inner pages, on the homepage's three planes:
 *   1. a word set as wide as the stage (the topic of the page);
 *   2. a photo or card standing on its lower part (the `media` slot);
 *   3. a proof number on the corner, then the title, lede and one call to
 *      action bar, as in the homepage hero.
 * `wordSize` is the font size in cqw that makes the word span the stage; it
 * depends on the letters, so measure it once per word (see the
 * three-plane-homepage skill).
 */
interface Props {
  word: string;
  wordSize: number;
  eyebrow: string;
  title: string;
  badge: { value: string; sup?: string; label: string; href?: string };
  cta: { href: string; label: string; note?: string; attrs?: Record<string, string> };
  secondary?: { text: string; href: string; label: string };
  flip?: boolean;
}

const { word, wordSize, eyebrow, title, badge, cta, secondary, flip = false } = Astro.props;
const BadgeTag = badge.href ? "a" : "div";
---

<section class:list={["ph relative isolate overflow-hidden px-5 pb-16 pt-10 sm:px-8 lg:px-12 lg:pb-24 lg:pt-14", { "ph-flip": flip }]}>
  <div class="ph-guides" aria-hidden="true"></div>

  <div class="ph-grid relative mx-auto max-w-7xl">
    <div class="ph-stage">
      <p class="ph-word" style={`font-size: ${wordSize}cqw`} aria-hidden="true">{word}</p>
      <div class="ph-media">
        <slot name="media" />
      </div>
      <BadgeTag href={badge.href} class="ph-badge">
        <span class="ph-badge-value">{badge.value}{badge.sup && <sup>{badge.sup}</sup>}</span>
        <span class="ph-badge-label" set:html={badge.label} />
      </BadgeTag>
    </div>

    <div class="ph-copy">
      <p class="ph-eyebrow">{eyebrow}</p>
      <h1 class="ph-title" set:html={title} />
      <div class="ph-lede">
        <slot />
      </div>
      <a href={cta.href} class="ph-cta group" {...cta.attrs}>
        <span class="mr-auto text-lg font-bold">{cta.label}</span>
        {cta.note && <span class="hidden pl-3 text-sm text-slate-400 min-[380px]:block">{cta.note}</span>}
        <span class="ph-cta-arrow" aria-hidden="true">
          <svg class="h-5 w-5 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M9 7h8v8"></path></svg>
        </span>
      </a>
      {secondary && (
        <p class="mt-3 text-sm font-semibold text-slate-700">
          {secondary.text}{" "}
          <a href={secondary.href} class="font-bold text-slate-950 underline decoration-red-600 decoration-2 underline-offset-4 hover:text-red-700">{secondary.label}</a>
        </p>
      )}
      <slot name="after" />
    </div>
  </div>
</section>

<style is:global>
  .ph {
    background: #f4f0e8;
    color: #020617;
  }
  .ph-guides {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(to right, rgb(15 23 42 / 0.07) 1px, transparent 1px);
    background-size: 25% 100%;
    background-position: 12.5% 0;
  }
  .ph-grid {
    display: grid;
    gap: 2.5rem;
  }

  .ph-stage {
    container-type: inline-size;
    position: relative;
    display: grid;
  }

  /* Plane 1: the word. */
  .ph-word {
    margin: 0 0 -0.2em -0.03em;
    color: #dc2626;
    font-family: "Bricolage Grotesque Condensed", "Bricolage Grotesque Variable", "Arial Narrow", sans-serif;
    font-stretch: 75%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.74;
    letter-spacing: -0.02em;
    white-space: nowrap;
    user-select: none;
  }

  /* Plane 2: the picture or card, standing on the lower part of the word. */
  .ph-media {
    position: relative;
    width: 90%;
    justify-self: end;
    box-shadow: 0 30px 60px -25px rgb(15 23 42 / 0.45);
  }
  .ph-flip .ph-media {
    justify-self: start;
  }
  .ph-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Plane 3: the proof number on the corner. */
  .ph-badge {
    position: absolute;
    left: 0;
    bottom: -1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem;
    background: #0b1120;
    color: #fff;
  }
  a.ph-badge:hover {
    background: #1e293b;
  }
  .ph-flip .ph-badge {
    left: auto;
    right: 0;
  }
  .ph-badge-value {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
  }
  .ph-badge-value sup {
    top: -0.9em;
    font-size: 0.45em;
  }
  .ph-badge-label {
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ph-copy {
    padding-top: 0.5rem;
  }
  .ph-eyebrow {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b91c1c;
  }
  .ph-title {
    margin-top: 0.9rem;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .ph-lede {
    margin-top: 1.2rem;
    margin-bottom: 1.75rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: #334155;
  }

  .ph-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 32rem;
    min-height: 3.75rem;
    padding-left: 1.25rem;
    background: #0b1120;
    color: #fff;
  }
  .ph-cta:hover {
    background: #1e293b;
  }
  .ph-cta-arrow {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 3.75rem;
    background: #dc2626;
  }

  @media (min-width: 1024px) {
    .ph-grid {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 4.5rem;
    }
    .ph-flip .ph-stage {
      order: 2;
    }
    .ph-title {
      font-size: 3.4rem;
    }
  }
</style>
