---
/**
 * High-impact product banner injected mid-article (after the fix) on posts
 * whose readers match a paid product: the Claude Code Guardrails Pack on
 * claude_code posts, the Production AI Platform Kit on other AI/platform posts.
 * Renders nothing unless that product's checkout link is set in sales.ts.
 *
 * Copy is contextual per post (BANNER_COPY): a troubleshooting reader gets a
 * pitch about the error they just fixed, not a generic ad.
 */
import { sales, productFor } from "../data/sales";

export interface Props {
  category: string;
  tags: string[];
  slug: string;
}

const { category, tags, slug } = Astro.props;
const product = productFor(category, tags);

type Copy = { eyebrow: string; headline: string; body: string; variant: string };

const BANNER_COPY: Record<string, Copy> = {
  "claude-code-econnreset-fix": {
    eyebrow: "ECONNRESET again?",
    headline: `The next reset will cost you more than ${sales.claudePack.price}`,
    body: "Every reset is a lost session, a half-finished change and an hour of guessing: VPN, proxy, TLS or your install? The doctor script checks every cause in this post in one run and tells you which fix to try first.",
    variant: "claude_pack_inline_econnreset",
  },
  "fix-claude-code-subscription-disabled-copilot-credit-limit": {
    eyebrow: "Locked out of Claude Code?",
    headline: "Every hour without Claude Code costs more than this pack",
    body: "Find the API key or token that overrides your subscription in one run, and send your admin the request that's already written in the playbook. Back to work instead of back and forth.",
    variant: "claude_pack_inline_subscription",
  },
  "fix-claude-code-homebrew-macos-node-26-install": {
    eyebrow: "Install broken again?",
    headline: "Don't lose another afternoon to a broken install",
    body: "The doctor script lists every claude binary on your PATH, the Node version behind it and the macOS quarantine flag, so you fix the right thing first instead of reinstalling three times.",
    variant: "claude_pack_inline_homebrew",
  },
  "claude-code-pretooluse-hooks-policy-guardrails": {
    eyebrow: "Don't wait for the incident",
    headline: `One wrong rm -rf costs more than ${sales.claudePack.price}`,
    body: "Install these four hooks in one command, before an agent deletes a folder, adds a package published yesterday or commits untested code. Installer, 18 tests and team presets included.",
    variant: "claude_pack_inline_hooks_post",
  },
};

const DEFAULT_PACK: Copy = {
  eyebrow: "Don't wait for the incident",
  headline: `One bad rm -rf costs more than ${sales.claudePack.price}`,
  body: "Claude Code runs commands for you. Four tested hooks stop rm, brand-new packages, untested commits and writes outside the repo, and the doctor script fixes the usual errors before they eat your day.",
  variant: "claude_pack_inline",
};

const KIT: Copy = {
  eyebrow: "Before your agent leaks client data",
  headline: "One data incident costs more than this kit",
  body: "Two editable keynote decks, a 90-minute lab, and working agent code with a tool registry, an egress guard that keeps client names in, a call budget and an audit log you can show an auditor.",
  variant: "kit_inline",
};

const isPack = product === "claudePack";
const offer = isPack ? sales.claudePack : sales.kit;
const copy = isPack ? (BANNER_COPY[slug] ?? DEFAULT_PACK) : KIT;
const targetOffer = isPack ? "claude_code_guardrails_pack" : "production_ai_kit";
const bullets = isPack
  ? ["4 hooks + one-command installer", "Doctor script + troubleshooting PDF", "18 tests · instant download"]
  : ["2 keynote decks, editable", "Working guardrail code, stdlib only", "90-minute lab · instant download"];
---

{product && (
  <aside class="not-prose my-10 overflow-hidden rounded-2xl border border-teal-400/20 bg-[#06121c] shadow-2xl shadow-teal-900/20" aria-label={offer.name} data-product-banner>
    <div class="relative grid gap-7 p-6 sm:p-8 md:grid-cols-[1.1fr_.9fr] md:items-center">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-teal-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 left-10 h-64 w-64 rounded-full bg-sky-600/15 blur-3xl" aria-hidden="true"></div>

      <div class="relative">
        <p class="inline-flex items-center gap-2 rounded-full border border-teal-400/30 bg-teal-400/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-teal-300">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-300"></span>{copy.eyebrow}
        </p>
        <p class="mt-4 text-2xl font-black leading-tight tracking-tight text-white sm:text-3xl">{copy.headline}</p>
        <p class="mt-3 text-[15px] leading-relaxed text-slate-300">{copy.body}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {bullets.map((b) => (
            <li class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs font-semibold text-slate-200">✓ {b}</li>
          ))}
        </ul>
        <div class="mt-6 flex flex-col items-start gap-2.5">
          <a
            href={offer.page}
            data-track-event="consulting_cta_click"
            data-tp-target-offer={targetOffer}
            data-tp-cta-position="inline_25"
            data-tp-cta-variant={copy.variant}
            class="group inline-flex min-h-12 items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-teal-400 px-6 py-3 text-base font-extrabold text-slate-950 shadow-lg shadow-teal-500/25 transition hover:-translate-y-0.5 hover:bg-teal-300"
          >
            {isPack ? "Fix it now" : "Get the kit"} · {offer.price}
            <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
          <span class="text-xs text-slate-400">One-time payment · instant download · less than one lost hour</span>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-xl border border-white/10 bg-[#0b1620] font-mono text-[12.5px] leading-relaxed shadow-xl">
        <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/[0.03] px-3 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-2 text-[11px] text-slate-500">{isPack ? "claude · my-repo" : "agent.py · inside the boundary"}</span>
        </div>
        {isPack ? (
          <div class="space-y-1.5 p-4 text-slate-300">
            <p><span class="text-teal-300">❯</span> clean up the build folder</p>
            <p class="text-slate-500">● Bash(rm -rf build)</p>
            <p class="text-rose-300">  └ Denied by PreToolUse hook</p>
            <p class="pl-5 text-slate-400">rm is blocked by project policy. Use trash with a workspace-relative path instead.</p>
            <p class="text-emerald-300">● Nothing was deleted. I can trash just build/ instead. Want me to?</p>
            <p class="pt-1 text-[11px] text-slate-500">Hook from the pack. rm denial checked in a live Claude Code 2.1.296 session</p>
          </div>
        ) : (
          <div class="space-y-1.5 p-4 text-slate-300">
            <p><span class="text-teal-300">$</span> python agent.py "…clean opinion for Nordvind Facilities AB?"</p>
            <p class="text-slate-500">  → search_client_documents (local)</p>
            <p class="text-rose-300">  ✖ egress guard: tool call blocked (client term)</p>
            <p class="text-slate-500">  → ratiolex__sok_rattsfall "bokföringsbrott revisor ansvar"</p>
            <p class="text-emerald-300">  ✔ NJA 2009 s. 3 · every call in audit.jsonl</p>
            <p class="pt-1 text-[11px] text-slate-500">Illustrative run of the lab's Part 2 agent</p>
          </div>
        )}
      </div>
    </div>
  </aside>
)}
