---
/**
 * Slim strip at eye level on claude_code posts: placed after the article's
 * first paragraph (the Udienza slot). One line of context for the error the
 * reader searched for, one button to the free doctor script
 * (/claude-code-doctor/, an email-gated download). The paid pack keeps its
 * mid-article banner (ProductBanner.astro); this strip is the lead magnet.
 *
 * The click is a newsletter CTA, so it fires email_signup_start with
 * form_id=kit_doctor, the same form_id the download form and its
 * email_signup conversion carry: post → strip → form → signup in one funnel.
 */
const { slug } = Astro.props as { slug: string };

const LINES: Record<string, string> = {
  "claude-code-econnreset-fix": "One script checks every cause below (proxy, VPN, TLS, install) in seconds, before you try them by hand.",
  "fix-claude-code-subscription-disabled-copilot-credit-limit": "One script shows which credential overrides your subscription, so you're back in minutes.",
  "fix-claude-code-homebrew-macos-node-26-install": "One script finds duplicate installs, the wrong Node and the macOS quarantine flag.",
  "claude-code-pretooluse-hooks-policy-guardrails": "One script checks that your hooks are registered, present and executable.",
};
const line = LINES[slug] ?? "One script checks the usual causes of install, auth, network and hook problems, and tells you which fix to try first.";
---

<aside class="not-prose my-8 flex flex-col gap-3 rounded-xl border border-teal-500/30 bg-gradient-to-r from-slate-950 to-[#0b2a33] px-5 py-4 sm:flex-row sm:items-center sm:justify-between" aria-label="Claude Code Doctor, free script">
  <p class="text-sm leading-relaxed text-slate-200">
    <span class="font-bold text-teal-300">🩺 Free: Claude Code Doctor.</span> {line}
  </p>
  <a
    href="/claude-code-doctor/"
    data-track-event="email_signup_start"
    data-tp-form-id="kit_doctor"
    data-tp-cta-position="inline"
    data-tp-cta-variant="doctor_strip"
    class="inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-teal-400 px-4 py-2 text-sm font-extrabold text-slate-950 transition hover:bg-teal-300"
  >
    Get the free script →
  </a>
</aside>
