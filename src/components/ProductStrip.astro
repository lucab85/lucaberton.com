---
/**
 * Slim product strip at eye level: placed after the article's first paragraph
 * (the Udienza slot) on claude_code posts while the pack is on sale. One line
 * of context for the error the reader searched for, one button.
 */
import { sales } from "../data/sales";

const { slug } = Astro.props as { slug: string };

const LINES: Record<string, string> = {
  "claude-code-econnreset-fix": "Run one script that checks every ECONNRESET cause below: proxy, VPN, TLS, install, settings.",
  "fix-claude-code-subscription-disabled-copilot-credit-limit": "Run one script that shows which credential Claude Code is really using, and what overrides your subscription.",
  "fix-claude-code-homebrew-macos-node-26-install": "Run one script that finds duplicate installs, the wrong Node and the macOS quarantine flag.",
  "claude-code-pretooluse-hooks-policy-guardrails": "Get the four hooks below with an installer, 18 tests and team presets.",
};
const line = LINES[slug] ?? "Tested hooks, a doctor script for the usual errors and a troubleshooting playbook, ready to install.";
---

<aside class="not-prose my-8 flex flex-col gap-3 rounded-xl border border-teal-500/30 bg-gradient-to-r from-slate-950 to-[#0b2a33] px-5 py-4 sm:flex-row sm:items-center sm:justify-between" aria-label={sales.claudePack.name}>
  <p class="text-sm leading-relaxed text-slate-200">
    <span class="font-bold text-teal-300">🛡️ {sales.claudePack.name}.</span> {line}
  </p>
  <a
    href={sales.claudePack.page}
    data-track-event="consulting_cta_click"
    data-tp-target-offer="claude_code_guardrails_pack"
    data-tp-cta-position="inline"
    data-tp-cta-variant="claude_pack_strip"
    class="inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-teal-400 px-4 py-2 text-sm font-extrabold text-slate-950 transition hover:bg-teal-300"
  >
    Get it · {sales.claudePack.price} →
  </a>
</aside>
