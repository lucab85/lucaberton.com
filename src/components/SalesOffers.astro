---
/**
 * Paid offers at the end of a post: the Production AI Platform Kit (AI and
 * platform posts) and a paid 1:1 expert call (every post). Each card renders
 * only when its link is set in src/data/sales.ts.
 */
import { sales, kitLive, callLive, kitRelevant } from "../data/sales";

export interface Props {
  category: string;
  tags: string[];
  slug: string;
}

const { category, tags, slug } = Astro.props;
const showKit = kitLive && kitRelevant(category, tags);
const showCall = callLive;
---

{(showKit || showCall) && (
  <div class="mt-8 grid gap-4 sm:grid-cols-2" data-sales-offers>
    {showKit && (
      <div class="rounded-xl border border-teal-200 bg-teal-50/60 p-6 flex flex-col">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700">The talk, the lab and the code</p>
        <p class="mt-2 text-lg font-bold text-gray-900">{sales.kit.name}</p>
        <p class="mt-1 text-sm text-gray-600 flex-1">
          Two editable keynote decks with speaker notes, a 90-minute lab, and working agent code with a tool registry, egress guard, budget and audit log. Instant download.
        </p>
        <a
          href={sales.kit.page}
          data-track-event="kit_cta_click"
          data-tp-target-offer="production_ai_kit"
          data-tp-cta-position="post_footer"
          data-tp-post-slug={slug}
          class="mt-4 inline-flex items-center justify-center px-5 py-3 bg-teal-700 hover:bg-teal-600 text-white font-semibold rounded-lg transition-colors"
        >
          Get the kit · {sales.kit.price}
        </a>
      </div>
    )}
    {showCall && (
      <div class="rounded-xl border border-gray-200 bg-white p-6 flex flex-col">
        <p class="text-xs font-bold uppercase tracking-wider text-blue-700">1:1 expert session</p>
        <p class="mt-2 text-lg font-bold text-gray-900">Stuck on this? Book an hour with Luca</p>
        <p class="mt-1 text-sm text-gray-600 flex-1">
          {sales.expertCall.minutes} minutes on your platform, cluster or agent: a review, a debugging session or a second opinion on a design. Pick a slot and pay when you book.
        </p>
        <a
          href={sales.expertCall.bookingUrl}
          target="_blank"
          rel="noopener"
          data-track-event="expert_call_click"
          data-tp-target-offer="expert_call_60"
          data-tp-cta-position="post_footer"
          data-tp-post-slug={slug}
          class="mt-4 inline-flex items-center justify-center px-5 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-colors"
        >
          Book a session · {sales.expertCall.price}
        </a>
      </div>
    )}
  </div>
)}
