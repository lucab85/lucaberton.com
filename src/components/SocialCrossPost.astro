---
// Small "also watch this on..." row for cross-posted video clips (TikTok,
// Instagram Reels, LinkedIn). Pair with <YouTube id="..." /> for the primary
// embed - this component is just the secondary-platform links, styled as
// chips matching the site's shared vocabulary (see src/styles/global.css).
import { Icon } from "astro-icon/components";

interface Props {
  tiktok?: string;
  instagram?: string;
  linkedin?: string;
  x?: string;
}

const { tiktok, instagram, linkedin, x } = Astro.props;

const platforms = [
  { key: "tiktok", url: tiktok, icon: "simple-icons:tiktok", label: "TikTok" },
  { key: "instagram", url: instagram, icon: "simple-icons:instagram", label: "Instagram" },
  { key: "linkedin", url: linkedin, icon: "simple-icons:linkedin", label: "LinkedIn" },
  { key: "x", url: x, icon: "simple-icons:x", label: "X" },
].filter((p) => p.url);
---

{platforms.length > 0 && (
  <div class="social-cross-post">
    <span class="social-cross-post-label">Also on:</span>
    {platforms.map((p) => (
      <a href={p.url} target="_blank" rel="noopener" class="chip social-cross-post-chip">
        <Icon name={p.icon} class="w-3.5 h-3.5" />
        {p.label}
      </a>
    ))}
  </div>
)}

<style>
  .social-cross-post {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.5rem 0 1.5rem;
  }
  .social-cross-post-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .social-cross-post-chip {
    background: #f9fafb;
    color: #374151;
    border: 1px solid #e5e7eb;
    text-transform: none;
    letter-spacing: normal;
    font-weight: 500;
  }
  .social-cross-post-chip:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }
</style>
