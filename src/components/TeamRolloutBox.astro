---
/**
 * One team-rollout box on the org-policy error posts (plan kind
 * "team_rollout" in src/utils/postCtaPlans.ts), placed right after the fix.
 * Ways forward for a reader who has to ask an admin, or is the admin:
 * public workshop seats and the company cohort (for the team), the
 * "Claude Code Masterclass" ebook on Leanpub (a BookCard with the cover, plus
 * its Leanpub team packs of 3–25 copies), the Claude Code Team Kit
 * (/claude-code-team-kit/, from €29; it replaced the Gumroad Guardrails Pack
 * while Gumroad payouts are paused), and an email that forwards the page to
 * the admin.
 *
 * Every link fires offer_click (offer, placement) through ConversionTracker.
 * Outbound links carry utm_source=lucaberton.com, utm_medium=referral,
 * utm_campaign=claude-code-teams (the ebook: leanpub-claude-code),
 * utm_content=<post slug>. The Team Kit link is internal, so it carries no
 * UTMs (they would start a new GA4 session).
 */
import { claudeCodeTeams, upcomingSessionsText, withTeamsUtm } from "../data/claudeCodeTeams";
import type { TeamRolloutPlan } from "@utils/postCtaPlans";
import { OFFERS, offerHref, teamHref } from "@utils/topicOffers";
import { Icon } from "astro-icon/components";
import BookCard from "./BookCard.astro";
import { BOOKS_BY_ID, bookPills } from "../data/books";

export interface Props {
  slug: string;
  plan: TeamRolloutPlan;
  pageUrl: string;
}

const { slug, plan, pageUrl } = Astro.props;

const dates = upcomingSessionsText();
const { teamKit } = claudeCodeTeams;
const seatHref = withTeamsUtm(claudeCodeTeams.workshopUrl, slug);
const cohortHref = withTeamsUtm(claudeCodeTeams.bookCallUrl, slug);
const adminHref =
  `mailto:?subject=${encodeURIComponent(plan.adminSubject)}` +
  `&body=${encodeURIComponent(`${plan.adminBody}\n${pageUrl}\n\nThanks`)}`;
const headingId = `team-rollout-${slug}`;
const ebook = OFFERS.leanpub_claude_code;
const ebookHref = offerHref(ebook, slug);
const ebookBook = BOOKS_BY_ID[ebook.book!];
// Leanpub team packs: the reader here is buying for a team, so this is a full row, not the small card link.
const teamPackHref = teamHref(ebook, "post_solution")!;
---

<aside
  class="not-prose my-10 overflow-hidden rounded-2xl border border-teal-400/25 bg-slate-950 p-6 text-white shadow-xl shadow-slate-950/10 sm:p-8"
  aria-labelledby={headingId}
  data-team-rollout-box
>
  <p class="text-[0.72rem] font-black uppercase tracking-[0.15em] text-teal-300">Claude Code for Teams</p>
  <h3 id={headingId} class="mt-3 max-w-2xl text-2xl font-extrabold leading-tight tracking-tight text-white sm:text-[1.6rem]">
    {plan.headline}
  </h3>
  <p class="mt-3 max-w-2xl text-[0.98rem] leading-7 text-slate-300">{plan.body}</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-300">Public workshop · one day, remote</p>
      <p class="mt-2 text-lg font-bold">Book a seat</p>
      <p class="mt-1 flex-1 text-sm leading-6 text-slate-300">
        {dates ? <>Next sessions: {dates}.</> : <>New dates on the workshop page.</>} {claudeCodeTeams.seatPrice} a seat, excl. VAT.
      </p>
      <a
        href={seatHref}
        data-track-event="offer_click"
        data-tp-offer="claude_code_teams_seat"
        data-tp-placement="post_solution"
        class="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-teal-400 px-5 py-3 text-sm font-extrabold text-slate-950 transition hover:bg-teal-300"
      >
        See dates and book a seat →
      </a>
    </div>

    <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-300">Your team · up to {claudeCodeTeams.cohortSize} developers</p>
      <p class="mt-2 text-lg font-bold">Company cohort</p>
      <p class="mt-1 flex-1 text-sm leading-6 text-slate-300">
        The same workshop for your developers on a date you choose. {claudeCodeTeams.cohortPrice} excl. VAT for up to {claudeCodeTeams.cohortSize} developers.
      </p>
      <a
        href={cohortHref}
        data-track-event="offer_click"
        data-tp-offer="claude_code_teams_cohort"
        data-tp-placement="post_solution"
        class="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-extrabold text-slate-950 transition hover:bg-slate-200"
      >
        Book a call →
      </a>
    </div>
  </div>

  <div class="mt-4">
    <BookCard
      title={ebook.title}
      blurb="AI-assisted coding with Claude Code: testing, Git workflows, refactoring and production readiness."
      cover={ebookBook.cover}
      eyebrow="Just you · ebook by Luca Berton"
      pills={bookPills(ebookBook)}
      tone="dark"
      tint={ebookBook.topic}
      actions={[
        {
          label: "Get the ebook",
          href: ebookHref,
          ariaLabel: `Get the ebook: ${ebook.title} on Leanpub`,
          offer: "leanpub_claude_code",
          placement: "post_solution",
        },
      ]}
    />
    <a
      href={teamPackHref}
      data-track-event="offer_click"
      data-tp-offer="leanpub_claude_code"
      data-tp-placement="post_solution"
      data-tp-team="true"
      class="group mt-3 flex min-h-11 items-center gap-3 rounded-xl border border-teal-300/35 bg-teal-400/10 px-4 py-3 text-sm leading-6 text-teal-50 transition hover:border-teal-300/60 hover:bg-teal-400/15"
    >
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-400/20 text-teal-200" aria-hidden="true">
        <Icon name="bx:bxs-group" class="h-5 w-5" />
      </span>
      <span class="flex-1">
        <strong class="font-extrabold text-white">Equip the whole team:</strong> {ebook.title} team packs (3–25 copies) on Leanpub
      </span>
      <span class="text-teal-200 transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-300">Your team · ready to install</p>
      <p class="mt-2 text-lg font-bold">{teamKit.name}</p>
      <p class="mt-1 flex-1 text-sm leading-6 text-slate-300">
        Guardrails, managed settings and skills for your team, from {teamKit.fromPrice}.
      </p>
      <a
        href={teamKit.page}
        data-track-event="offer_click"
        data-tp-offer="team-kit"
        data-tp-placement="post_solution"
        class="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg border border-teal-300/60 px-5 py-3 text-sm font-bold text-teal-200 transition hover:bg-teal-400/10"
      >
        See the Team Kit · from {teamKit.fromPrice} →
      </a>
    </div>

    <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-300">Not the admin?</p>
      <p class="mt-2 text-lg font-bold">Forward this to your admin</p>
      <p class="mt-1 flex-1 text-sm leading-6 text-slate-300">
        Opens an email with the error and a link to this page, ready to send.
      </p>
      <a
        href={adminHref}
        data-track-event="offer_click"
        data-tp-offer="forward_to_admin"
        data-tp-placement="post_solution"
        class="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg border border-white/30 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10"
      >
        Email your admin →
      </a>
    </div>
  </div>

  <p class="mt-5 text-xs leading-5 text-slate-400">
    Independent workshop by Luca Berton and Open Empower, not affiliated with Anthropic.
  </p>
</aside>
