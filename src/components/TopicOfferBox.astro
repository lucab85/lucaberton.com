---
/**
 * End-of-post (or after-the-fix) offer box: one or two offers from
 * src/utils/topicOffers.ts (Leanpub ebooks, the GPU cluster design review,
 * the AAP 2.6 Upgrade Review). Every link fires offer_click (offer,
 * placement); external links carry the referral UTMs (offerHref).
 */
import { OFFERS, offerHref, type OfferId } from "@utils/topicOffers";

export interface Props {
  offers: OfferId[];
  postSlug: string;
  headline: string;
  /** offer_click placement: post_conclusion (end of post) or post_solution (after the fix). */
  placement: "post_conclusion" | "post_solution";
}

const { offers: ids, postSlug, headline, placement } = Astro.props;
const offers = ids.slice(0, 2).map((id) => OFFERS[id]);
const headingId = `topic-offer-${placement}`;
---

{offers.length > 0 && (
  <aside
    class="not-prose my-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8"
    aria-labelledby={headingId}
    data-topic-offer-box
  >
    <h3 id={headingId} class="text-xl font-extrabold tracking-tight text-gray-900 sm:text-2xl">{headline}</h3>
    <div class={`mt-5 grid gap-4 ${offers.length > 1 ? "sm:grid-cols-2" : ""}`}>
      {offers.map((o) => (
        <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-teal-700">{o.eyebrow}</p>
          <p class="mt-2 text-lg font-bold text-gray-900">{o.title}</p>
          <p class="mt-1 flex-1 text-sm leading-6 text-gray-600">{o.body}</p>
          <a
            href={offerHref(o, postSlug)}
            data-track-event="offer_click"
            data-tp-offer={o.id}
            data-tp-placement={placement}
            class="mt-4 inline-flex items-center justify-center rounded-lg bg-slate-950 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-slate-800"
          >
            {o.ctaLabel}
          </a>
        </div>
      ))}
    </div>
  </aside>
)}
