---
/**
 * Udienza, Luca's ten-minute video show with the people who build what you
 * run. The image is the "latest episode" banner served by udienza.com, which
 * redraws it when an episode goes out, so this embed never goes stale. The
 * link carries utm_source=lucaberton.com: udienza.com's analytics attribute
 * the visit, and its engagement time, to this site and this placement.
 */
interface Props {
  /** Where on the site the banner sits; ends up in utm_content. */
  placement?: string;
  /** At the top of a page: load the image eagerly and keep the margin tight. */
  eager?: boolean;
}
const { placement = 'blog_end', eager = false } = Astro.props;
const href = `https://www.udienza.com/?utm_source=lucaberton.com&utm_medium=banner&utm_campaign=udienza_banner&utm_content=latest_wide_${placement}`;
const alt = 'Udienza: ten minutes with the people who build what you run. Watch free.';
---

<aside class={`not-prose mx-auto max-w-[735px] ${eager ? 'my-8' : 'mt-12'}`} aria-label="Udienza, the ten-minute video show">
  <a href={href} rel="noopener" class="block overflow-hidden rounded-2xl shadow-lg transition-shadow hover:shadow-xl">
    <picture>
      <source media="(max-width: 640px)" srcset="https://www.udienza.com/banners/latest-square.png" width="600" height="600" />
      <img
        src="https://www.udienza.com/banners/latest-wide.png"
        width="1200"
        height="300"
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="h-auto w-full"
      />
    </picture>
  </a>
</aside>
