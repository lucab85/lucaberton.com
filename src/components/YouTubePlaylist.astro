---
interface Props {
  id: string;
  title?: string;
}

const { id, title = "YouTube playlist player" } = Astro.props;
---

<div class="yt-playlist">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/videoseries?list=${encodeURIComponent(id)}`}
    title={title}
    loading="lazy"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .yt-playlist {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
  }

  .yt-playlist iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0.5rem;
  }
</style>
