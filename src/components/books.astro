---
/**
 * Books section on the home page and /courses/: the first six books from
 * src/data/books.ts as BookCards on a shelf, and a link to /books/ (the full,
 * grouped catalogue, BookShelf.astro). `showAll` lists every book here.
 */
import { Picture } from "astro:assets";
import BookCard from "./BookCard.astro";
import { BOOKS, bookActions, bookByline, bookTeamLink, bookEyebrow, bookPills } from "../data/books";
import fikaWorksDay2025 from "assets/photos/FikaWorksDay2025.jpg";

const { showAll = false } = Astro.props;
const visibleBooks = showAll ? BOOKS : BOOKS.slice(0, 6);
---

<section class="bg-gradient-to-b from-gray-100 to-gray-50 text-center py-12 px-4" data-books-section>
  <!-- Featured Conference Photo -->
  <div class="max-w-4xl mx-auto mb-8">
    <Picture
      src={fikaWorksDay2025}
      alt="Fika Works Day 2025"
      widths={[400, 800, 1200]}
      sizes="(max-width: 800px) 100vw, 800px"
      width={1200}
      height={675}
      loading="lazy"
      formats={['avif', 'webp']}
      class="rounded-lg shadow-lg w-full h-auto"
    />
  </div>

  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl font-extrabold text-gray-900">Discover Luca's Best-Selling Books</h2>
    <p class="text-lg text-gray-700 mt-4">
      Practical guides on Ansible, Kubernetes, Cloud Automation, and Hybrid IT Infrastructure.
    </p>
  </div>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 mx-auto max-w-6xl mt-10 list-none p-0" role="list">
    {visibleBooks.map((book) => (
      <li data-reveal>
        <BookCard
          layout="shelf"
          headingLevel="h3"
          title={book.title}
          author={bookByline(book)}
          blurb={book.blurb}
          cover={book.cover}
          eyebrow={bookEyebrow(book)}
          pills={bookPills(book)}
          tint={book.topic}
          actions={bookActions(book)}
          team={bookTeamLink(book) ? { href: bookTeamLink(book)! } : null}
        />
      </li>
    ))}
  </ul>

  <!-- View All Books Button -->
  {!showAll && (
    <div class="mt-10 text-center">
      <a href="/books/" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3 text-base font-bold text-slate-900 shadow-sm transition hover:border-slate-400 hover:shadow">
        See all {BOOKS.length} books and ebooks <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</section>
