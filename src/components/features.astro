---
const services = [
  {
    title: "AI Platform Readiness Assessment",
    duration: "2–3 weeks",
    items: [
      "Current infrastructure & integration review",
      "Operational AI/ML readiness audit",
      "Gap analysis with prioritized roadmap",
    ],
    link: "/services/ai-integration/",
  },
  {
    title: "Regulated AI Platform Blueprint",
    duration: "4 weeks",
    items: [
      "Reference architecture for governance-first AI",
      "MLOps pipeline design with policy controls",
      "SOC2/ISO 27001 alignment mapping",
    ],
    link: "/services/automation-strategy/",
  },
  {
    title: "AI Platform Delivery Kit",
    duration: "6–12 weeks",
    items: [
      "Platform architecture, deployment & hardening",
      "GPU orchestration & multi-tenant isolation",
      "Runbooks, IaC, and Day-2 operations handoff",
    ],
    link: "/services/cloud-infrastructure/",
  },
  {
    title: "Compliance & Cost Advisory",
    duration: "Ongoing",
    items: [
      "Monthly cost reviews & optimization measures",
      "Continuous governance & compliance monitoring",
      "Audit preparation & evidence pack delivery",
    ],
    link: "/contact/",
  },
];
---

<section class="py-16 px-6">
  <div class="max-w-6xl mx-auto text-center mb-12">
    <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">
      AI Infrastructure Services for Regulated Enterprises
    </h2>
    <p class="text-lg text-gray-600 mt-4 max-w-3xl mx-auto">
      Start with gap analysis and roadmap, end with an AI platform teams can use — fast.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
    {services.map((service) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col group">
        <div class="flex-1">
          <h3 class="text-lg font-bold text-gray-900 leading-tight group-hover:text-red-600 transition-colors duration-200">{service.title}</h3>
          <p class="text-sm text-gray-600 mt-1 font-medium">{service.duration}</p>
          <ul class="mt-4 space-y-2.5 feature-check-list">
            {service.items.map((item) => (
              <li class="text-sm text-gray-600">{item}</li>
            ))}
          </ul>
        </div>
        <a
          href={service.link}
          aria-label={`Learn more about ${service.title}`}
          class="mt-6 inline-flex items-center justify-center px-5 py-2.5 border-2 border-gray-800 text-gray-800 font-semibold rounded-lg hover:bg-gray-800 hover:text-white active:scale-[0.97] transition-all duration-200 text-sm">
          Learn more about {service.title}
          <span class="sr-only"> ({service.duration})</span>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-check-list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .feature-check-list li {
    position: relative;
    padding-left: 1.5rem;
    margin: 0;
  }
  .feature-check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid #16a34a;
    border-bottom: 2px solid #16a34a;
    transform: rotate(-45deg);
  }
</style>
