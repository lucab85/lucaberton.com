---
/**
 * Where the expertise comes from: the stage, the Udienza interviews and the
 * client work. Each panel repeats the hero's three planes: a word set as wide
 * as the panel, a picture standing on its lower half, and a proof number on
 * top of the picture.
 */
import { Picture } from "astro:assets";
import stagePhoto from "assets/photos/RedHatSummit2026.jpg";

const udienzaHref =
  "https://www.udienza.com/?utm_source=lucaberton.com&utm_medium=banner&utm_campaign=udienza_banner&utm_content=latest_wide_home_planes";

const cities = ["Amsterdam", "Atlanta", "Stockholm", "London", "Yokohama", "Prague", "San Jose", "Skopje"];

const factoryLayers = [
  { n: "05", name: "Governance and evidence", note: "Policies, logs, runbooks an auditor can verify" },
  { n: "04", name: "Agents and applications", note: "Guardrails, evaluation, human approval" },
  { n: "03", name: "Model serving and MLOps", note: "Deployment, observability, cost per request" },
  { n: "02", name: "Platform", note: "Kubernetes, OpenShift AI, multi-tenant scheduling" },
  { n: "01", name: "GPUs and compute", note: "Sizing, procurement, utilisation" },
];
---

<section class="pp bg-white px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">Where the expertise comes from</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
        On stage. In conversation. In production.
      </h2>
      <p class="mt-5 text-xl leading-relaxed text-slate-600">
        Luca sees production AI from three sides: the conferences where it is debated, the people
        who build it, and the client platforms where it has to run.
      </p>
    </div>

    <!-- 01 On stage -->
    <article class="pp-panel mt-16 lg:mt-24">
      <div class="pp-stage">
        <p class="pp-word pp-word-9" aria-hidden="true">Worldwide</p>
        <Picture
          src={stagePhoto}
          alt="A full conference hall at Red Hat Summit 2026 in Atlanta, where Luca Berton spoke"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 92vw, 640px"
          formats={["avif", "webp"]}
          class="pp-media aspect-[16/10] object-cover"
        />
        <dl class="pp-badge">
          <dt>30<sup>+</sup></dt>
          <dd>Conferences<br />in 10 countries</dd>
        </dl>
      </div>
      <div class="pp-copy">
        <p class="pp-num">01 · On stage</p>
        <h3>On the world's technical stages, all year round.</h3>
        <p>
          KubeCon + CloudNativeCon, Red Hat Summit, Nordic APIs Platform Summit, Techorama, SREday:
          Luca speaks where production AI is being worked out, and comes home with what the
          best teams are doing this quarter, not last year.
        </p>
        <ul class="pp-chips">
          {cities.map((c) => <li>{c}</li>)}
        </ul>
        <div class="pp-links">
          <a href="/speaking/">Book Luca to speak →</a>
          <a href="/conferences/">Conference history →</a>
        </div>
      </div>
    </article>

    <!-- 02 In conversation -->
    <article class="pp-panel pp-panel-flip mt-20 lg:mt-28">
      <div class="pp-stage">
        <p class="pp-word pp-word-7" aria-hidden="true">Udienza</p>
        <a href={udienzaHref} rel="noopener" class="pp-media block overflow-hidden" aria-label="Udienza: watch the latest episode">
          <picture>
            <source media="(max-width: 640px)" srcset="https://www.udienza.com/banners/latest-square.png" width="600" height="600" />
            <img
              src="https://www.udienza.com/banners/latest-wide.png"
              width="1200"
              height="300"
              alt="Udienza: ten minutes with the people who build what you run. Watch the latest episode free."
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
            />
          </picture>
        </a>
        <dl class="pp-badge">
          <dt>110<sup>+</sup></dt>
          <dd>Interviews<br />recorded</dd>
        </dl>
      </div>
      <div class="pp-copy">
        <p class="pp-num">02 · In conversation</p>
        <h3>Ten minutes with the people who build what you run.</h3>
        <p>
          On <a href={udienzaHref} rel="noopener" class="font-bold text-slate-950 underline decoration-red-600 decoration-2 underline-offset-4">Udienza</a>,
          Luca sits down with the founders, maintainers and engineers behind the platforms
          enterprises depend on. Recorded at conferences from Prague to San Jose, the interviews
          give him, and his clients, a direct line to the people shaping the stack.
        </p>
        <div class="pp-links">
          <a href={udienzaHref} rel="noopener">Watch Udienza →</a>
        </div>
      </div>
    </article>

    <!-- 03 In production -->
    <article class="pp-panel mt-20 lg:mt-28">
      <div class="pp-stage">
        <p class="pp-word pp-word-10" aria-hidden="true">AI Factory</p>
        <div class="pp-media pp-blueprint">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-300">The AI factory, layer by layer</p>
          <ol class="mt-4" reversed>
            {factoryLayers.map((l) => (
              <li>
                <span class="pp-layer-n">{l.n}</span>
                <span>
                  <strong>{l.name}</strong>
                  <em>{l.note}</em>
                </span>
              </li>
            ))}
          </ol>
        </div>
        <dl class="pp-badge">
          <dt>2–3×</dt>
          <dd>Faster to<br />production</dd>
        </dl>
      </div>
      <div class="pp-copy">
        <p class="pp-num">03 · In production</p>
        <h3>AI factories, delivered for clients at enterprise scale.</h3>
        <p>
          An AI factory is the platform that lets a company ship AI again and again, not one demo
          at a time. Luca designs and delivers it end to end, from the GPUs to the evidence your
          risk team asks for.
        </p>
        <ul class="pp-facts">
          <li><strong>30%</strong> average cloud cost reduction</li>
          <li><strong>2–3×</strong> faster deployment to production</li>
          <li><strong>Audit-ready</strong> controls, policies, logs and runbooks</li>
        </ul>
        <div class="pp-links">
          <a href="/services/" data-track-event="consulting_cta_click" data-tp-target-offer="services" data-tp-cta-position="inline" data-tp-cta-variant="home_planes_factory">Build yours with Luca →</a>
        </div>
      </div>
    </article>
  </div>
</section>

<style is:global>
  .pp-panel {
    display: grid;
    gap: 2rem;
  }
  .pp-stage {
    container-type: inline-size;
    position: relative;
    display: grid;
  }

  /* Plane 1: the word, as wide as the stage. */
  .pp-word {
    margin: 0 0 -0.2em -0.03em;
    color: #dc2626;
    font-family: "Bricolage Grotesque Condensed", "Bricolage Grotesque Variable", "Arial Narrow", sans-serif;
    font-stretch: 75%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.74;
    letter-spacing: -0.02em;
    white-space: nowrap;
    user-select: none;
  }
  .pp-word-7 {
    font-size: 32cqw;
  }
  .pp-word-9 {
    font-size: 21.6cqw;
  }
  .pp-word-10 {
    font-size: 23.4cqw;
  }

  /* Plane 2: the picture, standing on the lower half of the word. */
  .pp-stage > picture {
    display: contents;
  }
  .pp-media {
    position: relative;
    width: 90%;
    justify-self: end;
    box-shadow: 0 30px 60px -25px rgb(15 23 42 / 0.45);
  }
  .pp-panel-flip .pp-media {
    justify-self: start;
  }

  /* Plane 3: the proof number, on the corner of the picture. */
  .pp-badge {
    position: absolute;
    left: 0;
    bottom: -1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.8rem 1.1rem;
    background: #0b1120;
    color: #fff;
  }
  .pp-panel-flip .pp-badge {
    left: auto;
    right: 0;
  }
  .pp-badge dt {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
  }
  .pp-badge dt sup {
    top: -0.9em;
    font-size: 0.45em;
  }
  .pp-badge dd {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pp-blueprint {
    padding: 1.5rem 1.5rem 3rem;
    background: #0b1120;
    color: #fff;
  }
  .pp-blueprint ol {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .pp-blueprint li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.05);
  }
  .pp-blueprint li:first-child {
    border-color: rgb(248 113 113 / 0.5);
  }
  .pp-layer-n {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #fca5a5;
  }
  .pp-blueprint strong {
    display: block;
    font-weight: 800;
  }
  .pp-blueprint em {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    color: #cbd5e1;
  }

  .pp-copy {
    padding-top: 1.5rem;
  }
  .pp-num {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #dc2626;
  }
  .pp-copy h3 {
    margin-top: 0.9rem;
    font-size: 1.9rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #020617;
  }
  .pp-copy > p:not(.pp-num) {
    margin-top: 1.1rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: #475569;
  }
  .pp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
    padding: 0;
    list-style: none;
  }
  .pp-chips li {
    padding: 0.3rem 0.75rem;
    border: 1px solid #cbd5e1;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #334155;
  }
  .pp-facts {
    margin-top: 1.4rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid #e2e8f0;
  }
  .pp-facts li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
  }
  .pp-facts strong {
    font-weight: 900;
    color: #020617;
  }
  .pp-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.6rem;
  }
  .pp-links a {
    font-weight: 800;
    color: #b91c1c;
  }
  .pp-links a:hover {
    color: #7f1d1d;
  }

  @media (min-width: 1024px) {
    .pp-panel {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 4.5rem;
    }
    .pp-panel-flip .pp-stage {
      order: 2;
    }
    .pp-copy {
      padding-top: 0;
    }
    .pp-copy h3 {
      font-size: 2.4rem;
    }
  }
</style>
