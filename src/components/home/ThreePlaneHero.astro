---
/**
 * Homepage hero built on three planes, back to front:
 *   1. the name, set as large as the stage allows;
 *   2. Luca's cut-out portrait, standing in front of the letters and fading
 *      into the page at the bottom;
 *   3. the interface: bracketed proof numbers, the tagline and the call to
 *      action, which sit on top of both.
 * The stage is a size container, so every measure below is in cqw and the
 * composition keeps its proportions from a phone to a wide desktop.
 */
import { Picture } from "astro:assets";
import lucaCutout from "assets/luca-cutout.webp";
---

<section class="tp-hero relative isolate overflow-hidden text-slate-950">
  <div class="tp-guides" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between gap-4 pt-5 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-slate-700 sm:text-xs lg:pt-7">
      <p class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-red-600"></span>
        The Production AI Expert
      </p>
      <p class="hidden sm:block">Amsterdam → worldwide</p>
    </div>

    <div class="tp-stage">
      <!-- Plane 1: the name -->
      <h1 class="tp-name">
        <span class="tp-name-first">Luca</span>
        <span class="tp-name-last">Berton</span>
      </h1>

      <!-- Plane 2: the portrait -->
      <Picture
        src={lucaCutout}
        alt="Luca Berton, Production AI expert, speaker and advisor"
        widths={[360, 560, 800]}
        sizes="(max-width: 767px) 88vw, (max-width: 1023px) 58vw, 420px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="tp-portrait"
      />

      <!-- Plane 3: proof numbers on top of the portrait -->
      <dl class="tp-stat tp-stat-a">
        <dt><span class="tp-bracket">30<sup>+</sup></span></dt>
        <dd>Conferences<br />worldwide</dd>
      </dl>
      <dl class="tp-stat tp-stat-b">
        <dt><span class="tp-bracket">110<sup>+</sup></span></dt>
        <dd>Udienza<br />interviews</dd>
      </dl>
      <dl class="tp-stat tp-stat-c">
        <dt><span class="tp-bracket">8</span></dt>
        <dd>Technical<br />books</dd>
      </dl>
    </div>

    <!-- Plane 3, continued: tagline and call to action -->
    <div class="tp-front relative grid gap-6 pb-10 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-14">
      <div class="lg:col-span-6">
        <p class="text-sm font-black uppercase leading-snug tracking-[0.16em] sm:text-base">
          The AI demo is easy.<br />Production is hard.
        </p>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-700 lg:text-lg">
          Luca builds AI factories for enterprises, trains the engineers who run them, and brings
          back what works from conference stages around the world.
        </p>
      </div>

      <div class="lg:col-span-6">
        <a
          href="/services/"
          data-track-event="consulting_cta_click"
          data-tp-target-offer="services"
          data-tp-cta-position="hero"
          data-tp-cta-variant="home_hero_primary"
          class="tp-cta group"
        >
          <span class="text-lg font-bold">Work with Luca</span>
          <span class="ml-auto hidden text-sm text-slate-400 min-[380px]:block">Free intro call</span>
          <span class="tp-cta-arrow" aria-hidden="true">
            <svg class="h-5 w-5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M9 7h8v8"></path></svg>
          </span>
        </a>
        <p class="mt-3 text-sm font-semibold text-slate-700">
          Planning an event?{" "}
          <a href="/speaking/" class="font-bold text-slate-950 underline decoration-red-600 decoration-2 underline-offset-4 hover:text-red-700">Book Luca to speak</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .tp-hero {
    --tp-paper: #f4f0e8;
    --tp-red: #dc2626;
    background: var(--tp-paper);
  }

  /* Hairline columns behind everything, as on a layout grid. */
  .tp-guides {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(to right, rgb(15 23 42 / 0.07) 1px, transparent 1px);
    background-size: 25% 100%;
    background-position: 12.5% 0;
  }

  .tp-stage {
    container-type: inline-size;
    position: relative;
    margin-top: 0.75rem;
    display: grid;
    justify-items: center;
  }
  .tp-stage > *,
  .tp-stage > picture > img {
    grid-area: 1 / 1;
  }
  .tp-stage > picture {
    display: contents;
  }

  /* Plane 1. Each line is sized to span the stage, so the two words stack
     flush left and right like a poster. */
  .tp-name {
    justify-self: stretch;
    align-self: start;
    margin: 0;
    color: var(--tp-red);
    font-family: "Bricolage Grotesque Condensed", "Bricolage Grotesque Variable", "Arial Narrow", sans-serif;
    font-stretch: 75%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.74;
    letter-spacing: -0.02em;
    white-space: nowrap;
    user-select: none;
  }
  .tp-name span {
    display: block;
  }
  .tp-name-first {
    font-size: 52.5cqw;
    margin-left: -0.03em;
  }
  .tp-name-last {
    font-size: 33.8cqw;
    margin-top: 0.07em;
    margin-left: -0.03em;
  }

  /* Plane 2. The mask lets the shirt dissolve into the page. */
  .tp-portrait {
    position: relative;
    width: 88cqw;
    height: auto;
    margin-top: 16cqw;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 96%);
  }

  /* Plane 3. */
  .tp-stat {
    position: relative;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: #fff;
    text-shadow: 0 1px 10px rgb(15 23 42 / 0.9), 0 0 2px rgb(15 23 42 / 0.6);
  }
  .tp-stat dd {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .tp-bracket {
    position: relative;
    display: block;
    padding: 0.2rem 0.6rem;
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1;
  }
  .tp-bracket sup {
    top: -0.9em;
    font-size: 0.45em;
  }
  .tp-bracket::before,
  .tp-bracket::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0.45rem;
    border: 2px solid currentColor;
  }
  .tp-bracket::before {
    left: 0;
    border-right: 0;
  }
  .tp-bracket::after {
    right: 0;
    border-left: 0;
  }
  .tp-stat-a {
    justify-self: start;
    margin-left: 24cqw;
    margin-bottom: 38cqw;
  }
  .tp-stat-b,
  .tp-stat-c {
    display: none;
  }

  .tp-front {
    margin-top: -17cqw;
  }
  @supports not (margin-top: 1cqw) {
    .tp-front {
      margin-top: -3rem;
    }
  }

  .tp-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding-left: 1.25rem;
    background: #0b1120;
    color: #fff;
  }
  .tp-cta:hover {
    background: #1e293b;
  }
  .tp-cta-arrow {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 3.75rem;
    background: var(--tp-red);
  }

  @media (min-width: 768px) {
    .tp-portrait {
      width: 58cqw;
      margin-top: 12cqw;
    }
    /* Under the name, either side of the portrait. */
    .tp-stat-a,
    .tp-stat-b {
      display: flex;
      margin-bottom: 15cqw;
      color: #0b1120;
      text-shadow: none;
    }
    .tp-stat-a {
      margin-left: 1cqw;
    }
    .tp-stat-b {
      justify-self: end;
      margin-right: 2cqw;
    }
    .tp-front {
      margin-top: -9cqw;
    }
  }

  @media (min-width: 1024px) {
    /* The stage is sized from the viewport height, so the whole poster, call
       to action included, stays inside the first screen. The proof numbers
       move to the margins left free on either side. */
    .tp-stage {
      max-width: 50rem;
      max-width: min(50rem, 78svh);
      margin-inline: auto;
    }
    .tp-portrait {
      width: 52cqw;
      margin-top: 12cqw;
    }
    .tp-bracket {
      font-size: 3rem;
    }
    .tp-stat dd {
      font-size: 0.72rem;
    }
    .tp-stat {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.7rem;
      margin: 0;
      color: #0b1120;
      text-shadow: none;
    }
    .tp-stat-a {
      right: calc(100% + 1.5rem);
      top: 43cqw;
      align-items: flex-end;
      text-align: right;
    }
    .tp-stat-b {
      left: calc(100% + 1.5rem);
      top: 6cqw;
    }
    .tp-stat-c {
      left: calc(100% + 1.5rem);
      top: 43cqw;
    }
    .tp-front {
      margin-top: -4rem;
    }
  }
</style>
