---
/**
 * What Luca can do for a client: the three main engagements, then the
 * smaller services around them. Consulting is delivered through Open Empower,
 * so the assessment links there; everything else stays on this site.
 */
const engagements = [
  {
    n: "01",
    eyebrow: "For your engineers",
    title: "Upskill your engineering team.",
    copy: "Hands-on programmes that turn experienced DevOps, cloud and platform engineers into the people who can run AI in production. Real clusters, real agents, real failure modes.",
    points: ["AI Platform Engineer Bootcamp", "Claude Code for Teams", "Private workshops on your stack"],
    href: "/ai-platform-engineer-bootcamp/",
    cta: "Explore the bootcamp",
    offer: "ai_platform_engineer_bootcamp",
    variant: "home_does_upskill",
  },
  {
    n: "02",
    eyebrow: "For your platform",
    title: "Build your AI factory from scratch.",
    copy: "From an empty cloud account or empty racks to a governed platform your teams ship on: GPU compute, Kubernetes and OpenShift AI, model serving, agents, observability and cost control.",
    points: ["Architecture and GPU sizing", "Platform build and hand-over", "Governance an auditor can verify"],
    href: "/services/",
    cta: "Work with Luca",
    offer: "services",
    variant: "home_does_factory",
  },
  {
    n: "03",
    eyebrow: "For your stakeholders",
    title: "Deliver value from the first weeks.",
    copy: "Luca starts where the board, security and platform teams can all see progress: a fixed-fee assessment that shows the gaps between your prototype and production, what to fix first and what it costs.",
    points: ["Fixed fee, 2–6 weeks", "A prioritised roadmap", "Evidence leaders can act on"],
    href: "https://www.openempower.com/services/assessment",
    cta: "See the assessment",
    offer: "production_ai_assessment",
    variant: "home_does_stakeholders",
  },
];

// For conference organisers and their sponsors: Luca as media partner.
const media = [
  { title: "Fill the room", copy: "LinkedIn posts and short videos for a technical audience, with a tracked link or discount code so registrations can be counted." },
  { title: "Speaker previews", copy: "Five-minute conversations with speakers before the event, each ending with an invitation to their session." },
  { title: "Sponsor interviews on site", copy: "Short videos at the booth showing a real integration or demo, clearly marked as sponsored and ready to reuse." },
  { title: "Coverage that lasts", copy: "Daily updates from the floor, clips for the weeks after and a recap on Udienza or this site." },
];

const more = [
  { title: "Keynotes and conference talks", copy: "The AI demo is easy. Production is hard, told for leaders and builders.", href: "/speaking/" },
  { title: "GPU cluster design review", copy: "A second opinion before you buy or scale accelerators.", href: "/services/gpu-cluster-review/" },
  { title: "AI integration and GPU platforms", copy: "Model deployment on Kubernetes, RHEL AI and OpenShift AI.", href: "/services/ai-integration/" },
  { title: "Kubernetes and platform engineering", copy: "Workshops and consulting for production-grade clusters.", href: "/services/kubernetes-workshops/" },
  { title: "Automation strategy", copy: "Ansible, infrastructure as code and compliance automation.", href: "/services/automation-strategy/" },
  { title: "Performance and cost optimization", copy: "Find the bottleneck, measure the gain, cut the bill.", href: "/services/performance-optimization/" },
  { title: "Claude Code for Teams", copy: "A working session that gets a whole team productive with AI coding, safely.", href: "/claude-code-for-teams/" },
  { title: "Sponsored content", copy: "Reach the engineers who read, watch and listen to Luca.", href: "/partner-with-luca/" },
];
---

<section class="bg-slate-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28" aria-labelledby="what-luca-does">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-400">What Luca can do for you</p>
      <h2 id="what-luca-does" class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">
        Your team, your platform, your stakeholders.
      </h2>
      <p class="mt-5 text-xl leading-relaxed text-slate-300">
        Three ways Luca creates value when he joins your organization, each one useful on its own.
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden border border-white/10 bg-white/10 lg:grid-cols-3">
      {engagements.map((e) => (
        <article class="flex flex-col bg-slate-950 p-7 lg:p-9">
          <div class="flex items-baseline justify-between">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-300">{e.eyebrow}</p>
            <p class="text-5xl font-light leading-none text-white/25" aria-hidden="true">{e.n}</p>
          </div>
          <h3 class="mt-8 text-3xl font-black leading-[1.05] tracking-tight">{e.title}</h3>
          <p class="mt-5 leading-relaxed text-slate-300">{e.copy}</p>
          <ul class="mt-6 flex-1 space-y-2 text-sm font-semibold text-slate-200">
            {e.points.map((p) => (
              <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 bg-red-500"></span>{p}</li>
            ))}
          </ul>
          <a
            href={e.href}
            data-track-event="consulting_cta_click"
            data-tp-target-offer={e.offer}
            data-tp-cta-position="inline"
            data-tp-cta-variant={e.variant}
            class="mt-8 inline-flex min-h-12 items-center justify-between gap-4 bg-white pl-5 font-bold text-slate-950 transition hover:bg-red-50"
          >
            {e.cta}
            <span class="grid h-12 w-12 place-items-center bg-red-600 text-white" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="mt-px grid gap-10 border border-white/10 bg-white/[0.04] p-7 lg:grid-cols-12 lg:p-9">
      <div class="lg:col-span-4">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-300">For events and sponsors</p>
        <h3 class="mt-5 text-3xl font-black leading-[1.05] tracking-tight">A media partner for your conference.</h3>
        <p class="mt-5 leading-relaxed text-slate-300">
          Luca brings 11,000+ LinkedIn followers, a YouTube channel and the Udienza interviews to
          your event: more registrations before it, more visibility for sponsors during and after.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-7 gap-y-2 font-bold">
          <a href="/partner-with-luca/" class="text-white underline decoration-red-500 decoration-2 underline-offset-4 hover:text-red-300">Partner with Luca →</a>
          <a href="/media-kit/" class="text-white underline decoration-red-500 decoration-2 underline-offset-4 hover:text-red-300">Media kit →</a>
        </div>
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {media.map((m, i) => (
          <li class="border-t border-white/15 py-5">
            <p class="flex items-baseline gap-3 font-bold text-white">
              <span class="text-xs tracking-[0.18em] text-red-400" aria-hidden="true">0{i + 1}</span>
              {m.title}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{m.copy}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-16">
      <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400">More ways to work together</h3>
      <ul class="mt-6 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {more.map((m) => (
          <li class="border-t border-white/15">
            <a href={m.href} class="group block py-5">
              <span class="flex items-start justify-between gap-3 font-bold text-white group-hover:text-red-300">
                {m.title}
                <span aria-hidden="true" class="text-red-400">→</span>
              </span>
              <span class="mt-1.5 block text-sm leading-relaxed text-slate-400">{m.copy}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
