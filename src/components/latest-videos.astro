---
import SocialCrossPost from '@components/SocialCrossPost.astro';

// Latest cross-posted video clips (published via Postiz). Each entry carries the
// primary YouTube link plus the secondary-platform links from the publish notification.
const videos = [
  {
    id: 'jXRzVqeh-gM',
    title: 'Heading to KubeCon Japan 2026 in Yokohama - Bring Me Your AI & Kubernetes Stories',
    youtube: 'https://www.youtube.com/watch?v=jXRzVqeh-gM',
    tiktok: 'https://www.tiktok.com/@thelucaberton',
    linkedin: 'https://www.linkedin.com/feed/update/urn:li:ugcPost:7486752790531252225',
    instagram: 'https://www.instagram.com/reel/DbNxEcOlPHc/',
  },
  {
    id: 'Z2Rp5OxLooA',
    title: 'A Quick Snapshot from Red Hat Summit 2026 Show Floor (Atlanta)',
    youtube: 'https://www.youtube.com/watch?v=Z2Rp5OxLooA',
    tiktok: 'https://www.tiktok.com/@thelucaberton',
    linkedin: 'https://www.linkedin.com/feed/update/urn:li:ugcPost:7486775075317252096',
    instagram: 'https://www.instagram.com/reel/DbN7WMbDMlk/',
  },
];
---

<section class="bg-gray-50 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="text-center mb-12">
      <h2 class="font-extrabold text-4xl text-gray-900">Latest Videos</h2>
      <p class="text-lg mt-4 text-gray-700">
        Fresh from YouTube, TikTok, LinkedIn & Instagram.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {videos.map((video) => (
        <article class="flex flex-col border border-gray-200 bg-white hover:border-blue-600 hover:shadow-xl rounded-xl shadow-lg transition-all overflow-hidden h-full">
          <a href={video.youtube} target="_blank" rel="noopener" class="group block">
            <img
              src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
              alt={video.title}
              width="480"
              height="270"
              loading="lazy"
              decoding="async"
              class="w-full h-56 object-cover group-hover:opacity-90 transition-opacity"
            />
          </a>
          <div class="flex-1 p-6">
            <h3 class="font-bold text-gray-900 text-lg leading-snug">
              <a href={video.youtube} target="_blank" rel="noopener" class="group-hover:text-blue-700 transition-colors">
                {video.title}
              </a>
            </h3>
            <div class="mt-4">
              <SocialCrossPost
                tiktok={video.tiktok}
                instagram={video.instagram}
                linkedin={video.linkedin}
              />
            </div>
          </div>
          <div class="px-6 pb-4">
            <a
              href={video.youtube}
              target="_blank"
              rel="noopener"
              class="text-blue-600 font-semibold text-sm hover:underline"
            >
              Watch on YouTube &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        class="text-lg font-semibold hover:underline inline-block px-6 py-3 text-blue-600 transition"
        href="https://www.youtube.com/@BertonLuca"
        target="_blank"
        rel="noopener"
      >
        View All on YouTube →
      </a>
    </div>
  </div>
</section>
