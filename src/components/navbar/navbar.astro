---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import KitButton from "@components/KitButton.astro";

const menuitems = [
  {
    title: "Speaking",
    path: "/conferences/",
  },
  {
    title: "Advisory",
    path: "/services/",
  },
  {
    title: "Academy",
    path: "/ai-platform-engineer-bootcamp/",
  },
  {
    title: "Insights",
    path: "/blog/",
  },
  {
    title: "About",
    path: "/about/",
  },
];
---

<Container>
  <header class="my-5 flex flex-col items-center justify-between lg:flex-row" role="banner">
    <Astronav>
      <nav aria-label="Main navigation" class="flex w-full items-center justify-between lg:w-auto">
        <a href="/" class="group">
          <span class="block text-lg font-black tracking-tight text-slate-950">Luca Berton</span>
          <span class="block text-[11px] font-semibold uppercase tracking-[0.16em] text-red-600">Production AI</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="h-4 w-4 text-gray-800" />
        </div>
      </nav>

      <div class="flex w-full items-center justify-between lg:w-auto lg:justify-start">
        <MenuItems class="mt-2 hidden w-full lg:mt-0 lg:flex lg:w-auto">
          <ul class="flex flex-col lg:flex-row lg:gap-2">
            {menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class={`relative flex items-center py-2 text-gray-600 transition-colors duration-150 hover:text-gray-950 lg:px-4 ${
                    Astro.url.pathname.startsWith(item.path) ? "font-semibold text-gray-950" : ""
                  }`}
                  aria-current={Astro.url.pathname.startsWith(item.path) ? "page" : undefined}
                >
                  <span>{item.title}</span>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-3 flex items-center gap-4 lg:hidden">
            <KitButton formId="ce74a48bfa" buttonText="Newsletter" buttonStyle="secondary" />
            <Link href="/contact/" size="md">Work with Luca</Link>
          </div>
        </MenuItems>
      </div>
    </Astronav>

    <div class="hidden items-center gap-4 lg:flex">
      <KitButton formId="ce74a48bfa" buttonText="Newsletter" buttonStyle="secondary" />
      <Link href="/contact/" size="md">Work with Luca</Link>
    </div>
  </header>
</Container>
