---
// src/components/posthog.astro
// PostHog product analytics — routed through a self-hosted reverse proxy
// (r.lucaberton.com) so all event traffic is first-party and never leaks to a
// *.posthog.com origin. This keeps ad blockers / tracking protection from
// silently dropping events and avoids a Content-Security-Policy exception for
// the third-party domain.
//
// SECURITY: the project API key is injected at build time via the
// PUBLIC_POSTHOG_KEY environment variable, which CI sets from a GitHub secret.
// It is deliberately NOT hard-coded here, so the key never lives in repo source
// or git history.
//
// NOTE: Astro inlines PUBLIC_* vars into the client bundle, so the key is
// publicly visible to site visitors in the browser. That is inherent to any
// public web-analytics snippet — PostHog needs it client-side. Keeping it in a
// GitHub secret (rather than committed) only protects it from the repo/history,
// not from end users. Because ingestion goes through the reverse proxy, the key
// is still rotated (key rotation lives in the provider + this secret).
//
// ui_host points back to the PostHog app so links in the toolbar / surveys /
// recordings resolve to the correct project UI.
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST || "https://r.lucaberton.com";
const POSTHOG_UI_HOST = import.meta.env.PUBLIC_POSTHOG_UI_HOST || "https://eu.posthog.com";

// Only render the snippet when a key is actually provided. Local dev and
// forked-PR builds (which have no access to the secret) simply skip analytics
// instead of calling posthog.init(undefined).
const enabled = Boolean(POSTHOG_KEY);
---

{enabled && (
  <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST, POSTHOG_UI_HOST }}>
    !function (t, e) {
      var o, n, p, r;
      e.__SV || (
        window.posthog = e,
        e._i = [],
        e.init = function (i, s, a) {
          function g(t, e) {
            var o = e.split(".");
            2 == o.length && (t = t[o[0]], e = o[1]),
              t[e] = function () { t.push([e].concat(Array.prototype.slice.call(arguments, 0))) }
          }
          // NOTE: always load array.js from the proxy. The default loader
          // rewrites ".i.posthog.com" → "-assets.i.posthog.com", which would
          // send the script request to the third-party origin. With a proxy we
          // keep it on our own domain so the asset stays first-party.
          (p = t.createElement("script")).type = "text/javascript",
            p.crossOrigin = "anonymous",
            p.async = !0,
            p.src = s.api_host + "/static/array.js",
            (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(p, r);
          var u = e;
          for (
            void 0 !== a ? u = e[a] = [] : a = "posthog",
              u.people = u.people || [],
              u.toString = function (t) { var e = "posthog"; return "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e },
              u.people.toString = function () { return u.toString(1) + ".people (stub)" },
              o = "init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),
              n = 0;
            n < o.length;
            n++
          ) g(u, o[n]);
          e._i.push([i, s, a])
        },
        e.__SV = 1
      )
    }(document, window.posthog || []);
    posthog.init(POSTHOG_KEY, {
      api_host: POSTHOG_HOST,        // your managed reverse proxy domain
      ui_host: POSTHOG_UI_HOST,      // points PostHog UI links back to the app
      defaults: "2026-05-30",
      // Capture client-side routes & SPA navigations as pageviews.
      capture_pageview: true,
      autocapture: true,
      // Only build person profiles for identified visitors (e.g. after
      // posthog.identify). Anonymous traffic stays anonymous — privacy-friendly
      // and keeps profile count / ingestion cost down.
      person_profiles: "identified_only",
      // --- Session recording ---
      // Defaults to ON when the key is present; the flag is explicit here so the
      // behaviour is auditable in source (and can be flipped without a new key).
      disable_session_recording: false,
      session_recording: {
        // Sample 100% of sessions. Lower (e.g. 0.2 for 20%) to cut ingestion cost.
        sample_rate: 1.0,
        // Mask input values so passwords / email fields are never stored in the
        // recording (PostHog already masks <input type=password> by default).
        maskAllInputs: true,
        // Don't record typing into inputs of these types (defence in depth).
        maskInputOptions: {
          password: true,
          email: true,
          tel: true,
          creditCard: true,
        },
        // Respect a visitor's Do-Not-Track browser setting.
        respectDoNotTrack: true,
        // Capture console + network errors to triage client-side bugs.
        recordCrossOriginIframes: false,
      },
    });
  </script>
)}
