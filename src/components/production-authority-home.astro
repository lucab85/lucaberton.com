---
import { Picture } from "astro:assets";
import lucaImage from "assets/luca-hero.jpg";
import KitButton from "@components/KitButton.astro";

const framework = [
  {
    number: "01",
    title: "Prototype",
    copy: "Prove the use case and the economics before the demo becomes architecture by accident.",
  },
  {
    number: "02",
    title: "Platform",
    copy: "Standardize model access, compute, data paths, security and developer workflows on a platform teams can operate.",
  },
  {
    number: "03",
    title: "Production",
    copy: "Engineer for reliability, observability, performance, failure recovery and cost — not just a successful inference call.",
  },
  {
    number: "04",
    title: "Proof",
    copy: "Make governance visible with controls, policies, logs, runbooks and evidence an audit or risk team can verify.",
  },
];
---

<!-- HERO -->
<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0">
    <img
      src="/hero-stage-1.webp"
      alt="Luca Berton speaking on stage"
      width="1920"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-center opacity-25"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-950/55"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/50"></div>
  </div>

  <div class="relative mx-auto grid min-h-[760px] max-w-7xl items-center gap-14 px-6 py-20 lg:grid-cols-12 lg:px-12 lg:py-24">
    <div class="lg:col-span-8">
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-red-400/25 bg-red-500/10 px-4 py-2 text-sm font-semibold tracking-wide text-red-200">
        <span class="h-2 w-2 rounded-full bg-red-400"></span>
        Production AI · Speaker · Advisor · Educator
      </div>

      <h1 class="max-w-5xl text-5xl font-black leading-[0.98] tracking-[-0.04em] text-white sm:text-6xl lg:text-7xl xl:text-8xl">
        The AI demo is easy.
        <span class="block text-red-400">Production is hard.</span>
      </h1>

      <p class="mt-8 max-w-3xl text-xl leading-relaxed text-slate-300 lg:text-2xl">
        I help enterprises and engineering leaders turn promising AI prototypes into secure,
        governed and scalable production systems — and I teach the teams who have to operate them.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a
          href="/conferences/"
          class="inline-flex items-center justify-center rounded-xl bg-red-600 px-7 py-4 text-lg font-bold text-white shadow-xl shadow-red-950/30 transition hover:bg-red-500"
        >
          Book Luca to Speak
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/10 px-7 py-4 text-lg font-semibold text-white backdrop-blur transition hover:bg-white/15"
        >
          Enterprise Advisory
        </a>
      </div>

      <div class="mt-12 grid max-w-4xl grid-cols-2 gap-x-8 gap-y-6 border-t border-white/10 pt-8 sm:grid-cols-3 lg:grid-cols-6">
        <div>
          <div class="text-2xl font-black text-white">15+</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Years</div>
        </div>
        <div>
          <div class="text-2xl font-black text-white">8</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Books</div>
        </div>
        <div>
          <div class="text-2xl font-black text-white">40K+</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Students</div>
        </div>
        <div>
          <div class="text-2xl font-black text-white">KubeCon</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Speaker</div>
        </div>
        <div>
          <div class="text-2xl font-black text-white">Red Hat</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Summit</div>
        </div>
        <div>
          <div class="text-2xl font-black text-white">Docker</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-slate-400">Captain</div>
        </div>
      </div>
    </div>

    <div class="hidden lg:col-span-4 lg:block">
      <div class="relative ml-auto max-w-sm">
        <div class="absolute -inset-6 rounded-[2rem] bg-red-500/10 blur-3xl"></div>
        <div class="relative rounded-3xl border border-white/10 bg-white/[0.07] p-5 shadow-2xl backdrop-blur-xl">
          <Picture
            src={lucaImage}
            alt="Luca Berton, Production AI speaker and advisor"
            widths={[360, 480, 640]}
            sizes="360px"
            width={480}
            height={640}
            formats={["avif", "webp"]}
            class="aspect-[3/4] w-full rounded-2xl object-cover object-top"
          />
          <div class="px-1 pb-1 pt-5">
            <p class="text-2xl font-black">Luca Berton</p>
            <p class="mt-1 font-medium text-red-300">Production AI Speaker & Advisor</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">
              Former Red Hat engineer · Author · Docker Captain · KubeCon & Red Hat Summit speaker
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- POSITIONING -->
<section class="bg-white px-6 py-24 lg:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">The Production AI thesis</p>
        <h2 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
          AI value starts where the demo ends.
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-2xl leading-relaxed text-slate-700">
          A model can answer a prompt in minutes. An enterprise still has to make that system reliable,
          secure, observable, affordable and governable for years.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          That gap is Production AI: the engineering and operating discipline that turns AI capability
          into a system customers, platform teams, security teams and auditors can trust.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FRAMEWORK -->
<section class="border-y border-slate-200 bg-slate-50 px-6 py-24 lg:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">The Production AI Framework</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
        From prototype to proof.
      </h2>
      <p class="mt-5 text-xl leading-relaxed text-slate-600">
        A practical operating model for leaders and engineering teams moving AI into the real world.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {framework.map((item) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <div class="text-sm font-black tracking-[0.18em] text-red-600">{item.number}</div>
          <h3 class="mt-6 text-2xl font-black text-slate-950">{item.title}</h3>
          <p class="mt-4 leading-relaxed text-slate-600">{item.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- WAYS TO WORK -->
<section class="bg-slate-950 px-6 py-24 text-white lg:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-400">Work with Luca</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">One idea. Three ways to create impact.</h2>
      <p class="mt-5 text-xl leading-relaxed text-slate-300">
        Production AI connects the boardroom, the platform team and the people building the systems.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.06] p-8">
        <div class="text-sm font-bold uppercase tracking-[0.18em] text-red-300">Keynotes</div>
        <h3 class="mt-5 text-3xl font-black">The AI Demo Is Easy. Production Is Hard.</h3>
        <p class="mt-5 flex-1 leading-relaxed text-slate-300">
          A practical, high-energy keynote for technology leaders on what breaks between AI ambition and production reality — and how to close the gap.
        </p>
        <a href="/conferences/" class="mt-8 font-bold text-red-300 hover:text-red-200">Explore speaking →</a>
      </article>

      <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.06] p-8">
        <div class="text-sm font-bold uppercase tracking-[0.18em] text-red-300">Enterprise Advisory</div>
        <h3 class="mt-5 text-3xl font-black">Move AI from roadmap to operating platform.</h3>
        <p class="mt-5 flex-1 leading-relaxed text-slate-300">
          Architecture, GPU platforms, MLOps, observability, security, cost control and governance for teams that need AI to survive production and audit.
        </p>
        <a href="/services/" class="mt-8 font-bold text-red-300 hover:text-red-200">Work with Luca →</a>
      </article>

      <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.06] p-8">
        <div class="text-sm font-bold uppercase tracking-[0.18em] text-red-300">Academy</div>
        <h3 class="mt-5 text-3xl font-black">Build the engineers who can operate AI.</h3>
        <p class="mt-5 flex-1 leading-relaxed text-slate-300">
          Hands-on education for experienced DevOps, cloud, SRE and platform engineers extending their skills into production AI infrastructure.
        </p>
        <a href="/ai-platform-engineer-bootcamp/" class="mt-8 font-bold text-red-300 hover:text-red-200">Explore the bootcamp →</a>
      </article>
    </div>
  </div>
</section>

<!-- CREDIBILITY / POV -->
<section class="bg-white px-6 py-24 lg:px-12 lg:py-32">
  <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-12 lg:items-center lg:gap-20">
    <div class="lg:col-span-7">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">Built in the real world</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
        Hands-on engineering credibility, translated for leaders.
      </h2>
      <p class="mt-6 text-xl leading-relaxed text-slate-600">
        Luca has spent 15+ years across enterprise infrastructure, automation, Kubernetes, cloud and AI platforms.
        He is a former Red Hat engineer, Docker Captain, author of eight technical books and an instructor to more than 40,000 students.
      </p>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        His work and talks focus on the operational layer most AI conversations skip: what it actually takes to run AI safely, repeatedly and economically in production.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold text-slate-700">
        <span class="rounded-full bg-slate-100 px-4 py-2">KubeCon + CloudNativeCon Europe 2026</span>
        <span class="rounded-full bg-slate-100 px-4 py-2">Red Hat Summit 2026</span>
        <span class="rounded-full bg-slate-100 px-4 py-2">Docker Captain</span>
        <span class="rounded-full bg-slate-100 px-4 py-2">Coursera & Pluralsight Instructor</span>
      </div>
    </div>

    <aside class="rounded-3xl bg-slate-950 p-8 text-white shadow-2xl lg:col-span-5 lg:p-10">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-400">For event organizers</p>
      <blockquote class="mt-5 text-3xl font-black leading-tight">
        “The board sees an AI demo. The platform team sees everything the demo forgot.”
      </blockquote>
      <p class="mt-6 leading-relaxed text-slate-300">
        Luca connects executive AI ambition with the engineering reality underneath it — without turning the keynote into a vendor pitch or a Kubernetes tutorial.
      </p>
      <a href="/conferences/" class="mt-8 inline-flex rounded-xl bg-red-600 px-6 py-3 font-bold text-white hover:bg-red-500">
        View speaking & events
      </a>
    </aside>
  </div>
</section>

<!-- NEWSLETTER -->
<section class="border-y border-slate-200 bg-slate-50 px-6 py-20 lg:px-12">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">Production AI newsletter</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">What actually changes when AI reaches production.</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Practical notes on AI platforms, agents, GPUs, MLOps, governance and the operating decisions behind reliable enterprise AI.
      </p>
    </div>
    <div class="shrink-0">
      <KitButton formId="ce74a48bfa" buttonText="Join the Newsletter" buttonStyle="primary" />
    </div>
  </div>
</section>
