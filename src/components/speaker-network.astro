---
const speakers = [
  { name: "Agentic AI Foundation", url: "https://aaif.io", logo: "https://cdn.sanity.io/images/4o10fa7h/production/cc9de238d88dab9eebd13cb1e1cfd858ba39509e-32x32.png?w=64&h=64" },
  { name: "Anthropic", url: "https://www.anthropic.com", logo: "https://cdn.simpleicons.org/anthropic" },
  { name: "HumanLayer", url: "https://www.humanlayer.dev", logo: "https://www.humanlayer.dev/favicon.ico" },
  { name: "Google DeepMind", url: "https://deepmind.google", logo: "https://cdn.simpleicons.org/deepmind" },
  { name: "Hugging Face", url: "https://huggingface.co", logo: "https://cdn.simpleicons.org/huggingface" },
  { name: "AWS", url: "https://aws.amazon.com", logo: "https://a0.awsstatic.com/libra-css/images/site/fav/favicon.ico" },
  { name: "Alpic", url: "https://alpic.ai", logo: "https://framerusercontent.com/images/PdZs84lSywfOu3AgsUUvO9W0I.png" },
  { name: "Google", url: "https://www.google.com", logo: "https://cdn.simpleicons.org/google" },
  { name: "Solo.io", url: "https://www.solo.io", logo: "https://cdn.prod.website-files.com/66dba20a96c0aa281999f399/6a902345de227e28aa9a28f4_Favicon.png" },
  { name: "GitHub", url: "https://github.com", logo: "https://cdn.simpleicons.org/github" },
  { name: "Arcade", url: "https://www.arcade.dev", logo: "https://www.arcade.dev/favicon.svg" },
  { name: "Snyk", url: "https://snyk.io", logo: "https://cdn.simpleicons.org/snyk" },
  { name: "Microsoft", url: "https://www.microsoft.com", logo: "https://learn.microsoft.com/favicon.ico" },
  { name: "Elastic", url: "https://www.elastic.co", logo: "https://cdn.simpleicons.org/elastic" },
  { name: "Adyen", url: "https://www.adyen.com", logo: "https://cdn.simpleicons.org/adyen" },
  { name: "Orange", url: "https://www.orange.com", logo: "https://cdn.simpleicons.org/orange" },
  { name: "SAP", url: "https://www.sap.com", logo: "https://cdn.simpleicons.org/sap" },
  { name: "Qodo", url: "https://www.qodo.ai", logo: "https://cdn.simpleicons.org/qodo" },
  { name: "WeMakeDevs", url: "https://www.wemakedevs.org", logo: "https://www.wemakedevs.org/favicon.ico" },
  { name: "Bond AI", url: "https://www.bond.ai", logo: "https://cdn.prod.website-files.com/6a61fed94344ac234844c8a6/6a61fed94344ac234844cdb6_favicon.png" },
  { name: "Postman", url: "https://www.postman.com", logo: "https://cdn.simpleicons.org/postman" },
];
---

<section class="py-12 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="text-xl font-semibold text-gray-500 mb-2">Speakers from these organizations</h2>
    <p class="text-sm text-gray-400 mb-8">
      Conversations at AGNTCon + MCPCon Europe 2026 —
      <a href="/blog/agntcon-people-met-2026/" class="underline hover:text-gray-600">who Luca met</a>
    </p>

    <div class="flex flex-wrap justify-center items-center gap-6 md:gap-8">
      {speakers.map((s) => (
        <a
          href={s.url}
          rel="noopener"
          target="_blank"
          class="flex w-16 h-12 items-center justify-center md:w-20 md:h-14"
          title={s.name}
        >
          <img
            src={s.logo}
            alt={s.name}
            width="40"
            height="40"
            loading="lazy"
            class="max-h-8 max-w-full object-contain opacity-60 grayscale transition-all duration-200 hover:opacity-100 hover:grayscale-0"
          />
        </a>
      ))}
    </div>
  </div>
</section>
