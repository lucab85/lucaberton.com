---
import { Picture } from "astro:assets";
import kubeConStage from "assets/photos/KubeConEU2026-Xebia.jpg";
import redHatStage from "assets/photos/RedHatSummit2026-Stage.jpg";
import redHatSummit from "assets/photos/RedHatSummit2026.jpg";

const appearances = [
  {
    image: kubeConStage,
    event: "KubeCon + CloudNativeCon Europe 2026",
    location: "Amsterdam",
    alt: "Luca Berton speaking at KubeCon Europe 2026 in Amsterdam",
  },
  {
    image: redHatStage,
    event: "Red Hat Summit 2026",
    location: "Atlanta",
    alt: "Luca Berton speaking on stage at Red Hat Summit 2026 in Atlanta",
  },
  {
    image: redHatSummit,
    event: "Red Hat Summit 2026",
    location: "Atlanta",
    alt: "Luca Berton presenting at Red Hat Summit 2026",
  },
];
---

<section class="bg-slate-950 px-6 py-24 text-white lg:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-400">Proof from the stage</p>
        <h2 class="mt-4 max-w-4xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">
          Production AI, in front of real technical audiences.
        </h2>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-slate-300">
          Luca brings the engineering reality behind enterprise AI to conferences, leadership events and technical communities — translating production systems into stories leaders and builders can act on.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a href="/speaking/" class="rounded-xl bg-red-600 px-6 py-3 font-bold text-white transition hover:bg-red-500">
          View keynotes
        </a>
        <a href="/conferences/" class="rounded-xl border border-white/15 bg-white/[0.06] px-6 py-3 font-semibold text-white transition hover:bg-white/10">
          Conference history
        </a>
      </div>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <figure class="group overflow-hidden rounded-3xl border border-white/10 bg-white/[0.05] lg:col-span-7">
        <Picture
          src={appearances[0].image}
          alt={appearances[0].alt}
          widths={[720, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 58vw"
          formats={["avif", "webp"]}
          class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.015]"
        />
        <figcaption class="flex items-center justify-between gap-4 p-5">
          <span class="font-bold text-white">{appearances[0].event}</span>
          <span class="text-sm text-slate-400">{appearances[0].location}</span>
        </figcaption>
      </figure>

      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
        {appearances.slice(1).map((appearance) => (
          <figure class="group overflow-hidden rounded-3xl border border-white/10 bg-white/[0.05]">
            <Picture
              src={appearance.image}
              alt={appearance.alt}
              widths={[480, 720, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 42vw"
              formats={["avif", "webp"]}
              class="aspect-[16/7] w-full object-cover transition duration-500 group-hover:scale-[1.015]"
            />
            <figcaption class="flex items-center justify-between gap-4 p-4">
              <span class="font-bold text-white">{appearance.event}</span>
              <span class="text-sm text-slate-400">{appearance.location}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-4">
      <div class="bg-slate-950 p-6 text-center">
        <div class="text-3xl font-black">30+</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Conferences</div>
      </div>
      <div class="bg-slate-950 p-6 text-center">
        <div class="text-3xl font-black">15+</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Presentations</div>
      </div>
      <div class="bg-slate-950 p-6 text-center">
        <div class="text-3xl font-black">10+</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Countries</div>
      </div>
      <div class="bg-slate-950 p-6 text-center">
        <div class="text-xl font-black sm:text-2xl">KubeCon + Red Hat Summit</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Flagship stages</div>
      </div>
    </div>
  </div>
</section>
