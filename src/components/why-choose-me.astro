---
import { Icon } from "astro-icon/components";

const pillars = [
  {
    icon: "bi:journal-text",
    title: "Published author & instructor",
    description: "8 technical books, plus courses taught to 10,000+ students on Coursera and Pluralsight.",
  },
  {
    icon: "bx:bxs-cube",
    title: "Hands-on, not just slides",
    description: "I build the platform myself — architecture, deployment, and Day-2 operations — not just the roadmap.",
  },
  {
    icon: "bi:shield-check",
    title: "Audit-ready by default",
    description: "Governance, evidence packs, and compliance mapping built in from the first sprint, not bolted on at the end.",
  },
];
---

<section class="py-16 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto text-center mb-12" data-reveal>
    <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">Why Work With Me Directly</h2>
    <p class="text-lg text-gray-600 mt-4 max-w-3xl mx-auto">
      One senior engineer who has built this stack before — not a rotating bench of consultants.
    </p>
  </div>

  <div class="max-w-6xl mx-auto space-y-5">
    <!-- Lead pillar — full-width bento tile -->
    <div
      data-reveal
      class="relative overflow-hidden rounded-2xl p-8 md:p-10"
      style="background: var(--grad-brand);"
    >
      <div aria-hidden="true" class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/15 blur-2xl pointer-events-none"></div>
      <div class="relative flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
        <span class="inline-flex w-14 h-14 flex-shrink-0 rounded-2xl bg-white/20 border border-white/30 items-center justify-center">
          <Icon name="bx:bxs-rocket" class="w-7 h-7 text-white" />
        </span>
        <div>
          <h3 class="text-xl md:text-2xl font-bold text-white">Independent — no bench of juniors, no agency markup</h3>
          <p class="mt-2 text-white/90 leading-relaxed max-w-2xl">
            AI-ready platforms without big-consultancy overhead — you work directly with the person doing the work, start to finish.
          </p>
        </div>
      </div>
    </div>

    <!-- Supporting pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {pillars.map((pillar) => (
        <div data-reveal class="spotlight-card grad-border bg-white p-6 h-full">
          <span class="inline-flex w-12 h-12 rounded-xl bg-amber-50 items-center justify-center">
            <Icon name={pillar.icon} class="w-6 h-6 text-orange-600" />
          </span>
          <h3 class="mt-4 text-lg font-bold text-gray-900">{pillar.title}</h3>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
