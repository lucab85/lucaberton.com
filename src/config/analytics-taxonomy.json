{
  "$comment": "Controlled vocabularies for GA4 conversion tracking. Read by scripts/validate-analytics.cjs (pre-commit + CI) and documented in docs/analytics-events.md. Add new values HERE first; the validator rejects anything else. topic_cluster values come from src/utils/topicCluster.ts and target_offer values are also derived from the URLs in src/utils/serviceMatches.ts; per-post offers live in src/utils/blogConsultingCtas.ts.",
  "events": {
    "affiliate_click": {
      "required": [
        "company",
        "offer_id",
        "offer_type",
        "cta_position",
        "cta_variant"
      ],
      "optional": [
        "destination_url"
      ]
    },
    "consulting_cta_click": {
      "required": [
        "target_offer",
        "cta_position",
        "cta_variant"
      ],
      "optional": [
        "destination_url",
        "booking_type"
      ]
    },
    "booking_start": {
      "required": [],
      "optional": [
        "booking_type",
        "booking_source",
        "target_offer",
        "cta_position",
        "cta_variant",
        "destination_url"
      ]
    },
    "booked_call": {
      "required": [],
      "optional": [
        "booking_type",
        "booking_source",
        "target_offer",
        "cta_position",
        "cta_variant"
      ]
    },
    "email_signup_start": {
      "required": [
        "form_id"
      ],
      "optional": [
        "cta_position",
        "cta_variant",
        "destination_url"
      ]
    },
    "email_signup": {
      "required": [
        "form_id"
      ],
      "optional": []
    },
    "bootcamp_click": {
      "required": [],
      "optional": [
        "cta_position",
        "cta_variant",
        "destination_url"
      ]
    },
    "bootcamp_apply_start": {
      "required": [],
      "optional": []
    },
    "bootcamp_application_submitted": {
      "required": [],
      "optional": []
    },
    "assessment_submit": {
      "required": [
        "target_offer"
      ],
      "optional": []
    }
  },
  "keyEvents": [
    "booked_call",
    "assessment_submit",
    "email_signup",
    "bootcamp_application_submitted"
  ],
  "params": {
    "cta_position": {
      "values": [
        "top_banner",
        "hero",
        "inline_25",
        "inline_50",
        "inline_75",
        "inline",
        "post_solution",
        "post_conclusion",
        "sidebar",
        "sticky_bar",
        "related_offer",
        "unlabeled"
      ]
    },
    "target_offer": {
      "values": [
        "discovery_call",
        "ai_platform_assessment",
        "production_ai_assessment",
        "ai_readiness_assessment",
        "services",
        "agent_identity_governance_review",
        "agent_platform_assessment",
        "agent_platform_readiness",
        "ai_developer_governance",
        "ai_developer_platform_assessment",
        "ai_software_delivery_assessment",
        "cloud_platform_assessment",
        "enterprise_claude_code_review"
      ],
      "derivedFromServiceMatches": true
    },
    "booking_type": {
      "values": [
        "discovery_call"
      ],
      "pattern": "^[a-z0-9_]{3,60}$"
    },
    "booking_source": {
      "values": [
        "calendly_popup",
        "calendly_native_fallback"
      ]
    },
    "offer_type": {
      "values": [
        "affiliate",
        "partner"
      ]
    },
    "company": {
      "pattern": "^[a-z0-9_]{2,40}$"
    },
    "offer_id": {
      "pattern": "^[a-z0-9_]{3,60}$"
    },
    "form_id": {
      "pattern": "^[a-z0-9_]{3,60}$"
    },
    "cta_variant": {
      "pattern": "^[a-z0-9_]{3,60}$",
      "forbidden": [
        "dark",
        "light",
        "inline",
        "rail",
        "mobile",
        "card",
        "primary",
        "secondary",
        "default",
        "test"
      ]
    },
    "topic_cluster": {
      "derivedFromTopicCluster": true
    },
    "destination_url": {
      "pattern": "^(/|https?://)"
    }
  },
  "customDimensions": [
    "topic_cluster",
    "cta_position",
    "cta_variant",
    "target_offer",
    "company",
    "offer_id",
    "page_type",
    "original_landing_page",
    "original_topic_cluster",
    "booking_type",
    "booking_source",
    "first_consulting_cta",
    "form_id"
  ]
}
