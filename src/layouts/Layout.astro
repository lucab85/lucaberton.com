---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import PostHog from "@components/posthog.astro";
import AnnouncementBanner from "@components/AnnouncementBanner.astro";
import PromoBanner from "@components/PromoBanner.astro";
import Container from "@components/container.astro";
import { bannerFor } from "@utils/topicBanners";
import WebVitals from "@components/WebVitals.astro";
import InteractionTracker from "@components/InteractionTracker.astro";
import ConversionTracker from "@components/ConversionTracker.astro";
import CalendlyPopup from "@components/CalendlyPopup.astro";
import StickyCta from "@components/StickyCta.astro";
import { person, organization, PERSON_ID, WEBSITE_ID } from "@utils/entity";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  // Hides Navbar/Footer/StickyCta in favor of a small logo-only header —
  // for focused conversion pages (e.g. the Bootcamp landing page) where
  // primary site navigation would just be an exit.
  minimalChrome?: boolean;
  minimalCtaHref?: string;
  minimalCtaLabel?: string;
  // target_offer for the consulting_cta_click event on the minimal CTA
  minimalCtaOffer?: string;
  // Absolute canonical URL override, for pages whose primary version lives
  // on another site. Defaults to this page's own URL.
  canonical?: string;
  // Topic cluster of the page (blog posts) — picks the announcement banner.
  topicCluster?: string;
}

// ============================================
// ANNOUNCEMENT BANNER CONFIGURATION
// Set enabled to false to hide a banner
// ============================================
const kubeconBanner = {
  enabled: false,
  emoji: "🎤",
  headline: "Speaking at KubeCon EU 2026",
  description: "Lessons Learned Orchestrating Multi-Tenant GPUs on OpenShift AI",
  linkText: "View Session",
  linkUrl: "https://kccnceu2026.sched.com/event/2CVzs/lessons-learned-orchestrating-multi-tenant-gpus-on-openshift-ai-with-nvidia-kai-gh200-luca-berton-dell-technologies",
  gradientFrom: "cyan-600",
  gradientVia: "blue-600",
  gradientTo: "purple-600",
};

// ============================================

const siteName = "Luca Berton | The Production AI Expert";
const shortSuffix = "Luca Berton"; // Shorter suffix for SEO (keeps titles under 60 chars)
const maxTitleLength = 60; // Google truncates titles longer than ~60 characters

// Site origin from astro.config (falls back to production URL if Astro.site is unset).
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://lucaberton.com";

// Force HTTPS and ensure trailing slash for canonical URL (matches how Astro serves pages)
let canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
// Ensure trailing slash for all URLs (Astro serves pages as /path/index.html → /path/)
if (!canonicalURL.endsWith('/')) {
  canonicalURL = canonicalURL + '/';
}

const resolvedImageWithDomain = new URL("/opengraph.jpg", siteOrigin).toString();
const { title, description: customDescription, image: customImage, noindex, minimalChrome = false, minimalCtaHref, minimalCtaLabel = "Book Assessment", minimalCtaOffer = "discovery_call", canonical: canonicalOverride, topicCluster } = Astro.props;
const hasCanonicalOverride = Boolean(canonicalOverride);

if (canonicalOverride) canonicalURL = canonicalOverride;

// Use custom image if provided (e.g. blog post hero), otherwise default.
// Guard: a custom image that does NOT exist in the build output (a missing
// static/ asset) would make the OG image 404 and link previews (WhatsApp /
// iMessage / LinkedIn) render as a bare link. Fall back to the global
// branded opengraph.jpg in that case so every shared URL gets a valid card.
const STATIC_DIR = fileURLToPath(new URL("../../static/", import.meta.url));
const customImageResolves =
  !!customImage &&
  (customImage.startsWith("http") ||
    customImage.startsWith("/_astro/") ||
    existsSync(join(STATIC_DIR, customImage)));
const ogImage = customImageResolves
  ? (customImage.startsWith("http") ? customImage : new URL(customImage, siteOrigin).toString())
  : resolvedImageWithDomain;

// Smart title: use short suffix to keep under 60 chars, or no suffix if still too long
const makeTitle = (() => {
  if (!title) return siteName;
  const withShortSuffix = `${title} | ${shortSuffix}`;
  if (withShortSuffix.length <= maxTitleLength) {
    return withShortSuffix;
  }
  // If still too long, just use the title alone
  return title;
})();

const metaDescription = customDescription
  ? customDescription
  : (title === "Home" || !title
    ? "Luca Berton — The Production AI Expert and Docker Captain. 15+ years, 8 books, KubeCon & Red Hat Summit speaker in AI platforms and Kubernetes."
    : "Expert AI, Kubernetes, and Cloud Consulting by Luca Berton. Automation, GPU orchestration, and platform engineering insights from 15+ years of experience.");

// Detect homepage so we can preload only the hero slideshow LCP image there.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

// LinkedIn Insight Tag — omitted entirely until a partner ID is configured.
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID || "";

// Structured data: one graph for the person (entity home: this site), the
// company he runs (Open Empower, entity home: openempower.com) and this
// website. @ids and core values come from src/utils/entity.ts and are the
// same on all of Luca's sites; posts, videos, books and products reference
// the Person by @id (PERSON_REF) instead of describing him again.
const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      ...person,
      image: "https://lucaberton.com/blog/thumbnails/luca-berton-author.jpg",
      knowsAbout: ["Artificial Intelligence", "Kubernetes", "Docker", "Ansible", "Cloud Infrastructure", "GPU Orchestration", "Platform Engineering", "MLOps", "DevOps"],
      memberOf: [{ "@type": "Organization", name: "Docker Captains" }],
      alumniOf: { "@type": "Organization", name: "Red Hat" },
    },
    organization,
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      name: "Luca Berton | The Production AI Expert",
      url: "https://lucaberton.com/",
      description: "Luca Berton's personal site: articles on AI coding agents and tools, production AI, Kubernetes and automation, plus his books, talks and event recaps.",
      publisher: { "@id": PERSON_ID },
      potentialAction: {
        "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: "https://lucaberton.com/blog/search?q={search_term_string}" },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- If JS never runs, [data-reveal]/[data-reveal-line] content must still be visible. -->
    <noscript><style>[data-reveal], [data-reveal-line] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <link rel="alternate" type="application/rss+xml" title="Luca Berton Blog" href="/rss.xml" />
    <link rel="describedby" href="/llms.txt" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- www/http redirect handled at Cloudflare level (no client-side JS needed) -->

    <!-- Preconnect to critical third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="dns-prefetch" href="https://f.convertkit.com" />

    <!-- Self-hosted variable fonts: preload + non-blocking @font-face (font-display: swap) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-variable-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-variable-latin.woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Inter Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url('/fonts/inter-variable-latin.woff2') format('woff2-variations'),
             url('/fonts/inter-variable-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Bricolage Grotesque Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 200 800;
        src: url('/fonts/bricolage-grotesque-variable-latin.woff2') format('woff2-variations'),
             url('/fonts/bricolage-grotesque-variable-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* Width axis (75–100%) for the poster-size words on the homepage; only
         downloaded by pages that use the family. */
      @font-face {
        font-family: 'Bricolage Grotesque Condensed';
        font-style: normal;
        font-display: swap;
        font-weight: 200 800;
        font-stretch: 75% 100%;
        src: url('/fonts/bricolage-grotesque-wdth-latin.woff2') format('woff2-variations'),
             url('/fonts/bricolage-grotesque-wdth-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>

    <!--
      SEO is deliberately the first dynamic (non-static) child of <head>.
      @astrojs/compiler 2.13.1 has a codegen bug where the first `{cond &&
      <tag/>}`-shaped expression right after the static head content gets its
      JS condition emitted as literal HTML text (e.g. a stray "isHome &&"
      string visible on the page) instead of being evaluated. A component
      call like <SEO/> here doesn't trigger it, so it shields the real
      conditionals (hreflang links, hero preload) below it. Don't reorder
      this above the static content, and don't add a new `{cond && <tag/>}`
      expression before it.
    -->
    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex || false}
      nofollow={false}
      twitter={{
        creator: "@TheLucaBerton",
        site: "@TheLucaBerton",
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: ogImage,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: ogImage,
        },
        image: {
          alt: `Luca Berton - ${title}`,
        },
        optional: {
          description: metaDescription,
          locale: "en_US",
          siteName: siteName,
        },
      }}
    />

    <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains" />
    {!hasCanonicalOverride && <link rel="alternate" hreflang="en" href={canonicalURL} />}
    {!hasCanonicalOverride && <link rel="alternate" hreflang="x-default" href={canonicalURL} />}

    {isHome && (
      <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-wdth-latin.woff2" crossorigin />
    )}

    <!-- opengraph.jpg only used by social crawlers, no need to preload -->

    <!-- Structured data: Person + Organization + WebSite (siteGraph above).
         The former ProfessionalService node is gone: consulting is Open
         Empower's, referenced through worksFor. -->
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

    <!-- FAQ Schema (homepage only — blog posts emit their own per-post FAQPage,
         and Google allows only one FAQPage entity per page) -->
    {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What AI and cloud consulting services does Luca Berton offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Luca Berton delivers consulting through Open Empower (https://www.openempower.com/), the Amsterdam consultancy he founded: AI readiness assessments, AI platform engineering, MLOps and AI governance for regulated enterprises in the EU."
          }
        },
        {
          "@type": "Question",
          "name": "What is Ansible Pilot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ansible Pilot is the leading resource for Ansible automation learning, featuring a YouTube channel with 6.1K subscribers and 1M+ views, plus AnsiblePilot.com with 648K total users."
          }
        },
        {
          "@type": "Question",
          "name": "How can I book a consultation with Luca Berton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Book a call with Open Empower at https://www.openempower.com/book-a-call, or schedule a free consultation through Calendly at calendly.com/lucaberton or visit lucaberton.com/contact."
          }
        }
      ]
    })} />
    )}

    <link
      rel="stylesheet"
      href="/styles/cookieconsent.css"
      media="print"
      onload="this.media='all'"
    />
    <!-- No analytics from local builds or automated browsers. 205 of the 214
         contact_form_submit key events from Sep 28 to Oct 30, 2026 came from
         127.0.0.1: the Playwright suite runs against `astro preview` with the
         production tags built in. GA4, PostHog, Clarity and the LinkedIn tag
         check this flag; ConversionTracker still pushes every event to
         window.dataLayer, which is what the E2E tests read. -->
    <script is:inline>
      window.__lucaNoAnalytics = (function () {
        var h = window.location.hostname;
        return h === 'localhost' || h === '127.0.0.1' || h === '0.0.0.0' || h === '::1' || h === '[::1]' ||
          /\.localhost$/.test(h) || navigator.webdriver === true;
      })();
    </script>
    <!-- Google Analytics (gtag.js) — loads immediately to capture all visitors -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M9Q5F672JT" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Google's documented opt-out: gtag.js still reads the dataLayer but sends nothing.
      if (window.__lucaNoAnalytics) window['ga-disable-G-M9Q5F672JT'] = true;
      gtag('js', new Date());
      gtag('config', 'G-M9Q5F672JT');
    </script>

    <!-- PostHog product analytics (EU region) -->
    <PostHog />

    <!-- Kit.com (formerly ConvertKit) — lazy-loaded on first interaction to avoid
         eagerly setting the __cf_bm third-party cookie on every page load. -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadKit() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://f.convertkit.com/9153490/ce74a48bfa.js';
          s.setAttribute('data-uid', 'ce74a48bfa');
          document.head.appendChild(s);
        }
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadKit, { once: true, passive: true });
        });
      })();
    </script>
    <!-- End Kit.com -->

    <!-- Microsoft Clarity (deferred until user interaction) -->
    <script type="text/javascript">
        (function() {
          if (window.__lucaNoAnalytics) return;
          var loaded = false;
          function loadClarity() {
            if (loaded) return;
            loaded = true;
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "v5mr11qsni");
          }
          ['scroll','click','touchstart','mousemove'].forEach(function(evt) {
            document.addEventListener(evt, loadClarity, { once: true, passive: true });
          });
        })();
    </script>
    <!-- End Microsoft Clarity -->

    <!-- LinkedIn Insight Tag (only emitted once PUBLIC_LINKEDIN_PARTNER_ID is set) -->
    {linkedInPartnerId && (
      <Fragment>
        <script type="text/javascript" set:html={`
          _linkedin_partner_id = "${linkedInPartnerId}";
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push(_linkedin_partner_id);
        `} />
        <script type="text/javascript" is:inline>
          (function(l) {
            if (window.__lucaNoAnalytics) return;
            if (!l) { window.lintrk = function(a,b){window.lintrk.q.push([a,b])}; window.lintrk.q = []; }
            var s = document.getElementsByTagName("script")[0];
            var b = document.createElement("script");
            b.type = "text/javascript"; b.async = true;
            b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
            s.parentNode.insertBefore(b, s);
          })(window.lintrk);
        </script>
        <noscript>
          <img height="1" width="1" style="display:none;" alt="" src={`https://px.ads.linkedin.com/collect/?pid=${linkedInPartnerId}&fmt=gif`} />
        </noscript>
      </Fragment>
    )}
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md">
      Skip to main content
    </a>
    {!minimalChrome && <AnnouncementBanner {...kubeconBanner} />}
    {!minimalChrome && <AnnouncementBanner {...bannerFor(topicCluster)} />}
    {minimalChrome ? (
      <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 py-4 backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-12">
          <a href="/" class="inline-flex items-center gap-2 text-lg font-bold text-slate-900 hover:text-slate-600 transition-colors">
            Luca Berton
          </a>
          {minimalCtaHref && (
            <a href={minimalCtaHref} data-track-event="consulting_cta_click" data-tp-target-offer={minimalCtaOffer} data-tp-cta-position="top_banner" data-tp-cta-variant="minimal_header_cta" class="rounded-full bg-red-600 px-4 py-2 text-sm font-bold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-500">
              {minimalCtaLabel}
            </a>
          )}
        </div>
      </header>
    ) : (
      <Navbar />
    )}
    <script is:inline>
      // Lazy-load cookie consent only when user starts interacting with the page
      // (saves ~22 KB of script eval on initial load → improves TBT).
      (function () {
        var loaded = false;
        function loadConsent() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.type = 'module';
          s.src = '/scripts/cookieconsent-config.js';
          document.head.appendChild(s);
        }
        var idle = window.requestIdleCallback || function (fn) { return setTimeout(fn, 2500); };
        idle(loadConsent, { timeout: 4000 });
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadConsent, { once: true, passive: true });
        });
      })();
    </script>
    <main id="main-content">
      {/* Sponsored banner from static/promo/promos.json (docs/promo-banners.md) */}
      {!minimalChrome && (
        <Container>
          <PromoBanner class="mt-6 mb-2" />
        </Container>
      )}
      <slot />
    </main>
    {!minimalChrome && <Footer />}
    {!minimalChrome && <StickyCta topicCluster={topicCluster} />}
    <WebVitals />
    <InteractionTracker />
    <ConversionTracker />
    <CalendlyPopup />
    <script>
      // Shared scroll-reveal: any element with [data-reveal] fades/rises in
      // once when it enters the viewport. See the .is-revealed CSS in
      // global.css. prefers-reduced-motion is handled purely in CSS there.
      const revealTargets = document.querySelectorAll('[data-reveal], [data-reveal-line]');
      if (revealTargets.length) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
        );
        revealTargets.forEach((el) => revealObserver.observe(el));
      }

      // Shared cursor-tracked glow for any .spotlight-card (see global.css).
      // One delegated listener instead of a per-card handler.
      document.addEventListener('pointermove', (e) => {
        const card = e.target instanceof Element ? e.target.closest<HTMLElement>('.spotlight-card') : null;
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      }, { passive: true });
    </script>
    <style is:global>
      /* Improve Page Speed */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
