---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import AnnouncementBanner from "@components/AnnouncementBanner.astro";
import WebVitals from "@components/WebVitals.astro";
import StickyCta from "@components/StickyCta.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

// ============================================
// ANNOUNCEMENT BANNER CONFIGURATION
// Set enabled to false to hide a banner
// ============================================
const kubeconBanner = {
  enabled: false,
  emoji: "🎤",
  headline: "Speaking at KubeCon EU 2026",
  description: "Lessons Learned Orchestrating Multi-Tenant GPUs on OpenShift AI",
  linkText: "View Session",
  linkUrl: "https://kccnceu2026.sched.com/event/2CVzs/lessons-learned-orchestrating-multi-tenant-gpus-on-openshift-ai-with-nvidia-kai-gh200-luca-berton-dell-technologies",
  gradientFrom: "cyan-600",
  gradientVia: "blue-600",
  gradientTo: "purple-600",
};

const redHatSummitBanner = {
  enabled: true,
  emoji: "🎓",
  headline: "Free Claude Code Masterclass",
  description: "Learn AI-assisted development free on Udemy — plus the companion book on Leanpub & Amazon.",
  linkText: "Start Free",
  linkUrl: "https://www.udemy.com/course/claude-code-masterclass-ai-coding/",
  gradientFrom: "indigo-600",
  gradientVia: "purple-600",
  gradientTo: "pink-600",
};
// ============================================

const siteName = "Luca Berton | AI & Cloud Advisor";
const shortSuffix = "Luca Berton"; // Shorter suffix for SEO (keeps titles under 60 chars)
const maxTitleLength = 60; // Google truncates titles longer than ~60 characters

// Site origin from astro.config (falls back to production URL if Astro.site is unset).
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://lucaberton.com";

// Force HTTPS and ensure trailing slash for canonical URL (matches how Astro serves pages)
let canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
// Ensure trailing slash for all URLs (Astro serves pages as /path/index.html → /path/)
if (!canonicalURL.endsWith('/')) {
  canonicalURL = canonicalURL + '/';
}

const resolvedImageWithDomain = new URL("/opengraph.jpg", siteOrigin).toString();
const { title, description: customDescription, image: customImage, noindex } = Astro.props;

// Use custom image if provided (e.g. blog post hero), otherwise default
const ogImage = customImage 
  ? (customImage.startsWith('http') ? customImage : new URL(customImage, siteOrigin).toString())
  : resolvedImageWithDomain;

// Smart title: use short suffix to keep under 60 chars, or no suffix if still too long
const makeTitle = (() => {
  if (!title) return siteName;
  const withShortSuffix = `${title} | ${shortSuffix}`;
  if (withShortSuffix.length <= maxTitleLength) {
    return withShortSuffix;
  }
  // If still too long, just use the title alone
  return title;
})();

const metaDescription = customDescription 
  ? customDescription
  : (title === "Home" || !title
    ? "Luca Berton — AI & Cloud Advisor, Docker Captain. 18+ years, 8 books, KubeCon & Red Hat Summit speaker. Consulting in AI platforms, GPU orchestration & Kubernetes."
    : "Expert AI, Kubernetes, and Cloud Consulting by Luca Berton. Automation, GPU orchestration, and platform engineering insights from 18+ years of experience.");

// Detect homepage so we can preload only the hero slideshow LCP image there.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Luca Berton Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- www/http redirect handled at Cloudflare level (no client-side JS needed) -->

    <!-- Preconnect to critical third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="dns-prefetch" href="https://f.convertkit.com" />

    <!-- Self-hosted variable fonts: preload + non-blocking @font-face (font-display: swap) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-variable-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-variable-latin.woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Inter Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url('/fonts/inter-variable-latin.woff2') format('woff2-variations'),
             url('/fonts/inter-variable-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Bricolage Grotesque Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 200 800;
        src: url('/fonts/bricolage-grotesque-variable-latin.woff2') format('woff2-variations'),
             url('/fonts/bricolage-grotesque-variable-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>

    {isHome && (
      <link rel="preload" as="image" href="/hero-stage-1.webp" fetchpriority="high" />
    )}
    
    <!-- Additional SEO meta tags -->
    <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains" />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex || false}
      nofollow={false}
      twitter={{
        creator: "@lucaberton",
        site: "@lucaberton",
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: ogImage,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: ogImage,
        },
        image: {
          alt: `Luca Berton - ${title}`,
        },
        optional: {
          description: metaDescription,
          locale: "en_US",
          siteName: siteName,
        },
      }}
    />

    <!-- opengraph.jpg only used by social crawlers, no need to preload -->

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Luca Berton",
      "url": "https://lucaberton.com",
      "image": "https://lucaberton.com/blog/thumbnails/luca-berton-author.jpg",
      "jobTitle": "AI & Cloud Advisor",
      "description": "AI & Cloud Advisor, Docker Captain, and author of 8 technical books. 18+ years of enterprise infrastructure experience. Speaker at KubeCon EU 2026 and Red Hat Summit 2026. Former Red Hat engineer.",
      "knowsAbout": ["Artificial Intelligence", "Kubernetes", "Docker", "Ansible", "Cloud Infrastructure", "GPU Orchestration", "Platform Engineering", "MLOps", "DevOps"],
      "memberOf": [
        { "@type": "Organization", "name": "Docker Captains" }
      ],
      "alumniOf": { "@type": "Organization", "name": "Red Hat" },
      "sameAs": [
        "https://www.linkedin.com/in/lucaberton/",
        "https://www.ansiblepilot.com/",
        "https://www.terraformpilot.com/",
        "https://github.com/lucab85",
        "https://bsky.app/profile/lucaberton.com",
        "https://www.youtube.com/@BertonLuca"
      ]
    }
    </script>

    <!-- FAQ Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What AI and cloud consulting services does Luca Berton offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Luca Berton provides expert consulting in AI/ML platform strategy, multi-tenant GPU orchestration on OpenShift AI, MLOps enablement, cloud infrastructure design, Kubernetes workshops, and Ansible & Python training."
          }
        },
        {
          "@type": "Question",
          "name": "What is Ansible Pilot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ansible Pilot is the leading resource for Ansible automation learning, featuring a YouTube channel with 6.1K subscribers and 1M+ views, plus AnsiblePilot.com with 648K total users."
          }
        },
        {
          "@type": "Question",
          "name": "How can I book a consultation with Luca Berton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Schedule a free consultation through Calendly at calendly.com/lucaberton or visit lucaberton.com/contact."
          }
        }
      ]
    }
    </script>

    <!-- WebSite Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Luca Berton | AI & Cloud Advisor",
      "url": "https://lucaberton.com",
      "description": "Expert AI, Kubernetes, and Cloud Consulting. 18+ years of experience, 8 technical books, speaker at KubeCon and Red Hat Summit.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://lucaberton.com/blog/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <!-- ProfessionalService Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Luca Berton AI & Cloud Consulting",
      "url": "https://lucaberton.com",
      "description": "AI platform strategy, GPU orchestration, MLOps, cloud infrastructure, and automation consulting.",
      "founder": { "@type": "Person", "name": "Luca Berton" },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Amsterdam",
        "addressCountry": "NL"
      },
      "areaServed": "Worldwide",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Consulting Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Integration & GPU Platforms", "url": "https://lucaberton.com/services/ai-integration/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ansible & Python Training", "url": "https://lucaberton.com/services/ansible-python-training/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kubernetes Workshops", "url": "https://lucaberton.com/services/kubernetes-workshops/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud Infrastructure", "url": "https://lucaberton.com/services/cloud-infrastructure/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automation Strategy", "url": "https://lucaberton.com/services/automation-strategy/" } }
        ]
      }
    }
    </script>

    <link
      rel="stylesheet"
      href="/styles/cookieconsent.css"
      media="print"
      onload="this.media='all'"
    />
    <!-- Google Analytics (gtag.js) — loads immediately to capture all visitors -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5NMM6ZT4E4" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5NMM6ZT4E4');
    </script>

    <!-- Kit.com (formerly ConvertKit) — lazy-loaded on first interaction to avoid
         eagerly setting the __cf_bm third-party cookie on every page load. -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadKit() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://f.convertkit.com/9153490/ce74a48bfa.js';
          s.setAttribute('data-uid', 'ce74a48bfa');
          document.head.appendChild(s);
        }
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadKit, { once: true, passive: true });
        });
      })();
    </script>
    <!-- End Kit.com -->

    <!-- Microsoft Clarity (deferred until user interaction) -->
    <script type="text/javascript">
        (function() {
          var loaded = false;
          function loadClarity() {
            if (loaded) return;
            loaded = true;
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "v5mr11qsni");
          }
          ['scroll','click','touchstart','mousemove'].forEach(function(evt) {
            document.addEventListener(evt, loadClarity, { once: true, passive: true });
          });
        })();
    </script>
    <!-- End Microsoft Clarity -->
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md">
      Skip to main content
    </a>
    <AnnouncementBanner {...kubeconBanner} />
    <AnnouncementBanner {...redHatSummitBanner} />
    <Navbar />
    <script is:inline>
      // Lazy-load cookie consent only when user starts interacting with the page
      // (saves ~22 KB of script eval on initial load → improves TBT).
      (function () {
        var loaded = false;
        function loadConsent() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.type = 'module';
          s.src = '/scripts/cookieconsent-config.js';
          document.head.appendChild(s);
        }
        var idle = window.requestIdleCallback || function (fn) { return setTimeout(fn, 2500); };
        idle(loadConsent, { timeout: 4000 });
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadConsent, { once: true, passive: true });
        });
      })();
    </script>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <WebVitals />
    <style is:global>
      /* Improve Page Speed */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
