---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import Collapsible from "@components/Collapsible.astro";
import ReadinessScorecard from "@components/react/ReadinessScorecard.tsx";

export const prerender = true;
export const lastModified = '2026-07-20';

const faqs = [
  {
    q: "How long does the scorecard take?",
    a: "About ten minutes — 25 quick confidence ratings across five capability areas, no research required."
  },
  {
    q: "Do I need to give my email to see my score?",
    a: "No. Email is optional and only used if you want your result sent to you — you'll see your results either way."
  },
  {
    q: "How is this different from the AI Readiness Assessment?",
    a: "The AI Readiness Assessment is a paid, consultant-led engagement for organizations assessing their AI infrastructure maturity. This scorecard is a free, self-serve tool for individual engineers to see which skills transfer and which to build next."
  },
  {
    q: "What do I do with my result?",
    a: "Start with your lowest-scoring category. If you want a structured four-week path to close the gaps, the AI Platform Engineer Bootcamp is built around exactly these five capability areas."
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout
  title="AI Platform Engineer Readiness Scorecard"
  description="Free 10-minute scorecard: discover which of your existing infrastructure skills transfer to production AI, and the capability gaps to close next."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Breadcrumb items={[{ name: "AI Platform Engineer Readiness Scorecard" }]} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-gray-900 via-gray-900 to-amber-900/30 py-16 lg:py-20">
    <Container>
      <div class="max-w-2xl mx-auto text-center" data-reveal>
        <span class="chip bg-white/10 text-amber-200 border border-white/10">
          <span class="chip-dot"></span>
          Free · 10 Minutes · No Signup Required
        </span>
        <h1 class="mt-6 text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight">
          AI Platform Engineer <span class="text-brand">Readiness Scorecard</span>
        </h1>
        <p class="mt-6 text-lg text-gray-300 leading-relaxed">
          Discover which of your existing infrastructure skills transfer to production
          AI — and the five capability gaps to close next.
        </p>
      </div>
    </Container>
  </section>

  <!-- Scorecard -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <Container>
      <ReadinessScorecard client:load />
    </Container>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map(f => (
            <Collapsible title={f.q}>{f.a}</Collapsible>
          ))}
        </div>
      </div>
    </Container>
  </section>
</Layout>
