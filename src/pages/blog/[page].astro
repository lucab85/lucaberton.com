---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import BlogSearch from "@components/BlogSearch.astro";
import Pagination from "@components/Pagination.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import slugify from "slugify";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => {
    return !data.draft && data.publishDate < new Date();
  });
  const POSTS_PER_PAGE = 24;
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

  return [
    ...Array.from({ length: totalPages - 1 }, (_, i) => ({
      params: { page: String(i + 2) },
    })),
    // Redirect out-of-range legacy pagination pages to last valid page
    ...Array.from({ length: 20 }, (_, i) => totalPages + i + 1)
      .map((p) => ({ params: { page: String(p) }, props: { outOfRange: true } })),
  ];
}

const currentPage = Number(Astro.params.page);

if (Astro.props.outOfRange) {
  return Astro.redirect("/blog/", 301);
}

const POSTS_PER_PAGE = 24;

const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
const sortedPosts = allPosts.sort((a, b) => {
  const dateDiff = b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  if (dateDiff !== 0) return dateDiff;
  const amod = a.data.lastModified ? new Date(a.data.lastModified).valueOf() : 0;
  const bmod = b.data.lastModified ? new Date(b.data.lastModified).valueOf() : 0;
  return bmod - amod;
});

const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const start = (currentPage - 1) * POSTS_PER_PAGE;
const end = start + POSTS_PER_PAGE;
const posts = sortedPosts.slice(start, end);

// Estimated reading time (engagement signal + modern UX)
const readingTime = (body?: string) =>
  Math.max(1, Math.round((body || "").trim().split(/\s+/).length / 200));

// Human-friendly date (e.g. "Jan 5, 2026")
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// Category stats for pills
const categoryMap = new Map<string, number>();
allPosts.forEach(p => {
  const cat = p.data.category;
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});
const topCategories = [...categoryMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

// CollectionPage schema for paginated blog listing (rich result eligibility)
const paginatedCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `https://lucaberton.com/blog/${currentPage}/`,
  "url": `https://lucaberton.com/blog/${currentPage}/`,
  "name": `Luca Berton Blog — Page ${currentPage}`,
  "description": `Page ${currentPage} of ${totalPages}: Expert articles on AI, Kubernetes, Ansible, Platform Engineering, and cloud infrastructure.`,
  "isPartOf": { "@type": "WebSite", "@id": "https://lucaberton.com/#website", "url": "https://lucaberton.com/" },
  "author": { "@type": "Person", "@id": "https://lucaberton.com/#author", "name": "Luca Berton", "url": "https://lucaberton.com/about/" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.map((post, index) => ({
      "@type": "ListItem",
      "position": (currentPage - 1) * POSTS_PER_PAGE + index + 1,
      "url": `https://lucaberton.com/blog/${post.slug}/`,
      "name": post.data.title
    }))
  }
};
---

<Layout title={`Blog — Page ${currentPage} — AI, Kubernetes & Cloud Articles`} description={`Page ${currentPage} of ${totalPages}: Expert articles on AI, Kubernetes, Ansible, Platform Engineering, and cloud infrastructure by Luca Berton — The Production AI Expert.`}>
  <script type="application/ld+json" set:html={JSON.stringify(paginatedCollectionSchema)} />
  {currentPage > 1 && <link rel="prev" href={currentPage === 2 ? "/blog/" : `/blog/${currentPage - 1}/`} slot="head" />}
  {currentPage < totalPages && <link rel="next" href={`/blog/${currentPage + 1}/`} slot="head" />}
  <Breadcrumb items={[{ name: "Blog", url: "/blog/" }, { name: `Page ${currentPage}` }]} />
  <Container>
    <div class="mt-16 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight bg-gradient-to-r from-slate-900 to-blue-700 bg-clip-text text-transparent">Blog</h1>
      <p class="text-lg mt-4 text-slate-600 mx-auto max-w-xl">
        {allPosts.length}+ articles — Page {currentPage} of {totalPages}
      </p>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <BlogSearch />
      <div class="flex gap-4">
        <a href="/blog/search/" rel="nofollow" class="text-blue-600 hover:text-blue-800 font-medium text-sm">🔍 Search</a>
        <a href="/blog/categories/" class="text-blue-600 hover:text-blue-800 font-medium text-sm">📂 Categories</a>
      </div>
    </div>

    <!-- Category filter pills -->
    <div class="mt-6 flex flex-wrap gap-2 justify-center">
      <a href="/blog/" class="px-4 py-1.5 rounded-full text-sm font-medium bg-blue-600 text-white">
        All ({allPosts.length})
      </a>
      {topCategories.map(([cat, count]) => (
        <a
          href={`/blog/categories/${slugify(cat, { lower: true, strict: true })}/`}
          class="px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition"
        >
          {cat} ({count})
        </a>
      ))}
    </div>

    <main class="mt-12">
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {posts.map((post, index) => (
          <li class="group">
            <a href={`/blog/${post.slug}/`} class="block h-full">
              <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-blue-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
                <div class="relative overflow-hidden">
                  <Picture
                    src={post.data.image.src}
                    alt={post.data.image.alt}
                    sizes="(max-width: 800px) 100vw, 400px"
                    width={800}
                    height={420}
                    loading={index <= 2 ? "eager" : "lazy"}
                    decoding={index <= 2 ? "sync" : "async"}
                    class="w-full object-cover aspect-video group-hover:scale-105 transition-transform duration-300"
                  />
                  <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/90 text-gray-700 backdrop-blur-sm">
                    {post.data.category}
                  </span>
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <h2 class="text-lg font-semibold leading-snug tracking-tight group-hover:text-blue-600 transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-gray-500 text-sm mt-2 line-clamp-2 flex-1">
                    {post.data.snippet}
                  </p>
                  <div class="flex items-center gap-2 mt-4 pt-3 border-t border-gray-100 text-xs text-gray-500">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {fmtDate(post.data.publishDate)}
                    </time>
                    <span aria-hidden="true">•</span>
                    <span>{readingTime(post.body)} min read</span>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <Pagination currentPage={currentPage} totalPages={totalPages} />
    </main>
  </Container>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
