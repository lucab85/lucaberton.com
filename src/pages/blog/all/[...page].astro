---
// Every published post A–Z, 250 per page, linked from the footer.
// The blog listing shows 24 posts a page, so in the Nov 6, 2026 audit 988 posts
// sat four clicks from the home page and 97 sat five to seven. With these pages
// every post is at most three clicks from any page (page → /blog/all/ →
// /blog/all/N/ → post). 250 keeps each page well under the ~1,000 links
// crawlers read per page.
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft && data.publishDate < new Date());
  const sorted = posts.sort((a, b) => a.data.title.localeCompare(b.data.title, "en", { sensitivity: "base" }));
  return paginate(sorted, { pageSize: 250 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pathOf = (n: number) => (n === 1 ? "/blog/all/" : `/blog/all/${n}/`);
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);

const groups: { letter: string; posts: typeof page.data }[] = [];
for (const post of page.data) {
  const first = post.data.title.trim().charAt(0).toUpperCase();
  const letter = /[A-Z]/.test(first) ? first : "#";
  const last = groups[groups.length - 1];
  if (last && last.letter === letter) last.posts.push(post);
  else groups.push({ letter, posts: [post] });
}

const title = page.currentPage === 1 ? "All articles A–Z" : `All articles A–Z, page ${page.currentPage} of ${page.lastPage}`;
const description = `Every article on lucaberton.com sorted by title: ${page.total} posts on AI, Kubernetes, Ansible and platform engineering, page ${page.currentPage} of ${page.lastPage}.`;
---

<Layout title={title} description={description}>
  {page.url.prev && <link rel="prev" href={pathOf(page.currentPage - 1)} slot="head" />}
  {page.url.next && <link rel="next" href={pathOf(page.currentPage + 1)} slot="head" />}
  <Breadcrumb items={[{ name: "Blog", url: "/blog/" }, { name: "All articles A–Z" }]} />
  <Container>
    <div class="mx-auto max-w-3xl py-10">
      <h1 class="text-4xl font-bold">All articles A–Z</h1>
      <p class="mt-3 text-lg text-gray-700">
        All {page.total} articles, sorted by title. Page {page.currentPage} of {page.lastPage}.
        <a href="/blog/" class="underline">Latest articles</a>
      </p>

      <nav aria-label="Article index pages" class="my-6 flex flex-wrap gap-2">
        {pageNumbers.map((n) => (
          <a
            href={pathOf(n)}
            aria-current={n === page.currentPage ? "page" : undefined}
            class={n === page.currentPage
              ? "rounded-md border border-blue-700 bg-blue-700 px-3 py-1.5 text-sm text-white"
              : "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:border-blue-700"}
          >{n}</a>
        ))}
      </nav>

      {groups.map((g) => (
        <section class="mb-8">
          <h2 class="mb-3 text-xl font-semibold">{g.letter}</h2>
          <ul class="space-y-1.5">
            {g.posts.map((post) => (
              <li><a href={`/blog/${post.id}/`} class="text-blue-700 hover:underline">{post.data.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </Container>
</Layout>
