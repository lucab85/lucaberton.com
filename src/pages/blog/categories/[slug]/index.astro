---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { Picture } from "astro:assets";
import { SITE } from "../../../../config.mjs";
import getUniqueCategories from "@utils/getUniqueCategories";
import slugify from "slugify";
import Breadcrumb from "@components/Breadcrumb.astro";
import { descriptions } from "../descriptions";

// Generate static paths
export const getStaticPaths = async () => {
  const categories = await getUniqueCategories();

  return categories.map(category => ({
    params: { slug: category.slug },
    props: { category: category.category },
  }));
};

const { category } = Astro.props;

// Get all blog posts (exclude drafts so de-indexed posts are not listed/linked)
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const categoryPosts = allPosts
  .filter(post => {
    const cats = post.data.categories ?? post.data.category;
    return Array.isArray(cats) ? cats.includes(category) : cats === category;
  })
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Generate SEO-friendly meta description
const metaDescription = `${categoryPosts.length} expert ${category} articles by Luca Berton covering practical guides, tutorials, best practices, and insights for engineers and technical leaders.`;

// Generate category slug for URL
const categorySlug = slugify(category, { lower: true, strict: true });
const categoryUrl = `https://lucaberton.com/blog/categories/${categorySlug}/`;

// Unique, per-category lead sentence (falls back to a generic but descriptive one)
const categoryDescription =
  (descriptions as Record<string, string>)[category] ??
  `Expert ${category} articles, tutorials, and guides covering practical techniques, tooling, and production-grade best practices.`;

// Sibling categories for contextual internal linking + topical depth
const relatedCategories = (await getUniqueCategories())
  .filter((c) => c.category !== category)
  .slice(0, 8);

// Structured data for category page (schema.org compliant)
const categoryStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": categoryUrl,
  "name": `${category} Articles`,
  "description": metaDescription,
  "url": categoryUrl,
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://lucaberton.com/#website",
    "name": "Luca Berton",
    "url": "https://lucaberton.com/"
  },
  "about": {
    "@type": "Thing",
    "name": category
  },
  "author": {
    "@type": "Person",
    "@id": "https://lucaberton.com/#author",
    "name": "Luca Berton",
    "url": "https://lucaberton.com/about/"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": categoryPosts.length,
    "itemListElement": categoryPosts.slice(0, 10).map((post, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://lucaberton.com/blog/${post.slug}/`
    }))
  }
};
---

<Layout title={`${category} — Articles & Guides`} description={metaDescription}>
  <!-- Category Page Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(categoryStructuredData)}></script>
  
  <!-- Additional SEO meta tags -->
  <meta name="description" content={metaDescription} slot="head" />
  <meta property="og:description" content={metaDescription} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta name="robots" content="index, follow" slot="head" />
  <Breadcrumb items={[{ name: "Blog", url: "/blog/" }, { name: "Categories", url: "/blog/categories/" }, { name: category }]} />
  <Container>
    <div class="mt-16 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{category}</h1>
      <p class="text-lg mt-4 text-slate-500 mx-auto max-w-xl">
        All posts in the "{category}" category
      </p>
    </div>

    <div class="mt-10 max-w-3xl mx-auto prose prose-slate dark:prose-invert">
      <p>{categoryDescription}</p>
      <p>
        Browse the <strong>{categoryPosts.length}</strong> {category} articles
        below. Written by Luca Berton — Docker Captain, author of 8 technical
        books on Ansible, and an The Production AI Expert with 15+ years of
        enterprise experience — each post covers practical {category.toLowerCase()}
        techniques, real-world troubleshooting, and production-grade best
        practices for engineers, SREs, platform teams, and technical leaders.
      </p>
      <p>
        Whether you are looking for a quick command reference, a deep-dive
        tutorial, a step-by-step error fix, or strategic guidance, the {category}
        category aggregates hands-on guides, benchmarks, conference recaps,
        and architectural insights drawn from real customer engagements and
        open-source projects. New articles are published regularly — bookmark
        this page or subscribe to the <a href="/rss.xml">RSS feed</a> to stay
        up to date.
      </p>
      {relatedCategories.length > 0 && (
        <p>
          Explore related categories:{" "}
          {relatedCategories.map((c, i) => (
            <>
              <a href={`/blog/categories/${c.slug}/`}>{c.category}</a>{i < relatedCategories.length - 1 ? ", " : "."}
            </>
          ))}
        </p>
      )}
      <p>
        Every {category} article on this page is written from first-hand
        experience — deployed in production, debugged under real constraints,
        and distilled into clear, reproducible steps. Expect copy-paste-ready
        commands, annotated configuration, decision frameworks comparing the
        trade-offs of competing tools, and the context you need to choose the
        right approach for your environment rather than a one-size-fits-all
        recipe. The goal is simple: help you ship {category.toLowerCase()} work
        that is correct, secure, and maintainable.
      </p>
      {categoryPosts.length > 0 && (
        <p>
          Recent {category} posts include{" "}
          {categoryPosts.slice(0, 5).map((post, i, arr) => (
            <>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>{i < arr.length - 1 ? ", " : "."}
            </>
          ))}
          {" "}Have a question or a topic you would like covered? {" "}
          <a href="/contact/">Get in touch</a> or connect on the channels linked
          in the site footer.
        </p>
      )}
    </div>

    <main class="mt-16">
      {categoryPosts.length > 0 ? (
        <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-10 lg:gap-16">
          {categoryPosts.map((post, index) => (
            <li>
              <a href={`/blog/${post.slug}/`}>
                <div>
                  {post.data.image?.src && (
                    <Picture
                      src={post.data.image.src}
                      alt={post.data.image.alt}
                      sizes="(max-width: 800px) 100vw, 800px"
                      width={800}
                      height={600}
                      loading={index <= 2 ? "eager" : "lazy"}
                      decoding={index <= 2 ? "sync" : "async"}
                      class="w-full rounded-md object-cover"
                    />
                  )}
                  <div class="mt-4">
                    {post.data.category && (
                      <a href={`/blog/categories/${slugify(post.data.category, { lower: true, strict: true })}/`} class="text-blue-400 uppercase tracking-wider text-xs font-medium hover:underline">
                        {post.data.category}
                      </a>
                    )}
                    <h2 class="text-xl font-semibold leading-snug tracking-tight mt-1">
                      {post.data.title}
                    </h2>
                    <div class="flex gap-2 mt-3 text-sm text-gray-400">
                      <span>{post.data.author}</span>
                      <span>•</span>
                      <time datetime={post.data.publishDate.toISOString()}>
                        {post.data.publishDate.toDateString()}
                      </time>
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="text-center py-12">
          <h2 class="text-xl font-semibold mb-4">No posts found.</h2>
          <p class="text-gray-500">We’re still working on adding content for this category.</p>
        </div>
      )}
    </main>
  </Container>
</Layout>
