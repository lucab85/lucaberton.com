---
/**
 * Calendly post-booking redirect target. Fires the authoritative
 * `booked_call` conversion (booking_start only measures scheduler opens).
 * Deliberately unlinked: set this URL as the confirmation-page redirect on
 * each Calendly event type. Optional ?booking_type=<slug> overrides the
 * default via Calendly's redirect URL settings.
 */
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
---

<Layout
  title="Call booked"
  description="Discovery call confirmed."
  noindex={true}
>
  <Container>
    <div
      class="mx-auto max-w-xl text-center py-24"
      data-page-context
      data-page-type="confirmation"
      data-track-pageview-event="booked_call"
      data-tp-booking-type="discovery_call"
      id="call-booked-context"
    >
      <p class="text-5xl" aria-hidden="true">✅</p>
      <h1 class="mt-6 text-3xl font-bold text-gray-900">Your call is booked</h1>
      <p class="mt-4 text-gray-600 leading-relaxed">
        You'll receive a calendar invite by email. To make the most of the 30
        minutes, have your current architecture and the main blocker you want
        to solve ready to share.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/ai-readiness-assessment/" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">Preview the AI readiness assessment</a>
        <a href="/blog/" class="px-6 py-3 border border-gray-300 hover:bg-gray-50 text-gray-800 font-semibold rounded-lg transition">Read the blog</a>
      </div>
    </div>
  </Container>
</Layout>

<script is:inline>
  // Calendly can append ?booking_type=<slug> to the redirect URL per event type.
  (function () {
    try {
      var type = new URLSearchParams(window.location.search).get('booking_type');
      var el = document.getElementById('call-booked-context');
      if (type && el && /^[a-z0-9_]{1,60}$/.test(type)) {
        el.setAttribute('data-tp-booking-type', type);
      }
    } catch (_) {}
  })();
</script>
