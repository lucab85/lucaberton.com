---
/**
 * Claude Code Doctor: the pack's doctor script as a free, email-gated
 * download. The Claude Code posts send readers here (ProductStrip.astro);
 * the form subscribes them to the newsletter (Kit form 9153490, the same
 * list as everywhere else, tagged by form_id=kit_doctor in GA4) and then
 * shows the download. The paid pack is the upsell at the end.
 */
import { PERSON_REF } from "@utils/entity";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { sales, claudePackLive } from "../data/sales";

export const prerender = true;

const KIT_FORM_ACTION = "https://app.kit.com/forms/9153490/subscriptions";
const FORM_ID = "kit_doctor";
const DOWNLOAD = "/downloads/claude-code-doctor.sh";

const checks = [
  { title: "Install", text: "Is claude on your PATH, and how many copies? Old npm installs shadow the Homebrew cask and the native installer. Node too old or too new, and the macOS quarantine flag." },
  { title: "Authentication", text: "Credential variables (ANTHROPIC_API_KEY, CLAUDE_CODE_OAUTH_TOKEN, Bedrock, Vertex, Foundry) that silently override your Pro, Max or Team subscription." },
  { title: "Network", text: "Proxy and VPN variables, whether api.anthropic.com answers, and which certificate authority signs the connection: a corporate CA means a TLS-inspecting proxy, the usual cause of ECONNRESET." },
  { title: "Settings files", text: "A malformed ~/.claude/settings.json, .claude.json, project settings or .mcp.json can crash every launch. Each one is parsed." },
  { title: "Hooks", text: "Every command hook in your settings is checked: a missing or non-executable hook fails open, and the tool call goes ahead unguarded." },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Claude Code Doctor",
  description: "A read-only shell script that checks the usual causes of Claude Code install, authentication, network and hook problems in one pass.",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, WSL",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: PERSON_REF,
  url: "https://lucaberton.com/claude-code-doctor/",
};
---

<Layout
  title="Claude Code Doctor: Find Why Claude Code Fails"
  description="A free, read-only script that checks the usual causes of Claude Code errors in one run: duplicate installs, Node, credentials, proxies, settings files and hooks."
  image="/products/claude-code-guardrails-pack-cover.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <section class="bg-slate-950 text-white py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-teal-300">Free script</p>
          <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">Find out why Claude Code fails, in one run</h1>
          <p class="mt-6 text-lg text-slate-300">
            ECONNRESET, "subscription disabled", a crash at launch, hooks that never fire: the cause is almost always one of a dozen things. <code class="rounded bg-white/10 px-1.5 py-0.5 text-base">claude-doctor.sh</code> checks all of them and tells you which fix to try first. It reads; it changes nothing.
          </p>

          <form
            id="doctor-form"
            class="mt-8 flex flex-col gap-2 sm:flex-row"
            action={KIT_FORM_ACTION}
            method="post"
            data-track-start-event="email_signup_start"
            data-tp-form-id={FORM_ID}
            data-tp-cta-position="hero"
          >
            <label class="contents">
              <span class="sr-only">Email address</span>
              <input
                type="email"
                name="email_address"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="min-h-12 w-full rounded-xl border border-white/20 bg-white/10 px-4 text-base text-white placeholder-slate-400 focus:border-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-300/30 sm:max-w-xs"
              />
            </label>
            <button
              type="submit"
              class="min-h-12 whitespace-nowrap rounded-xl bg-teal-400 px-6 font-extrabold text-slate-950 transition hover:bg-teal-300"
            >
              Send me the script
            </button>
          </form>
          <p id="doctor-status" class="mt-3 text-sm text-slate-400" role="status">
            You also get my weekly notes on Claude Code and production AI. One click to unsubscribe.
          </p>

          <div id="doctor-download" class="mt-6 hidden rounded-xl border border-teal-400/30 bg-teal-400/10 p-5">
            <p class="font-bold text-teal-200">Here it is. Run it from your project folder:</p>
            <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 p-4 text-sm text-slate-100"><code>curl -fsSLO https://lucaberton.com{DOWNLOAD} &amp;&amp; bash claude-code-doctor.sh</code></pre>
            <a href={DOWNLOAD} download class="mt-4 inline-flex items-center justify-center rounded-lg bg-teal-400 px-5 py-2.5 text-sm font-extrabold text-slate-950 transition hover:bg-teal-300">Download claude-code-doctor.sh</a>
            <p class="mt-3 text-xs text-slate-400">Needs bash, curl and python3. About 130 lines; read it before you run it.</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-white/10 bg-[#0b1620] font-mono text-[12.5px] leading-relaxed shadow-xl">
          <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/[0.03] px-3 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
            <span class="ml-2 text-[11px] text-slate-400">bash claude-code-doctor.sh</span>
          </div>
          <div class="space-y-1 p-4 text-slate-300">
            <p class="text-slate-400">Install</p>
            <p><span class="text-emerald-300">OK</span>    claude 2.1.296 at /opt/homebrew/bin/claude</p>
            <p><span class="text-amber-300">WARN</span>  2 different claude binaries on PATH</p>
            <p class="pl-8 text-slate-400">-&gt; keep one install method</p>
            <p class="mt-2 text-slate-400">Authentication</p>
            <p><span class="text-amber-300">WARN</span>  credential variables set: ANTHROPIC_API_KEY</p>
            <p class="pl-8 text-slate-400">-&gt; these override your subscription login</p>
            <p class="mt-2 text-slate-400">Network</p>
            <p><span class="text-emerald-300">OK</span>    api.anthropic.com reachable (HTTP 403 in 0.21s)</p>
            <p><span class="text-emerald-300">OK</span>    TLS issuer: Google Trust Services</p>
            <p class="mt-2 text-slate-400">Hooks</p>
            <p><span class="text-rose-300">FAIL</span>  PreToolUse: hook not executable: .claude/hooks/deny-rm.sh</p>
            <p class="pl-8 text-slate-400">-&gt; chmod +x .claude/hooks/deny-rm.sh</p>
            <p class="mt-2">1 failure(s), 2 warning(s).</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">What it checks</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {checks.map((c) => (
          <div class="rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900">{c.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{c.text}</p>
          </div>
        ))}
        <div class="rounded-xl border border-dashed border-gray-300 p-6">
          <h3 class="font-bold text-gray-900">Then: claude doctor</h3>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">The script ends by pointing you to Claude Code's own <code>claude doctor</code> for the checks only it can do. The two together cover the errors behind my most-read posts.</p>
        </div>
      </div>
      <p class="mt-8 text-gray-700 max-w-3xl">
        The fixes themselves are free on the blog: <a class="text-blue-600 underline" href="/blog/claude-code-econnreset-fix/">ECONNRESET</a>, <a class="text-blue-600 underline" href="/blog/fix-claude-code-subscription-disabled-copilot-credit-limit/">subscription disabled</a>, <a class="text-blue-600 underline" href="/blog/fix-claude-code-homebrew-macos-node-26-install/">broken Homebrew install</a>, <a class="text-blue-600 underline" href="/blog/claude-code-pretooluse-hooks-policy-guardrails/">hooks that don't fire</a>. The script just finds which one you have.
      </p>
    </Container>
  </section>

  {claudePackLive && (
    <section class="py-16 bg-gray-50">
      <Container>
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-widest text-teal-700">If you want the rest</p>
          <h2 class="mt-2 text-3xl font-extrabold text-gray-900">{sales.claudePack.name}</h2>
          <p class="mt-4 text-gray-700 leading-relaxed">
            The doctor script is one file from the pack. The pack adds four tested hooks with a one-command installer (no rm, no packages published yesterday, no commit before the tests pass, no writes outside the repo), settings presets for you and your team, a CLAUDE.md template and the troubleshooting playbook as a PDF.
          </p>
          <a
            href={sales.claudePack.page}
            data-track-event="consulting_cta_click"
            data-tp-target-offer="claude_code_guardrails_pack"
            data-tp-cta-position="post_conclusion"
            data-tp-cta-variant="doctor_page_upsell"
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-teal-700 px-7 py-4 text-lg font-bold text-white transition-colors hover:bg-teal-600"
          >
            See the pack · {sales.claudePack.price}
          </a>
        </div>
      </Container>
    </section>
  )}
</Layout>

<script is:inline define:vars={{ FORM_ID }}>
  // Subscribe through Kit's form endpoint without leaving the page, then show
  // the download. email_signup is the conversion (same as the inline
  // newsletter card); email_signup_start fires on the first focus through
  // ConversionTracker's data-track-start-event.
  (function () {
    var form = document.getElementById('doctor-form');
    var status = document.getElementById('doctor-status');
    var download = document.getElementById('doctor-download');
    if (!form || !status || !download) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var button = form.querySelector('button');
      button.disabled = true;
      button.textContent = 'One moment...';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json().catch(function () { return {}; }); })
        .then(function () {
          form.style.display = 'none';
          status.className = 'mt-3 text-sm font-semibold text-emerald-300';
          status.textContent = 'Done. Confirm your email when it arrives; the script is below.';
          download.classList.remove('hidden');
          var params = { form_id: FORM_ID };
          if (typeof window.lucaTrack === 'function') window.lucaTrack('email_signup', params);
          else if (typeof window.gtag === 'function') window.gtag('event', 'email_signup', params);
        })
        .catch(function () {
          button.disabled = false;
          button.textContent = 'Send me the script';
          status.className = 'mt-3 text-sm font-semibold text-rose-300';
          status.textContent = 'That did not go through. Check the address and try again.';
        });
    });
  })();
</script>
