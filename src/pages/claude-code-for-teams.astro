---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { sales } from "../data/sales";

export const prerender = true;

const bookingUrl = "https://calendly.com/lucaberton/";

const problems = [
  { title: "Access and authentication", text: "\"Your organization has disabled Claude subscription access\", API keys that override subscriptions, SSO, Bedrock, Vertex or Foundry: one clear authentication plan for every developer." },
  { title: "Managed settings", text: "Organisation-wide settings and permission rules that individual developers can't switch off, rolled out the same way to every laptop." },
  { title: "Policy guardrails", text: "Hooks that stop rm, brand-new packages, untested commits and writes outside the repo, plus deny rules for secrets and credentials." },
  { title: "MCP servers and tools", text: "Which MCP servers and tools the team may use, who owns them, and how to remove one without a code change." },
  { title: "Remote Control and devices", text: "Enabling Remote Control on managed devices, trusted devices and the per-device overrides that catch people out." },
  { title: "Usage and cost", text: "Session and weekly limits, who needs which plan, and how to keep spend predictable as more developers join." },
];

const formats = [
  { name: "Team workshop", length: "Half day, remote", text: "Your team installs and configures Claude Code with the guardrails live, and leaves with working settings, hooks and a CLAUDE.md standard." },
  { name: "Rollout workshop", length: "One day, remote or on site", text: "Authentication, managed settings, MCP policy, device rollout and the team playbook, designed with your platform and security leads." },
  { name: "Rollout review", length: "Async review + 90-minute call", text: "Send your current setup; get a written review of what to change before you roll Claude Code out further." },
];

const deliverables = [
  "Managed settings tailored to your organisation",
  "Policy hooks and permission rules, tested",
  "A CLAUDE.md standard for your repositories",
  "An authentication and access plan",
  "A troubleshooting playbook for your developers",
  "A team licence of the Claude Code Guardrails Pack",
];
---

<Layout
  title="Claude Code for Teams: Rollout Workshops"
  description="Rolling Claude Code out to an engineering team? Workshops on authentication, managed settings, policy hooks, MCP control and device rollout, by Luca Berton."
>
  <section class="bg-slate-950 py-16 text-white lg:py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-widest text-teal-300">Claude Code for teams</p>
        <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl">Roll Claude Code out to your team without the access, policy and cost surprises</h1>
        <p class="mt-6 text-lg text-slate-300">
          One developer can fix their own setup. A team needs one authentication plan, settings nobody can switch off by accident, guardrails on what the agent may run, and clear rules for MCP servers and devices. I run workshops that set this up with your team.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={bookingUrl}
            data-track-event="consulting_cta_click"
            data-tp-target-offer="claude_code_team_workshop"
            data-tp-cta-position="hero"
            data-tp-cta-variant="team_workshop_hero"
            class="inline-flex items-center justify-center rounded-xl bg-teal-400 px-7 py-4 text-lg font-extrabold text-slate-950 transition hover:bg-teal-300"
          >
            Book a free 30-minute call →
          </a>
          <span class="text-sm text-slate-400">Fixed price per team, quoted after the call</span>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">What usually goes wrong at team scale</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {problems.map((p) => (
          <div class="rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{p.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-gray-50 py-16">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">Formats</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {formats.map((f) => (
          <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-teal-700">{f.length}</p>
            <h3 class="mt-2 text-xl font-black text-gray-900">{f.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600">{f.text}</p>
          </div>
        ))}
      </div>
      <h3 class="mt-12 text-xl font-extrabold text-gray-900">Your team leaves with</h3>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {deliverables.map((d) => <li class="flex gap-2 text-gray-700"><span class="text-teal-600">✓</span>{d}</li>)}
      </ul>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="flex flex-col gap-6 rounded-2xl bg-slate-950 p-8 text-white sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-2xl font-black">Tell me about your rollout</p>
          <p class="mt-2 text-slate-300">How many developers, which plan, where you're stuck. I'll tell you which format fits and what it costs.</p>
        </div>
        <a
          href={bookingUrl}
          data-track-event="consulting_cta_click"
          data-tp-target-offer="claude_code_team_workshop"
          data-tp-cta-position="post_conclusion"
          data-tp-cta-variant="team_workshop_footer"
          class="inline-flex flex-shrink-0 items-center justify-center rounded-xl bg-teal-400 px-7 py-4 font-extrabold text-slate-950 transition hover:bg-teal-300"
        >
          Book a free call →
        </a>
      </div>
      <p class="mt-6 text-sm text-gray-500">
        Just one developer? The <a class="text-blue-600 underline" href={sales.claudePack.page}>Claude Code Guardrails Pack</a> has the hooks, settings and playbook ready to install. Independent consulting, not affiliated with Anthropic.
      </p>
    </Container>
  </section>
</Layout>
