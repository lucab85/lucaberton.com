---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { sales, claudePackLive } from "../data/sales";

export const prerender = true;

const { checkoutUrl, price, name, currency } = sales.claudePack;
const priceValue = price.replace(/[^0-9.]/g, "");

const inside = [
  { title: "Four tested hooks", text: "No rm (use trash), no packages first published less than 30 days ago, no git commit before pytest passes, no writes outside the repository. Each denial tells Claude what to do instead." },
  { title: "One-command install", text: "install.sh copies the hooks into your repo and merges the wiring into .claude/settings.json. It backs up your file and never duplicates entries." },
  { title: "Settings presets", text: "Deny reads of .env, secrets/, ~/.ssh and ~/.aws; ask before git push, terraform apply and kubectl delete. Plus a managed-settings file to roll the rules out to a whole team." },
  { title: "CLAUDE.md template", text: "A short instructions file: ask before guessing, minimum code, surgical changes, verified goals, and the hook rules written so the agent follows them." },
  { title: "Doctor script", text: "A read-only check of duplicate installs, Node version, credential variables that override your subscription, proxies, TLS, broken settings files and missing hooks." },
  { title: "Troubleshooting playbook (PDF)", text: "ECONNRESET, stalled streams, crash loops, disabled subscription access, Homebrew conflicts, hooks that don't fire and usage limits, with the fixes in the order to try them." },
];

const faqs = [
  { q: "Isn't the hook code on your blog already?", a: "Yes, the four rules are explained in my post on PreToolUse hooks, and that stays free. The pack adds what you'd otherwise build yourself: the installer, 18 tests, the settings and team presets, the CLAUDE.md template, the doctor script and the playbook." },
  { q: "Does it work in a real Claude Code session?", a: "Yes. Besides the tests, it was installed in a fresh repository and Claude Code 2.1.296 was asked to run rm -rf build. The hook denied the call, Claude read the reason and offered to use trash instead, and the files were untouched." },
  { q: "What do I need?", a: "Claude Code, Python 3 and jq. macOS, Linux or WSL. The test gate expects pytest; for other test runners you change one function." },
  { q: "Is it a security boundary?", a: "No, and the README says so. Hooks steer a cooperative agent; they don't catch every way to delete a file. For hard limits, combine them with the permission deny rules (included), managed settings and Claude Code's sandbox." },
  { q: "Is this an official Anthropic product?", a: "No. It's an independent pack by Luca Berton, not affiliated with or endorsed by Anthropic. Claude and Claude Code are trademarks of Anthropic." },
];

const productSchema = claudePackLive ? {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description: "Tested Claude Code hooks, installer, settings presets, CLAUDE.md template, doctor script and troubleshooting playbook.",
  image: "https://lucaberton.com/products/claude-code-guardrails-pack-cover.png",
  brand: { "@type": "Person", name: "Luca Berton" },
  offers: { "@type": "Offer", price: priceValue, priceCurrency: currency, availability: "https://schema.org/InStock", url: "https://lucaberton.com/claude-code-guardrails-pack/" },
} : null;
---

<Layout
  title={`${name}: Hooks, Settings and Fixes`}
  description="Tested Claude Code hooks with a one-command installer, settings presets, a CLAUDE.md template, a doctor script and a troubleshooting playbook."
  image="/products/claude-code-guardrails-pack-cover.png"
  noindex={!claudePackLive}
>
  {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}

  <section class="bg-slate-950 text-white py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-teal-300">{name}</p>
          <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">Guardrails for Claude Code, ready to install</h1>
          <p class="mt-6 text-lg text-slate-300">
            The hooks and settings I use so Claude Code doesn't delete files, install a package published yesterday, commit untested code or write outside the repo. Plus the fixes for the errors people search for most.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 sm:items-center">
            {claudePackLive ? (
              <a
                href={checkoutUrl}
                data-track-event="consulting_cta_click"
                data-tp-target-offer="claude_code_guardrails_pack"
                data-tp-cta-position="hero"
                data-tp-cta-variant="claude_pack_checkout_hero"
                class="inline-flex items-center justify-center px-7 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 text-lg font-bold rounded-xl transition-colors"
              >
                Buy the pack · {price}
              </a>
            ) : (
              <span class="inline-flex items-center justify-center px-7 py-4 bg-slate-700 text-slate-300 text-lg font-bold rounded-xl">Available soon</span>
            )}
            <span class="text-sm text-slate-400">Instant download · VAT handled at checkout</span>
          </div>
        </div>
        <img src="/products/claude-code-guardrails-pack-cover.png" alt={`${name} cover`} width="1600" height="900" class="w-full rounded-2xl shadow-2xl" />
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">What's inside</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {inside.map((item) => (
          <div class="rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-gray-700 max-w-3xl">
        The reasoning behind each rule is free in <a class="text-blue-600 underline" href="/blog/claude-code-pretooluse-hooks-policy-guardrails/">Claude Code PreToolUse hooks: policy guardrails</a>. To learn the day-to-day workflow, see my <a class="text-blue-600 underline" href="https://www.udemy.com/course/claude-code-masterclass-ai-coding/" target="_blank" rel="noopener">Claude Code Masterclass on Udemy</a>.
      </p>
    </Container>
  </section>

  <section class="py-16 bg-gray-50">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">Questions</h2>
      <div class="mt-6 divide-y divide-gray-200 max-w-3xl">
        {faqs.map((f) => (
          <details class="py-4">
            <summary class="cursor-pointer font-semibold text-gray-900">{f.q}</summary>
            <p class="mt-2 text-gray-700">{f.a}</p>
          </details>
        ))}
      </div>
      {claudePackLive && (
        <a
          href={checkoutUrl}
          data-track-event="consulting_cta_click"
          data-tp-target-offer="claude_code_guardrails_pack"
          data-tp-cta-position="post_conclusion"
          data-tp-cta-variant="claude_pack_checkout_footer"
          class="mt-10 inline-flex items-center justify-center px-7 py-4 bg-teal-700 hover:bg-teal-600 text-white text-lg font-bold rounded-xl transition-colors"
        >
          Buy the pack · {price}
        </a>
      )}
    </Container>
  </section>
</Layout>
