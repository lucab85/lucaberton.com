---
import { PERSON_REF } from "@utils/entity";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { claudeCodeTeamKit, planLive, planHref, formatEur } from "../../data/claudeCodeTeamKit";
import { claudeCodeTeams } from "../../data/claudeCodeTeams";

export const prerender = true;

// Payment Link URLs: src/data/claudeCodeTeamKit.ts (INDIVIDUAL_PAYMENT_LINK_URL,
// TEAM_PAYMENT_LINK_URL). Empty = "Request access" to /contact/, no Offer.
const { name, page, plans } = claudeCodeTeamKit;
const individual = plans.individual;
const team = plans.team;
const individualLive = planLive(individual);
const teamLive = planLive(team);
const individualHref = planHref(individual);
const teamHref = planHref(team);
const individualLabel = individualLive ? `Buy Individual · ${formatEur(individual.price)}` : "Request access";
const teamLabel = teamLive ? `Buy Team · ${formatEur(team.price)}` : "Request access";

const ebookUrl = "https://leanpub.com/claude-code/c/lucaberton";

const pains = [
  {
    quote: "“Your organization has disabled Claude subscription access”",
    text: "Developers hit policy errors nobody planned for, because authentication, plans and admin settings were never decided for the whole team.",
    link: { href: "/blog/fix-claude-code-subscription-disabled-copilot-credit-limit/", label: "Read the fix" },
  },
  {
    quote: "rm -rf, a package published yesterday, a write outside the repo",
    text: "The agent runs what it is allowed to run. Without hooks and deny rules, one bad command or one leaked secret is a matter of time.",
    link: { href: "/blog/claude-code-pretooluse-hooks-policy-guardrails/", label: "How hooks help" },
  },
  {
    quote: "Every repo has a different CLAUDE.md (or none)",
    text: "Each developer writes their own instructions, so the agent behaves differently in every repository and nobody owns the standard.",
    link: { href: "/blog/karpathy-claude-md-llm-coding-principles-2026/", label: "What a good one says" },
  },
];

const parts = [
  {
    eyebrow: "Guardrails",
    title: "Hooks and permission deny rules",
    text: "Hooks that block the commands that hurt: rm -rf, writes outside the repository, new packages nobody reviewed, and secrets. Deny rules keep credentials and secret files out of reach.",
    items: ["Block rm -rf", "Block writes outside the repo", "Block unreviewed new packages", "Keep secrets out"],
  },
  {
    eyebrow: "Organisation rollout",
    title: "Managed-settings guide and example",
    text: "How to roll Claude Code out to every laptop with managed settings, plus a worked example file to start from.",
    items: ["Authentication plan", "Settings developers can't override", "MCP server allowlist", "Device policy", "Usage limits"],
  },
  {
    eyebrow: "Standards",
    title: "CLAUDE.md templates",
    text: "Three starting points, so every repository gives the agent the same rules and your team owns one standard.",
    items: ["Single repository", "Team standard", "Monorepo"],
  },
];

const skills = [
  { title: "llms.txt generator and auditor", text: "Create an llms.txt for a site or docs project and check an existing one." },
  { title: "Static Next.js → Vercel", text: "Take a static Next.js site and deploy it to Vercel." },
  { title: "Project zip → repo → deploy", text: "Turn a zipped project into a Git repository and ship it." },
  { title: "Conference talk deck builder", text: "Go from a talk outline to a slide deck." },
  { title: "Burned-in video captions", text: "Add captions that are part of the video, for social clips." },
  { title: "SEO audit with Google Search Console", text: "Audit a site against its own Search Console data." },
];

const steps = [
  { title: "Pay", text: "Choose Individual or Team and pay with Stripe. VAT may apply at checkout." },
  { title: "Enter your GitHub username", text: "At checkout, type the GitHub username that should get access to the private repository." },
  { title: "Accept the invite, then git pull", text: "You get a read-only invitation to the private repo within 24 hours. Clone it; when the kit is updated, git pull." },
];

const faqs = [
  {
    q: "What does the licence allow?",
    a: `Individual covers one developer. Team covers up to 10 developers in one organisation. Use and adapt the files in your own repositories and your organisation's managed settings. Please don't republish or resell the kit. More than 10 developers? <a class="text-blue-600 underline" href="/contact/?topic=claude-code-team-kit">Contact me</a>.`,
  },
  {
    q: "Who gets access to the repository?",
    a: "The GitHub account whose username you enter at checkout gets a read-only invitation to the private repository. Updates arrive with git pull. Entered the wrong username, or need a different account added? Contact me.",
  },
  {
    q: "I don't have a GitHub account. Can I still buy it?",
    a: `Delivery is through a private GitHub repository, so you need a GitHub account. If that doesn't work for you, <a class="text-blue-600 underline" href="/contact/?topic=claude-code-team-kit">contact me</a> before you buy.`,
  },
  {
    q: "Can I get a refund?",
    a: `If something isn't right, <a class="text-blue-600 underline" href="/contact/?topic=claude-code-team-kit">contact me</a> and tell me what happened.`,
  },
  {
    q: "How is this different from the Claude Code for Teams workshop?",
    a: `The kit is self-serve: you get the files and roll them out yourself. The <a class="text-blue-600 underline" href="/claude-code-for-teams/">Claude Code for Teams workshop</a> is a day with me, live: ${claudeCodeTeams.seatPrice} for a seat in a public session, or ${claudeCodeTeams.cohortPrice} for a company cohort of up to ${claudeCodeTeams.cohortSize} developers, with the setup adapted to your organisation.`,
  },
  {
    q: "How is this different from the Claude Code Masterclass ebook?",
    a: `The <a class="text-blue-600 underline" href="${ebookUrl}" target="_blank" rel="noopener">Claude Code Masterclass ebook</a> teaches how to work with Claude Code, step by step. The kit is ready-to-use files for a team: hooks, settings, templates and skills you copy into your repositories.`,
  },
  {
    q: "How is this different from the Claude Code Guardrails Pack?",
    a: `The <a class="text-blue-600 underline" href="/claude-code-guardrails-pack/">Guardrails Pack</a> is a one-time download for one developer's machine, with an installer, a doctor script and a troubleshooting playbook. The Team Kit is for rolling Claude Code out across a team: managed settings, CLAUDE.md templates and skills, in a private repository that gets updates.`,
  },
  {
    q: "Is this an official Anthropic product?",
    a: "No. It's an independent kit by Luca Berton, not affiliated with or endorsed by Anthropic. Claude and Claude Code are trademarks of Anthropic.",
  },
];

const offers = [individual, team]
  .filter((plan) => planLive(plan))
  .map((plan) => ({
    "@type": "Offer",
    name: `${name}, ${plan.name}`,
    price: String(plan.price),
    priceCurrency: claudeCodeTeamKit.currency,
    availability: "https://schema.org/InStock",
    url: `https://lucaberton.com${page}`,
  }));

const productSchema = offers.length
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name,
      description: "Guardrail hooks, permission deny rules, a managed-settings rollout guide, CLAUDE.md templates and six ready-to-use skills for teams adopting Claude Code.",
      brand: PERSON_REF,
      offers,
    }
  : null;

const btnPrimary = "inline-flex min-h-12 items-center justify-center rounded-xl bg-teal-400 px-6 py-3 text-base font-extrabold text-slate-950 transition hover:bg-teal-300";
const btnSecondaryDark = "inline-flex min-h-12 items-center justify-center rounded-xl border border-white/25 px-6 py-3 text-base font-bold text-white transition hover:border-white/60 hover:bg-white/5";
---

<Layout
  title={`${name}: Guardrails, Settings, Skills`}
  description="Guardrail hooks, deny rules, a managed-settings rollout guide, CLAUDE.md templates and 6 skills for teams adopting Claude Code. Private repo, updates included."
  quietOffers={true}
>
  {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}

  <div data-team-kit-page>
    <section class="bg-slate-950 py-12 text-white sm:py-16 lg:py-24">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
          <div>
            <p class="text-sm font-bold uppercase tracking-widest text-teal-300">{name}</p>
            <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl">Roll Claude Code out to your team with guardrails from day one</h1>
            <p class="mt-6 text-lg text-slate-300">
              For teams adopting Claude Code: the hooks, deny rules, managed settings, CLAUDE.md templates and skills a team needs on day one, ready to copy. In a private GitHub repository you clone once and update with <code class="rounded bg-white/10 px-1.5 py-0.5 text-base text-teal-200">git pull</code>.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={teamHref}
                data-track-event="offer_click"
                data-tp-offer="team-kit-team"
                data-tp-placement="hero"
                data-team-kit-buy="team"
                class={btnPrimary}
              >
                {teamLive ? teamLabel : `${teamLabel} · Team`}
              </a>
              <a
                href={individualHref}
                data-track-event="offer_click"
                data-tp-offer="team-kit-individual"
                data-tp-placement="hero"
                data-team-kit-buy="individual"
                class={btnSecondaryDark}
              >
                {individualLive ? individualLabel : `${individualLabel} · Individual`}
              </a>
            </div>
            <p class="mt-4 text-sm text-slate-400">Team {formatEur(team.price)} for up to 10 developers · Individual {formatEur(individual.price)} · updates included · VAT may apply at checkout</p>
          </div>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900 shadow-2xl" aria-label="What the private repository contains">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-red-400/80" aria-hidden="true"></span>
              <span class="h-3 w-3 rounded-full bg-amber-300/80" aria-hidden="true"></span>
              <span class="h-3 w-3 rounded-full bg-teal-400/80" aria-hidden="true"></span>
              <span class="ml-2 font-mono text-xs text-slate-400">private repo · read-only access</span>
            </div>
            <ul class="space-y-3 p-6 font-mono text-sm">
              <li class="flex gap-3"><span class="text-teal-300" aria-hidden="true">✓</span><span><span class="text-white">Guardrail hooks</span> <span class="text-slate-400">+ permission deny rules</span></span></li>
              <li class="flex gap-3"><span class="text-teal-300" aria-hidden="true">✓</span><span><span class="text-white">Managed settings</span> <span class="text-slate-400">guide + example for org rollout</span></span></li>
              <li class="flex gap-3"><span class="text-teal-300" aria-hidden="true">✓</span><span><span class="text-white">CLAUDE.md templates</span> <span class="text-slate-400">repo · team · monorepo</span></span></li>
              <li class="flex gap-3"><span class="text-teal-300" aria-hidden="true">✓</span><span><span class="text-white">6 skills</span> <span class="text-slate-400">ready to use</span></span></li>
              <li class="mt-5 border-t border-white/10 pt-4 text-slate-400"><span class="text-teal-300">$</span> git pull <span class="text-slate-500"># updates included</span></li>
            </ul>
          </div>
        </div>
      </Container>
    </section>

    <section class="py-16">
      <Container>
        <h2 class="text-3xl font-extrabold text-gray-900">Sound familiar?</h2>
        <p class="mt-3 max-w-3xl text-gray-600">These are the problems behind the most-read Claude Code posts on this site. They show up as soon as more than one developer uses the agent.</p>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {pains.map((p) => (
            <div class="flex flex-col rounded-xl border border-gray-200 p-6">
              <p class="font-bold text-gray-900">{p.quote}</p>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600">{p.text}</p>
              <a class="mt-4 text-sm font-semibold text-blue-600 underline" href={p.link.href}>{p.link.label} →</a>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="bg-gray-50 py-16" id="inside">
      <Container>
        <h2 class="text-3xl font-extrabold text-gray-900">What's inside</h2>
        <p class="mt-3 max-w-3xl text-gray-600">Four parts, each usable on its own. Copy what you need into your repositories and your managed settings.</p>
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {parts.map((part) => (
            <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <p class="text-xs font-bold uppercase tracking-wider text-teal-700">{part.eyebrow}</p>
              <h3 class="mt-2 text-xl font-black text-gray-900">{part.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{part.text}</p>
              <ul class="mt-4 space-y-1.5">
                {part.items.map((item) => <li class="flex gap-2 text-sm text-gray-700"><span class="text-teal-600" aria-hidden="true">✓</span>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-teal-700">Skills</p>
          <h3 class="mt-2 text-xl font-black text-gray-900">6 ready-to-use skills</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">Drop them into your skills folder and ask Claude Code for the task. Some use services you already have, such as Vercel or Google Search Console.</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {skills.map((s) => (
              <div class="rounded-xl bg-gray-50 p-4">
                <h4 class="font-bold text-gray-900">{s.title}</h4>
                <p class="mt-1 text-sm text-gray-600">{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <section class="py-16">
      <Container>
        <h2 class="text-3xl font-extrabold text-gray-900">How delivery works</h2>
        <ol class="mt-8 grid gap-6 md:grid-cols-3">
          {steps.map((s, i) => (
            <li class="rounded-xl border border-gray-200 p-6">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-950 font-black text-teal-300">{i + 1}</span>
              <h3 class="mt-4 font-bold text-gray-900">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{s.text}</p>
            </li>
          ))}
        </ol>
      </Container>
    </section>

    <section class="bg-gray-50 py-16" id="pricing">
      <Container>
        <h2 class="text-3xl font-extrabold text-gray-900">Pricing</h2>
        <p class="mt-3 max-w-3xl text-gray-600">One payment, the same kit in both plans. Prices in euros; VAT may apply at checkout.</p>
        <div class="mt-8 grid max-w-4xl gap-6 md:grid-cols-2">
          <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-teal-700">{individual.seats}</p>
            <h3 class="mt-2 text-xl font-black text-gray-900">{individual.name}</h3>
            <p class="mt-2 text-4xl font-black text-gray-900">{formatEur(individual.price)}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-gray-700">
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>The full kit: hooks, deny rules, managed settings, CLAUDE.md templates, 6 skills</li>
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>Private repo access for your GitHub account</li>
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>Updates included, via git pull</li>
            </ul>
            <a
              href={individualHref}
              data-track-event="offer_click"
              data-tp-offer="team-kit-individual"
              data-tp-placement="inline"
              data-team-kit-buy="individual"
              class="mt-6 inline-flex min-h-12 items-center justify-center rounded-xl bg-slate-950 px-6 py-3 font-extrabold text-white transition hover:bg-slate-800"
            >
              {individualLabel}
            </a>
          </div>
          <div class="relative order-first flex flex-col rounded-2xl border-2 border-teal-500 bg-white p-6 shadow-md md:order-none">
            <span class="absolute -top-3 right-6 rounded-full bg-teal-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-950">For teams</span>
            <p class="text-xs font-bold uppercase tracking-wider text-teal-700">{team.seats}</p>
            <h3 class="mt-2 text-xl font-black text-gray-900">{team.name}</h3>
            <p class="mt-2 text-4xl font-black text-gray-900">{formatEur(team.price)}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-gray-700">
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>The full kit, licensed for up to 10 developers in one organisation</li>
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>Roll it out with managed settings across your organisation</li>
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>Private repo access for the GitHub account you enter</li>
              <li class="flex gap-2"><span class="text-teal-600" aria-hidden="true">✓</span>Updates included, via git pull</li>
            </ul>
            <a
              href={teamHref}
              data-track-event="offer_click"
              data-tp-offer="team-kit-team"
              data-tp-placement="inline"
              data-team-kit-buy="team"
              class="mt-6 inline-flex min-h-12 items-center justify-center rounded-xl bg-teal-400 px-6 py-3 font-extrabold text-slate-950 transition hover:bg-teal-300"
            >
              {teamLabel}
            </a>
          </div>
        </div>
        {!(individualLive && teamLive) && (
          <p class="mt-6 max-w-3xl text-sm text-gray-500">Checkout opens soon. Until then, "Request access" takes you to the contact page and I'll reply with the next step.</p>
        )}
      </Container>
    </section>

    <section class="py-16">
      <Container>
        <h2 class="text-3xl font-extrabold text-gray-900">Questions</h2>
        <div class="mt-6 max-w-3xl divide-y divide-gray-200">
          {faqs.map((f) => (
            <details class="py-4">
              <summary class="cursor-pointer font-semibold text-gray-900">{f.q}</summary>
              <p class="mt-2 text-gray-700" set:html={f.a} />
            </details>
          ))}
        </div>
      </Container>
    </section>

    <section class="pb-16">
      <Container>
        <div class="flex flex-col gap-6 rounded-2xl bg-slate-950 p-8 text-white lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-2xl font-black">Give your team the same guardrails tomorrow</p>
            <p class="mt-2 max-w-2xl text-slate-300">Hooks, managed settings, CLAUDE.md templates and 6 skills in one private repository. Team {formatEur(team.price)} for up to 10 developers, Individual {formatEur(individual.price)}.</p>
          </div>
          <div class="flex flex-shrink-0 flex-col gap-3 sm:flex-row">
            <a
              href={teamHref}
              data-track-event="offer_click"
              data-tp-offer="team-kit-team"
              data-tp-placement="post_conclusion"
              data-team-kit-buy="team"
              class={btnPrimary}
            >
              {teamLive ? teamLabel : `${teamLabel} · Team`}
            </a>
            <a
              href={individualHref}
              data-track-event="offer_click"
              data-tp-offer="team-kit-individual"
              data-tp-placement="post_conclusion"
              data-team-kit-buy="individual"
              class={btnSecondaryDark}
            >
              {individualLive ? individualLabel : `${individualLabel} · Individual`}
            </a>
          </div>
        </div>
        <p class="mt-6 text-sm text-gray-500" data-team-kit-independent>
          {name} is an independent product by Luca Berton, not affiliated with or endorsed by Anthropic. Claude and Claude Code are trademarks of Anthropic.
        </p>
      </Container>
    </section>
  </div>
</Layout>
