---
/**
 * Stripe Payment Link "After payment" redirect target for the Claude Code
 * Team Kit (set it on both links, see src/data/claudeCodeTeamKit.ts). Fires
 * kit_checkout_complete once per session. No value: the payment itself is
 * recorded in Stripe. Noindex and kept out of the sitemap (astro.config.mjs).
 */
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { claudeCodeTeamKit } from "../../data/claudeCodeTeamKit";
---

<Layout
  title="Claude Code Team Kit: payment received"
  description="Payment received for the Claude Code Team Kit. Your GitHub invitation to the private repository arrives within one business day."
  noindex={true}
  quietOffers={true}
>
  <Container>
    <div
      class="mx-auto max-w-xl py-24 text-center"
      data-page-context
      data-page-type="confirmation"
      data-track-pageview-event="kit_checkout_complete"
    >
      <p class="text-sm font-bold uppercase tracking-widest text-teal-700">{claudeCodeTeamKit.name}</p>
      <h1 class="mt-4 text-3xl font-black text-gray-900 sm:text-4xl">Payment received</h1>
      <p class="mt-6 leading-relaxed text-gray-700">
        You'll get a GitHub invitation to the private repository within one business day. Check the email address of your GitHub account and{" "}
        <a class="text-blue-600 underline" href="https://github.com/notifications" target="_blank" rel="noopener">github.com/notifications</a>.
      </p>
      <p class="mt-4 leading-relaxed text-gray-700">
        Once you've accepted it, clone the repository. Updates arrive with <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm">git pull</code>.
      </p>
      <p class="mt-8 rounded-xl border border-gray-200 bg-gray-50 p-5 text-gray-700">
        Nothing yet after one business day? <a class="font-semibold text-blue-600 underline" href="/contact/?topic=claude-code-team-kit">Contact me</a> with the GitHub username you entered at checkout.
      </p>
      <p class="mt-8 text-sm text-gray-500">
        Back to the <a class="underline" href={claudeCodeTeamKit.page}>{claudeCodeTeamKit.name}</a> page.
      </p>
    </div>
  </Container>
</Layout>
