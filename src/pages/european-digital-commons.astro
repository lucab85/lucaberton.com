---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";

export const prerender = true;
export const lastModified = '2026-09-03';
const title = "Engineering European Digital Commons for Production";
const description = "How I help open-source projects and public-sector organisations turn European digital commons into reproducible, production-ready infrastructure — deployment automation, CI/CD, security baselines, and operational runbooks.";
---

<Layout title={title} description={description}>
  <Breadcrumb items={[{ name: "European Digital Commons" }]} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 py-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="chip bg-blue-950/60 text-blue-300 border border-blue-400/30">
          <span class="chip-dot"></span>
          Digital Commons · Open Source · Public Sector
        </span>
        <h1 class="mt-4 text-3xl md:text-4xl font-bold text-white leading-tight">
          Engineering <span class="text-brand">European Digital Commons</span> for Production
        </h1>
        <p class="text-slate-400 mt-4 text-lg">
          Open Source. Reproducible Infrastructure. Digital Sovereignty.
        </p>
        <p class="text-slate-300 mt-6 text-lg leading-relaxed">
          I help open-source projects and public-sector organisations turn digital commons into
          infrastructure that can be deployed, operated, secured, and maintained reliably at scale.
          The focus is on making open technologies practical in production through platform
          engineering, automation, documentation, and knowledge transfer.
        </p>
      </div>
    </Container>
  </section>

  <!-- Direct Answer Box -->
  <section class="py-10 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <div class="bg-slate-50 border-l-4 border-blue-600 rounded-r-lg p-6">
          <p class="text-gray-800 leading-relaxed">
            <strong>An independent contribution to European Digital Commons initiatives</strong> — I
            help public-sector organisations and open-source projects make their software easy to
            deploy, operate, and maintain independently, so that a Digital Common is genuinely
            reproducible: the same documented, automated, auditable process can be used by different
            public administrations, institutions, and organisations. Luca Berton, Platform
            Engineering &amp; Automation specialist (former Red Hat, Docker Captain), based in
            Amsterdam. <a href="/contact/" class="text-blue-700 underline">Get in touch</a> to
            contribute to a Digital Commons engineering effort.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why this matters -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Why Digital Commons must be reproducible</h2>
        <p class="text-gray-600 mb-6">
          Europe's digital sovereignty depends not only on creating strong open-source software, but
          also on making that software easy to deploy and operate independently. A Digital Common
          should be reproducible — it should be possible for different public administrations,
          institutions, and organisations to deploy the same solution using documented, automated,
          and auditable processes. That is where this work starts.
        </p>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-3">
            <span class="shrink-0 w-6 h-6 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-xs">✓</span>
            The same artefacts deploy across dev, staging, and production without manual drift.
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-6 h-6 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-xs">✓</span>
            New adopters can stand up a working instance from a single, documented automation run.
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-6 h-6 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-xs">✓</span>
            Every environment change is traceable and auditable, not buried in undocumented tribal knowledge.
          </li>
        </ul>
      </div>
    </Container>
  </section>

  <!-- What I contribute -->
  <section class="py-16 bg-slate-50">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">What I can contribute</h2>
        <p class="text-gray-500 mb-8">
          A focused engineering effort designed to make an existing European Digital Commons project
          production-ready and easier to adopt across organisations. The goal is a reusable reference
          implementation covering the complete operational lifecycle.
        </p>

        <div class="space-y-8">
          <!-- Deployment Automation -->
          <div>
            <h3 class="font-bold text-gray-900 mb-2">Reproducible Deployment &amp; Operations Blueprint</h3>
            <p class="text-sm text-gray-600 mb-3">Build repeatable deployment workflows that remove manual installation procedures.</p>
            <ul class="grid md:grid-cols-2 gap-2 text-sm text-gray-700">
              <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Kubernetes &amp; OpenShift</li>
              <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Ansible automation</li>
              <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Infrastructure as Code</li>
              <li class="flex items-center gap-2"><span class="text-green-600">✓</span> GitOps workflows</li>
              <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Automated configuration management</li>
            </ul>
          </div>

          <!-- CI/CD and Validation -->
          <div>
            <h3 class="font-bold text-gray-900 mb-2">CI/CD and Validation</h3>
            <p class="text-sm text-gray-600 mb-3">A Digital Common should be continuously testable, not dependent on undocumented operational knowledge.</p>
            <div class="grid md:grid-cols-2 gap-3">
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">deployment validation</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">infrastructure testing</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">configuration testing</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">release verification</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">upgrade testing</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-sm text-gray-700">rollback validation</div>
            </div>
          </div>

          <!-- Security and Production Readiness -->
          <div>
            <h3 class="font-bold text-gray-900 mb-2">Security and Production Readiness</h3>
            <p class="text-sm text-gray-600 mb-3">
              Practical baseline that can also support preparation for European regulatory requirements such as the
              Cyber Resilience Act.
            </p>
            <ul class="grid md:grid-cols-2 gap-2 text-sm text-gray-700">
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Container &amp; dependency security</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Software supply-chain controls</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Vulnerability management</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Secrets management</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Least-privilege configuration</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Backup &amp; recovery</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Resilience &amp; auditability</li>
              <li class="flex items-center gap-2"><span class="text-blue-600">›</span> Security documentation</li>
            </ul>
          </div>

          <!-- Observability and Operations -->
          <div>
            <h3 class="font-bold text-gray-900 mb-2">Observability and Operations</h3>
            <p class="text-sm text-gray-600 mb-3">A deployable system also needs to be operable — with an operational runbook teams actually use.</p>
            <div class="grid md:grid-cols-3 gap-2 text-sm">
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">metrics</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">logging</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">alerting</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">health checks</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">dashboards</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">backup procedures</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">disaster-recovery guidance</div>
              <div class="bg-white border border-gray-200 rounded-lg p-3 text-gray-700">upgrade &amp; rollback procedures</div>
            </div>
          </div>

          <!-- Knowledge Transfer -->
          <div>
            <h3 class="font-bold text-gray-900 mb-2">Knowledge Transfer</h3>
            <p class="text-sm text-gray-600 mb-3">
              Avoiding vendor lock-in requires more than publishing source code — the people operating the technology need to understand it.
            </p>
            <ul class="grid md:grid-cols-2 gap-2 text-sm text-gray-700">
              <li>✓ Technical documentation</li>
              <li>✓ Architecture guides</li>
              <li>✓ Workshops &amp; hands-on labs</li>
              <li>✓ Deployment tutorials</li>
              <li>✓ Operational runbooks</li>
              <li>✓ Public-sector enablement</li>
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Expected Deliverables -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Expected Open-Source Deliverables</h2>
        <p class="text-gray-500 mb-8">
          A reusable package, all designed to remain open, reusable, and adaptable by the wider European community.
        </p>
        <div class="grid md:grid-cols-2 gap-3">
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">reference architecture</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">automated deployment</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">Infrastructure as Code</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">Ansible automation</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">CI/CD pipelines</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">security baseline</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">observability configuration</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">upgrade &amp; rollback procedures</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">operations runbook</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">architecture documentation</div>
          <div class="bg-slate-50 border border-gray-200 rounded-lg p-4 text-sm text-gray-700">administrator training material</div>
        </div>
      </div>
    </Container>
  </section>

  <!-- About -->
  <section class="py-16 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <h2 class="text-2xl font-bold text-white mb-4">About Luca Berton</h2>
        <p class="text-slate-300 mb-4">
          Independent Platform Engineering, Cloud Native, Automation, and Open Source specialist based in Amsterdam. My work focuses on helping engineering organisations build infrastructure that is reproducible, maintainable, secure, and understandable by the teams that operate it.
        </p>
        <ul class="grid md:grid-cols-2 gap-2 text-slate-300 text-sm">
          <li>✓ Kubernetes &amp; Red Hat OpenShift</li>
          <li>✓ Ansible</li>
          <li>✓ Infrastructure as Code</li>
          <li>✓ CI/CD</li>
          <li>✓ Cloud Native infrastructure</li>
          <li>✓ DevSecOps</li>
          <li>✓ Observability</li>
          <li>✓ Platform Engineering</li>
          <li>✓ AI infrastructure</li>
          <li>✓ Technical education</li>
        </ul>
        <div class="mt-8">
          <a href="/contact/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-all hover:scale-105 active:scale-95 cursor-pointer">Contribute to a Digital Commons project</a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
