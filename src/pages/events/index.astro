---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import EventPostList from "@components/EventPostList.astro";
import { getEventPosts, topicHubs, companyHubs } from "@utils/eventGraph";
import { eventTopics } from "@utils/eventTopics";

const posts = await getEventPosts();
const topics = [...(await topicHubs())].sort((a, b) => b[1].length - a[1].length);
const companies = [...(await companyHubs())];
const events = new Set(posts.map((p) => p.data.event.name));
const cities = new Set(posts.map((p) => p.data.event.city).filter(Boolean));
const countries = new Set(posts.map((p) => p.data.event.country).filter(Boolean));

const title = `Tech events: ${posts.length} conference and meetup write-ups`;
const description = `Notes from ${events.size} tech conferences and meetups in ${countries.size} countries, organised by topic and company: AI, Kubernetes, platform engineering and more.`.slice(0, 160);
const url = "https://lucaberton.com/events/";
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": url,
  name: title,
  description,
  url,
  isPartOf: { "@type": "WebSite", "@id": "https://lucaberton.com/#website" },
  hasPart: topics.map(([s]) => ({ "@type": "CollectionPage", url: `https://lucaberton.com/events/topics/${s}/`, name: eventTopics[s].label })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Breadcrumb items={[{ name: "Events" }]} />
  <Container>
    <div class="mx-auto max-w-3xl">
      <h1 class="mt-12 text-4xl font-extrabold tracking-tight text-gray-900">Notes from the event floor</h1>
      <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
        {posts.length} write-ups · {events.size} events · {cities.size} cities · {countries.size} countries
      </p>
      <p class="mt-6 text-lg leading-8 text-gray-700">
        I write up the conferences and meetups I go to: the talks worth remembering, the demos,
        the booth conversations and what I took away for my own work. This page organises all of
        them by topic and by company. For my speaking calendar, see <a href="/conferences/" class="font-semibold text-blue-600 hover:underline">conferences</a>.
      </p>

      <section id="topics" class="mt-12">
        <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 border-b border-gray-100 pb-2">By topic</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {topics.map(([s, ps]) => (
            <li>
              <a href={`/events/topics/${s}/`} class="flex items-baseline justify-between rounded-lg border border-gray-100 px-4 py-3 hover:border-blue-400">
                <span class="font-semibold text-gray-900">{eventTopics[s].label}</span>
                <span class="text-sm text-gray-500">{ps.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="companies" class="mt-12">
        <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 border-b border-gray-100 pb-2">By company</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {companies.map(([s, c]) => (
            <a href={`/events/companies/${s}/`} class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-800 hover:bg-gray-200">
              {c.name} ({c.posts.length})
            </a>
          ))}
        </div>
        <p class="mt-4 text-sm text-gray-500"><a href="/events/speakers/" class="font-semibold text-blue-600 hover:underline">Speaker index</a>: everyone named in a write-up.</p>
      </section>

      <h2 class="mt-12 text-2xl font-extrabold tracking-tight text-gray-900">All write-ups</h2>
      <EventPostList posts={posts} />
    </div>
  </Container>
</Layout>
