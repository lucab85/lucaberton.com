---
import Container from "@components/container.astro";
import ProductionAuthorityHome from "@components/production-authority-home.astro";
import Kpi from "@components/kpi.astro";
import Logos from "@components/logos.astro";
import ProblemStatement from "@components/problem-statement.astro";
import Books from "@components/books.astro";
import Courses from "@components/courses.astro";
import SpeakingStageProof from "@components/speaking-stage-proof.astro";
import Testimonials from "@components/testimonials-home.astro";
import LatestPosts from "@components/latest-posts.astro";
import LatestVideos from "@components/latest-videos.astro";
import Cta from "@components/cta.astro";
import Layout from "@layouts/Layout.astro";

export const prerender = true;
export const lastModified = "2026-08-29";
---

<Layout
  title="The Production AI Expert"
  description="Luca Berton — The Production AI Expert. Turns AI prototypes into secure, governed, scalable production systems. KubeCon & Red Hat Summit speaker."
>
  <ProductionAuthorityHome />

  <!-- Below the fold: KPI strip + big-brand trust -->
  <Kpi />
  <Logos />

  <!-- Problem definition era -->
  <ProblemStatement />

  <!-- Books & courses, in order -->
  <Books showAll={false} />
  <Courses />

  <SpeakingStageProof />

  <Container class="relative mx-auto w-full max-w-full overflow-hidden">
    <Testimonials />
    <LatestPosts />
    <LatestVideos />
  </Container>

  <Cta />
</Layout>
