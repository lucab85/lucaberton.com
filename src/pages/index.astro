---
import Container from "@components/container.astro";
import ProductionAuthorityHome from "@components/production-authority-home.astro";
import SpeakingStageProof from "@components/speaking-stage-proof.astro";
import Testimonials from "@components/testimonials-home.astro";
import LatestPosts from "@components/latest-posts.astro";
import LatestVideos from "@components/latest-videos.astro";
import Cta from "@components/cta.astro";
import Layout from "@layouts/Layout.astro";

export const prerender = true;
export const lastModified = "2026-08-29";
---

<Layout
