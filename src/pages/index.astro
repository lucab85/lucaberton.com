---
import Container from "@components/container.astro";
import ThreePlaneHero from "@components/home/ThreePlaneHero.astro";
import ProofPlanes from "@components/home/ProofPlanes.astro";
import WhatLucaDoes from "@components/home/WhatLucaDoes.astro";
import FrameworkNewsletter from "@components/home/FrameworkNewsletter.astro";
import Logos from "@components/logos.astro";
import Books from "@components/books.astro";
import AffiliateDisclosure from "@components/AffiliateDisclosure.astro";
import Courses from "@components/courses.astro";
import Testimonials from "@components/testimonials-home.astro";
import LatestPosts from "@components/latest-posts.astro";
import LatestVideos from "@components/latest-videos.astro";
import Cta from "@components/cta.astro";
import Layout from "@layouts/Layout.astro";
import OffersStrip from "@components/OffersStrip.astro";

export const prerender = true;
export const lastModified = "2026-11-14";
---

<Layout
  title="The Production AI Expert"
  description="Luca Berton, the Production AI Expert: builds AI factories for enterprises, upskills engineering teams and speaks at conferences worldwide."
>
  <!-- Three planes: the name, the portrait, the interface -->
  <ThreePlaneHero />

  <!-- The three ways to buy, still in the first scroll -->
  <div class="overflow-hidden bg-slate-950 pt-14">
    <OffersStrip />
  </div>

  <Logos />

  <!-- On stage, in conversation (Udienza), in production (AI factories) -->
  <ProofPlanes />

  <!-- Upskill the team, build the AI factory, value for stakeholders, more services -->
  <WhatLucaDoes />

  <FrameworkNewsletter />

  <!-- Books & courses, in order -->
  <Container>
    <AffiliateDisclosure class="mb-6 mt-16" />
  </Container>
  <Books showAll={false} />
  <Courses />

  <Container class="relative mx-auto w-full max-w-full overflow-hidden">
    <Testimonials />
    <LatestPosts />
    <LatestVideos />
  </Container>

  <Cta />
</Layout>
