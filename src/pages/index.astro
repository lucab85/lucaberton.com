---
import Container from "@components/container.astro";
import Cta from "@components/cta.astro";
import Features from "@components/features.astro";
import Hero from "@components/hero.astro";
import Kpi from "@components/kpi.astro";
import Courses from "@components/courses.astro";
import Books from "@components/books.astro";
import Logos from "@components/logos.astro";
import AnsiblePilot from "@components/ansiblepilot.astro";
import Testimonials from "@components/testimonials-home.astro";
import LatestPosts from "@components/latest-posts.astro";
import LatestVideos from "@components/latest-videos.astro";
import ProblemStatement from "@components/problem-statement.astro";
import WhyChooseMe from "@components/why-choose-me.astro";
import Layout from "@layouts/Layout.astro";
export const prerender = true;
export const lastModified = '2026-07-17';
---

<Layout title="">
  <!-- Full-bleed hero (no container) -->
  <Hero />
  <Kpi />
  <Logos />
  <ProblemStatement />
  <Features />
  <WhyChooseMe />
  <Container class="relative overflow-hidden w-full max-w-full mx-auto">
    <AnsiblePilot />
    <Courses />
    <Books />
    <Testimonials />
    <LatestPosts />
    <LatestVideos />
  </Container>
  <Cta />
</Layout>
