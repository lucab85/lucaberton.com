---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";

export const prerender = true;
export const lastModified = "2026-11-01";

const sponsorEmail = "mailto:luca@lucaberton.com?subject=Sponsorship%20inquiry%20(media%20kit)";
const udienzaDeck = "https://www.udienza.com/udienza-founding-member-2026.pdf";

const headline = [
  ["11,339", "LinkedIn followers"],
  ["375,933", "LinkedIn impressions, last 12 months (+27%)"],
  ["6,100", "organic visitors a month on lucaberton.com"],
  ["1.16M", "lifetime YouTube views"],
];

const channels = [
  {
    name: "LinkedIn",
    stat: "11,339 followers",
    detail: "375,933 impressions and 90,545 unique members reached in the last 12 months, 10,624 social engagements. The main channel for launches.",
  },
  {
    name: "lucaberton.com",
    stat: "6,100 organic visitors / month",
    detail: "53% engaged, 580,000 Google search impressions a month, 1,800+ technical articles. Readers compare infrastructure tools before they buy.",
  },
  {
    name: "YouTube",
    stat: "6,200 subscribers",
    detail: "1.16M lifetime views. Hands-on tutorials on Kubernetes, Ansible, AI infrastructure and platform engineering. 94% of viewers are aged 25 to 44.",
  },
  {
    name: "Udienza",
    stat: "Weekly ten-minute show",
    detail: "Interviews with the founders, maintainers and CTOs behind open source, cloud native and AI infrastructure, filmed at FOSDEM, KubeCon, AGNTCon + MCPCon and Open Source Summit.",
  },
];

const locations = [
  ["Amsterdam Area", 12],
  ["London Area", 6],
  ["Greater Bengaluru", 3],
  ["San Francisco Bay Area", 2],
  ["Greater Milan", 2],
  ["Rotterdam & The Hague", 2],
  ["New York City", 2],
  ["Utrecht Area", 1],
];

const seniority = [
  ["Senior", 43],
  ["Entry", 21],
  ["Director", 7],
  ["CXO", 6],
  ["Owner", 6],
  ["Manager", 5],
  ["VP", 3],
  ["Partner", 2],
];

const industries = [
  ["IT Services & IT Consulting", 34],
  ["Software Development", 18],
  ["Technology, Information & Internet", 9],
  ["Financial Services", 4],
  ["Computer & Network Security", 2],
  ["Telecommunications", 2],
];

const companySize = [
  ["10,001+ employees", 27],
  ["1,001 to 10,000", 14],
  ["201 to 1,000", 12],
  ["11 to 200", 22],
  ["0 to 10", 15],
];

const jobTitles = [
  "Software Engineer",
  "Founder",
  "Solutions Architect",
  "Co-Founder",
  "DevOps Engineer",
  "CEO",
  "Site Reliability Engineer",
  "Platform Engineer",
  "CTO",
];

const companies = ["Red Hat", "AWS", "JPMorganChase", "IBM", "Microsoft", "Google", "CNCF", "The Linux Foundation"];

const packages = [
  {
    title: "Dedicated LinkedIn post",
    body: "Native video or carousel with my hands-on take on your product, plus a follow-up comment linking to your page.",
    includes: ["One review round for factual accuracy", "Performance report after 14 days"],
  },
  {
    title: "Technical deep dive",
    body: "A hands-on tutorial or benchmark on lucaberton.com built around a real use case, amplified with a LinkedIn post. It keeps getting found in search long after launch.",
    includes: ["Evergreen article with your product in a real workflow", "LinkedIn amplification", "Performance report after 14 days"],
  },
  {
    title: "Udienza episode partner",
    body: "Your logo on three Udienza episodes: end card, episode page, YouTube description and podcast feed, named in each episode's launch posts.",
    includes: ["Captioned clips for your own channels", "Brand on the production, never in the conversation"],
  },
  {
    title: "Launch bundle",
    body: "All three above across a two-week launch window, at a bundle rate. The format most companies pick for a product or regional launch.",
    includes: ["LinkedIn post + deep dive + three Udienza episodes", "One coordinated launch calendar", "Combined performance report"],
    featured: true,
  },
];

const credentials = [
  "Media partner of the Linux Foundation's events",
  "CNCF-accredited media at KubeCon",
  "Speaker at KubeCon Europe 2026 and Red Hat Summit 2026",
  "Eight technical books, 40,000+ engineers taught",
  "Former VP of Infrastructure at JPMorgan Chase, Red Hat Ansible and RHEL engineering",
  "Docker Captain",
];
---

<Layout
  title="Media Kit — Sponsor Luca Berton and Udienza"
  description="Sponsor Luca Berton and Udienza: 11,000+ LinkedIn followers centred on Europe, senior AI and cloud infrastructure decision-makers. Rates on request."
>
  <Breadcrumb items={[{ name: "Partner with Luca", url: "/partner-with-luca/" }, { name: "Media kit" }]} />

  <section class="bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 py-16 md:py-20">
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-blue-300">Media kit · November 2026</p>
        <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Reach the engineers and leaders who run AI infrastructure in Europe.</h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl">
          A senior, technical audience centred on Amsterdam and London, across LinkedIn, lucaberton.com, YouTube and Udienza. Built for AI, cloud native, platform engineering and developer-tooling launches.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={sponsorEmail} class="rounded-lg bg-blue-500 px-6 py-3 font-bold text-white transition hover:bg-blue-400">
            Request availability
          </a>
          <a href={udienzaDeck} class="rounded-lg border border-slate-500 px-6 py-3 font-bold text-white transition hover:border-slate-300 hover:bg-white/5">
            Udienza sponsorship deck (PDF)
          </a>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section class="mx-auto -mt-8 grid max-w-5xl grid-cols-2 gap-4 md:grid-cols-4">
      {headline.map(([value, label]) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 text-center shadow-lg">
          <div class="text-3xl font-black text-slate-900">{value}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</div>
        </div>
      ))}
    </section>

    <section class="mx-auto max-w-5xl py-16">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Channels</p>
      <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">Four channels, one audience.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {channels.map((c) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{c.name}</h3>
            <p class="mt-1 font-semibold text-blue-700">{c.stat}</p>
            <p class="mt-3 leading-relaxed text-slate-600">{c.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl rounded-2xl bg-slate-950 p-8 text-white md:p-10">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-300">Audience</p>
      <h2 class="mt-3 text-3xl font-black">Who follows, and where they are.</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-slate-300">
        LinkedIn follower demographics, 1 November 2026. On lucaberton.com, the top countries by engaged readers are the United States, the Netherlands, Germany, India and the United Kingdom.
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        {[
          ["Top locations", locations],
          ["Seniority", seniority],
          ["Industry", industries],
          ["Company size", companySize],
        ].map(([heading, rows]) => (
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wide text-blue-300">{heading}</h3>
            <ul class="mt-4 space-y-3">
              {(rows as [string, number][]).map(([label, pct]) => (
                <li>
                  <div class="flex justify-between text-sm">
                    <span class="text-slate-200">{label}</span>
                    <span class="font-bold tabular-nums">{pct}%</span>
                  </div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/10">
                    <div class="h-1.5 rounded-full bg-blue-400" style={`width: ${Math.min(pct * 2, 100)}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-blue-300">Top job titles</h3>
          <p class="mt-3 leading-relaxed text-slate-300">{jobTitles.join(" · ")}</p>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-blue-300">Followers work at</h3>
          <p class="mt-3 leading-relaxed text-slate-300">{companies.join(" · ")}</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl py-16">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Packages and rates</p>
      <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">Scoped to your launch. Rates on request.</h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Every proposal is quoted for the launch window, region and formats you need. Paid-media usage rights and whitelisting are quoted separately. For season-long Udienza sponsorship, see the <a class="font-semibold text-blue-700 hover:underline" href={udienzaDeck}>Udienza deck</a>.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {packages.map((p) => (
          <article class={`rounded-2xl border p-7 shadow-sm ${p.featured ? "border-blue-500 bg-blue-50" : "border-slate-200 bg-white"}`}>
            <h3 class="text-xl font-bold text-slate-900">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-600">{p.body}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-600">
              {p.includes.map((item) => (
                <li class="flex gap-2"><span class="font-bold text-blue-600">✓</span><span>{item}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-10 pb-16 md:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Why the audience trusts it</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Fifteen years in production before a single camera.</h2>
        <ul class="mt-5 space-y-3 text-slate-600">
          {credentials.map((c) => (
            <li class="flex gap-2"><span class="font-bold text-blue-600">✓</span><span>{c}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Editorial terms</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Disclosed, tested, independent.</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Every sponsored piece is disclosed. Reviews cover factual accuracy, not opinion. On Udienza, sponsors never choose or appear as guests, and nobody pays to be interviewed.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          Full analytics exports (LinkedIn, YouTube, Google Search Console) are shared on request. More on formats on the <a class="font-semibold text-blue-700 hover:underline" href="/partner-with-luca/">partnership page</a>.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          <strong class="text-slate-900">PR agencies:</strong> to pitch a spokesperson for an interview, see the <a class="font-semibold text-blue-700 hover:underline" href="https://www.udienza.com/media-kit">Udienza media kit</a>. For sponsorships on this site, write to <a class="font-semibold text-blue-700 hover:underline" href={sponsorEmail}>luca@lucaberton.com</a>.
        </p>
      </div>
    </section>

    <section class="mx-auto mb-16 max-w-5xl rounded-2xl border border-blue-200 bg-blue-50 p-8 text-center md:p-10">
      <h2 class="text-3xl font-black text-slate-900">Planning a launch?</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-slate-600">
        Send the product, target region, launch date and the formats you are considering, and I will come back with availability and a proposed calendar.
      </p>
      <a href={sponsorEmail} class="mt-6 inline-block rounded-lg bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-500">
        Request rates
      </a>
      <p class="mt-6 text-xs text-slate-500">
        Sources: LinkedIn analytics (2 Nov 2025 to 1 Nov 2026), Google Search Console and Google Analytics 4 organic search (July to October 2026), YouTube Studio. Figures as of 1 November 2026.
      </p>
    </section>
  </Container>
</Layout>
