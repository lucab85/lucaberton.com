---
/**
 * Kit (ConvertKit) post-signup redirect target. Fires the authoritative
 * `email_signup` conversion (email_signup_start only measures intent).
 * Deliberately unlinked: set this URL as the form's success redirect in Kit.
 */
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
---

<Layout
  title="You're subscribed"
  description="Newsletter subscription confirmed."
  noindex={true}
>
  <Container>
    <div
      class="mx-auto max-w-xl text-center py-24"
      data-page-context
      data-page-type="confirmation"
      data-track-pageview-event="email_signup"
      data-tp-form-id="kit_ce74a48bfa"
    >
      <p class="text-5xl" aria-hidden="true">📬</p>
      <h1 class="mt-6 text-3xl font-bold text-gray-900">You're in — check your inbox</h1>
      <p class="mt-4 text-gray-600 leading-relaxed">
        One click on the confirmation email and you'll get weekly Production AI
        insights: Kubernetes, GPU infrastructure, and platform engineering. No spam.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/blog/" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">Keep reading the blog</a>
        <a href="/services/" class="px-6 py-3 border border-gray-300 hover:bg-gray-50 text-gray-800 font-semibold rounded-lg transition">Explore consulting services</a>
      </div>
    </div>
  </Container>
</Layout>
