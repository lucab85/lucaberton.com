---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import Contactform from "@components/contactform.astro";

export const prerender = true;
export const lastModified = "2026-09-27";

const partnershipEmail = "mailto:luca@lucaberton.com?subject=Partnership%20inquiry%20for%20lucaberton.com";

const formats = [
  {
    icon: "🧪",
    title: "Sponsored Technical Content",
    body: "Hands-on articles, benchmarks, tutorials, comparisons, and implementation stories built around a real technical use case.",
    examples: ["Long-form article", "Benchmark or migration guide", "Product-in-workflow tutorial"],
  },
  {
    icon: "🎥",
    title: "YouTube Reviews & Integrations",
    body: "Practical demonstrations for technical audiences, from dedicated walkthroughs to clearly disclosed integrations inside broader engineering content.",
    examples: ["Dedicated technical review", "Sponsored integration", "Demo + editorial follow-up"],
  },
  {
    icon: "📬",
    title: "Newsletter & Social Amplification",
    body: "Targeted distribution to engineers, architects, founders, and technical decision-makers around AI, cloud, Kubernetes, DevOps, and automation.",
    examples: ["Newsletter sponsorship", "LinkedIn amplification", "Multi-channel launch support"],
  },
  {
    icon: "🎤",
    title: "Events & Community Sponsorship",
    body: "Brand visibility around conferences, meetups, technical communities, interviews, and on-site coverage in Europe and beyond.",
    examples: ["Meetup sponsor", "Conference coverage", "Interview or demo session"],
  },
  {
    icon: "📈",
    title: "Affiliate & Referral Partnerships",
    body: "Evergreen performance placements inside relevant high-intent content when the product genuinely solves the reader's problem.",
    examples: ["Tracked editorial links", "Audience discount codes", "B2B lead referrals"],
  },
  {
    icon: "📣",
    title: "Content Licensing & Paid Media",
    body: "Paid usage rights are scoped separately from production. Brands can license selected creator assets for ads, landing pages, or sales enablement.",
    examples: ["Paid-media usage", "Whitelisting", "Sales enablement assets"],
  },
];
---

<Layout
  title="Partner with Luca Berton — Sponsorships & Technical Content"
  description="Partner with Luca Berton for sponsored technical content, YouTube reviews, newsletter sponsorships, event coverage, and affiliate partnerships."
>
  <Breadcrumb items={[{ name: "Partner with Luca" }]} />

  <section class="bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 py-16 md:py-20">
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-blue-300">Technical partnerships for serious products</p>
        <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Put your product in front of engineers who actually build things.</h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl">
          I work with AI, cloud, developer-tooling, infrastructure, cybersecurity, hardware, and enterprise software brands on practical content that earns attention because it is useful — not because it looks like an ad.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="#partnership-form" class="rounded-lg bg-blue-500 px-6 py-3 font-bold text-white transition hover:bg-blue-400">
            Discuss a partnership
          </a>
          <a href="/contact/" class="rounded-lg border border-slate-500 px-6 py-3 font-bold text-white transition hover:border-slate-300 hover:bg-white/5">
            Contact Luca
          </a>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section class="mx-auto -mt-8 grid max-w-5xl grid-cols-2 gap-4 md:grid-cols-4">
      {[
        ["18+", "years in technology"],
        ["8", "technical books"],
        ["30+", "conference talks"],
        ["150k+", "monthly views across Ansible Pilot + YouTube"],
      ].map(([value, label]) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 text-center shadow-lg">
          <div class="text-3xl font-black text-slate-900">{value}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</div>
        </div>
      ))}
    </section>

    <section class="mx-auto max-w-5xl py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Ways to work together</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">One campaign can combine awareness, trust, and measurable performance.</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          The strongest partnerships usually combine a fixed production fee with distribution and, where appropriate, affiliate or referral attribution. Paid-media usage and licensing are quoted separately so the scope stays clear.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {formats.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="text-3xl">{item.icon}</div>
            <h3 class="mt-4 text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-600">{item.body}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-600">
              {item.examples.map((example) => (
                <li class="flex gap-2"><span class="font-bold text-blue-600">✓</span><span>{example}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl rounded-2xl bg-slate-950 p-8 text-white md:p-10">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-300">Audience fit</p>
          <h2 class="mt-3 text-3xl font-black">Best fit for technical B2B products.</h2>
          <p class="mt-4 leading-relaxed text-slate-300">
            My audience is strongest around AI infrastructure, developer tools, Kubernetes, platform engineering, cloud, automation, DevOps, cybersecurity, and open source.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm">
          {["AI & agent platforms", "Developer tooling", "Cloud infrastructure", "Kubernetes & DevOps", "Cybersecurity", "Technical hardware", "B2B SaaS", "Training & certification"].map((topic) => (
            <div class="rounded-lg border border-white/10 bg-white/5 p-3 font-semibold text-slate-200">{topic}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-10 py-16 md:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Editorial trust</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Sponsored does not mean guaranteed praise.</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Paid and affiliate relationships are disclosed. I do not sell undisclosed placements or guaranteed-positive reviews. Products need a credible technical fit, and hands-on claims should be testable.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          That protects the audience and makes a successful partnership more valuable: the recommendation has to survive real engineering scrutiny.
        </p>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Campaign structure</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Clear commercial terms from the start.</h2>
        <ul class="mt-5 space-y-3 text-slate-600">
          <li><strong class="text-slate-900">Production fee:</strong> scoped to the deliverables and technical depth.</li>
          <li><strong class="text-slate-900">Distribution:</strong> website, YouTube, newsletter, social, and/or event channels as agreed.</li>
          <li><strong class="text-slate-900">Performance:</strong> affiliate, referral, or lead attribution can be layered on where appropriate.</li>
          <li><strong class="text-slate-900">Usage rights:</strong> paid media, whitelisting, and licensing are priced separately.</li>
        </ul>
      </div>
    </section>

    <section id="partnership-form" class="mx-auto mb-16 max-w-5xl scroll-mt-24">
      <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-8">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Start a conversation</p>
          <h2 class="mt-2 text-3xl font-black text-slate-900">Send the product, audience, deliverables, timeline, and budget range.</h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Include any affiliate or referral program, campaign usage requirements, geographic restrictions, and whether you want organic creator content, paid-media rights, or both.
          </p>
          <p class="mt-5 text-sm text-slate-600">
            Prefer email? <a class="font-bold text-blue-700 hover:underline" href={partnershipEmail}>luca@lucaberton.com</a>
          </p>
        </div>
        <Contactform
          trackingFormId="partnership"
          subjectPlaceholder="Brand / product / campaign"
          messagePlaceholder="Tell me about the product, target audience, requested deliverables, timeline, budget range, affiliate/referral structure, and usage rights."
        />
      </div>
    </section>
  </Container>
</Layout>
