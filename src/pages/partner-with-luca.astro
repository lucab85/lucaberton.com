---
import Layout from "@layouts/Layout.astro";
import { Picture } from "astro:assets";
import PlaneHero from "@components/PlaneHero.astro";
import partnerPhoto from "assets/photos/RedHatSummit2026-Book.jpg";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import Contactform from "@components/contactform.astro";
import AffiliateDisclosure from "@components/AffiliateDisclosure.astro";
import JotformOfferText from "@components/JotformOfferText.astro";

export const prerender = true;
export const lastModified = "2026-11-26";

const partnershipEmail = "mailto:luca@lucaberton.com?subject=Partnership%20inquiry%20for%20lucaberton.com";

const formats = [
  {
    icon: "🧪",
    title: "Sponsored Technical Content",
    body: "Hands-on articles, benchmarks, tutorials, comparisons, and implementation stories built around a real technical use case.",
    examples: ["Long-form article", "Benchmark or migration guide", "Product-in-workflow tutorial"],
  },
  {
    icon: "🎥",
    title: "YouTube Reviews & Integrations",
    body: "Practical demonstrations for technical audiences, from dedicated walkthroughs to clearly disclosed integrations inside broader engineering content.",
    examples: ["Dedicated technical review", "Sponsored integration", "Demo + editorial follow-up"],
  },
  {
    icon: "📬",
    title: "Newsletter & Social Amplification",
    body: "Targeted distribution to engineers, architects, founders, and technical decision-makers around AI, cloud, Kubernetes, DevOps, and automation.",
    examples: ["Newsletter sponsorship", "LinkedIn amplification", "Multi-channel launch support"],
  },
  {
    icon: "🎤",
    title: "Events & Community Sponsorship",
    body: "Brand visibility around conferences, meetups, technical communities, interviews, and on-site coverage in Europe and beyond.",
    examples: ["Meetup sponsor", "Conference coverage", "Interview or demo session"],
  },
  {
    icon: "📈",
    title: "Affiliate & Referral Partnerships",
    body: "Evergreen performance placements inside relevant high-intent content when the product genuinely solves the reader's problem.",
    examples: ["Tracked editorial links", "Audience discount codes", "B2B lead referrals"],
  },
  {
    icon: "📣",
    title: "Content Licensing & Paid Media",
    body: "Paid usage rights are scoped separately from production. Brands can license selected creator assets for ads, landing pages, or sales enablement.",
    examples: ["Paid-media usage", "Whitelisting", "Sales enablement assets"],
  },
];

// Commercial partners: referral, reseller, and affiliate relationships (not sponsorships).
const commercialPartners = [
  {
    name: "Rootly",
    company: "rootly",
    offerId: "rootly_partner_referral",
    offerType: "partner",
    relationship: "Referral and reseller partner",
    body: "AI-native incident management and on-call for SRE and platform teams. Through Open Empower I can refer teams to Rootly or resell it as part of a platform engagement.",
    cta: "Explore Rootly AI SRE",
    url: "https://rootly.com/ai-sre?utm_source=lucaberton&utm_medium=referral&utm_campaign=kubecon-eu-2026&utm_content=blog-recap",
    related: { label: "Read the KubeCon Europe 2026 interview", href: "/blog/rootly-kubecon-europe-2026-ai-sre-incident-management/" },
  },
  {
    name: "Atoms.dev",
    company: "atoms",
    offerId: "atoms_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "AI-powered app builder for production-ready applications with hosting, authentication, payments, and SEO built in. Use code LUCA10 for 10% off.",
    cta: "Try Atoms.dev — use LUCA10",
    url: "https://atoms.dev/register",
  },
  {
    name: "Tiiny Host",
    company: "tiiny_host",
    offerId: "tiiny_host_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "Simple hosting for static web projects, prototypes and portfolios. Use code LUCA10 for 10% off, or LUCA35 for the 35% seasonal discount valid through January 31, 2027.",
    cta: "Explore Tiiny Host",
    url: "https://tiiny.host?fpr=luca-97b16e",
  },
  {
    name: "Buildliy",
    company: "buildliy",
    offerId: "buildliy_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "AI app builder for turning natural-language requirements into a working application. Eligible new users who upgrade to Pro within 30 days of signing up with referral code 4ZM2H2 receive 50 bonus credits.",
    cta: "Explore Buildliy",
    url: "https://www.buildliy.com/r/4zm2h2",
    related: { label: "Explore AI web design tools", href: "/blog/40-ai-web-design-tools-ui-inspiration-2026/" },
  },
  {
    name: "MRPeasy",
    company: "mrpeasy",
    offerId: "mrpeasy_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "Cloud ERP and MRP software for small and midsize manufacturers, covering production planning, inventory and business operations.",
    cta: "Explore MRPeasy",
    url: "https://try.mrpeasy.com/0wh78g0svtll",
  },
  {
    name: "Jotform",
    company: "jotform",
    offerId: "jotform_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "Online forms and workflow automation for collecting data and building business processes.",
    cta: "Explore Jotform plans",
    url: "https://www.jotform.com/pricing/?partner=lucaberton",
    related: { label: "Explore AI web design tools", href: "/blog/40-ai-web-design-tools-ui-inspiration-2026/" },
  },
  {
    name: "DigitalOcean",
    company: "digitalocean",
    offerId: "digitalocean_affiliate",
    offerType: "affiliate",
    relationship: "Affiliate partner",
    body: "Cloud infrastructure for developers, including virtual machines for self-hosted applications and managed Kubernetes.",
    cta: "Explore DigitalOcean",
    url: "https://www.awin1.com/cread.php?awinmid=123996&awinaffid=1937397",
    related: { label: "Read the OpenClaw VPS deployment guide", href: "/blog/openclaw-vps-deployment-always-on-ai-agent/" },
  },
];
---

<Layout
  title="Partner with Luca Berton — Sponsorships & Technical Content"
  description="Partner with Luca Berton for sponsored technical content, YouTube reviews, newsletter sponsorships, event coverage, and affiliate partnerships."
>
  <Breadcrumb items={[{ name: "Partner with Luca" }]} />
  <Container>
    <AffiliateDisclosure class="my-4" />
  </Container>

    <PlaneHero
    word="Partner"
    wordSize={29.8}
    flip
    eyebrow="Technical partnerships for serious products"
    title="Put your product in front of engineers who actually build things."
    badge={{ value: "150k", sup: "+", label: "Monthly views<br />across channels", href: "/media-kit/" }}
    cta={{ href: "#partnership-form", label: "Discuss a partnership" }}
    secondary={{ text: "Numbers and formats:", href: "/media-kit/", label: "Media kit" }}
  >
    <Picture
      slot="media"
      src={partnerPhoto}
      alt="Luca Berton with a partner at Red Hat Summit 2026, holding his book Practical RHEL AI"
      widths={[640, 960, 1280]}
      sizes="(max-width: 1024px) 92vw, 640px"
      formats={["avif", "webp"]}
      loading="eager"
      class="aspect-[16/10] object-cover"
    />
    <p>
      I work with AI, cloud, developer-tooling, infrastructure, cybersecurity, hardware, and
      enterprise software brands on practical content that earns attention because it is useful,
      not because it looks like an ad.
    </p>
  </PlaneHero>

  <Container>
    <section class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-4 md:grid-cols-4">
      {[
        ["18+", "years in technology"],
        ["8", "technical books"],
        ["30+", "conference talks"],
        ["150k+", "monthly views across Ansible Pilot + YouTube"],
      ].map(([value, label]) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 text-center shadow-lg">
          <div class="text-3xl font-black text-slate-900">{value}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</div>
        </div>
      ))}
    </section>

    <section class="mx-auto max-w-5xl py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Ways to work together</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">One campaign can combine awareness, trust, and measurable performance.</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          The strongest partnerships usually combine a fixed production fee with distribution and, where appropriate, affiliate or referral attribution. Paid-media usage and licensing are quoted separately so the scope stays clear.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {formats.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="text-3xl">{item.icon}</div>
            <h3 class="mt-4 text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-600">{item.body}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-600">
              {item.examples.map((example) => (
                <li class="flex gap-2"><span class="font-bold text-blue-600">✓</span><span>{example}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl rounded-2xl bg-slate-950 p-8 text-white md:p-10">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-300">Audience fit</p>
          <h2 class="mt-3 text-3xl font-black">Best fit for technical B2B products.</h2>
          <p class="mt-4 leading-relaxed text-slate-300">
            My audience is strongest around AI infrastructure, developer tools, Kubernetes, platform engineering, cloud, automation, DevOps, cybersecurity, and open source.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm">
          {["AI & agent platforms", "Developer tooling", "Cloud infrastructure", "Kubernetes & DevOps", "Cybersecurity", "Technical hardware", "B2B SaaS", "Training & certification"].map((topic) => (
            <div class="rounded-lg border border-white/10 bg-white/5 p-3 font-semibold text-slate-200">{topic}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-10 py-16 md:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Editorial trust</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Sponsored does not mean guaranteed praise.</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Paid and affiliate relationships are disclosed. I do not sell undisclosed placements or guaranteed-positive reviews. Products need a credible technical fit, and hands-on claims should be testable.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          That protects the audience and makes a successful partnership more valuable: the recommendation has to survive real engineering scrutiny.
        </p>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Campaign structure</p>
        <h2 class="mt-3 text-3xl font-black text-slate-900">Clear commercial terms from the start.</h2>
        <ul class="mt-5 space-y-3 text-slate-600">
          <li><strong class="text-slate-900">Production fee:</strong> scoped to the deliverables and technical depth.</li>
          <li><strong class="text-slate-900">Distribution:</strong> website, YouTube, newsletter, social, and/or event channels as agreed.</li>
          <li><strong class="text-slate-900">Performance:</strong> affiliate, referral, or lead attribution can be layered on where appropriate.</li>
          <li><strong class="text-slate-900">Usage rights:</strong> paid media, whitelisting, and licensing are priced separately.</li>
        </ul>
      </div>
    </section>

    <section id="commercial-partners" class="mx-auto max-w-5xl pb-16 scroll-mt-24">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Commercial partners</p>
      <h2 class="mt-3 text-3xl font-black text-slate-900">Products I refer, resell, or recommend.</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-slate-600">
        These are referral, reseller, and affiliate relationships, not sponsorships. I may earn a commission or margin when you buy through these links, at no extra cost to you. These listings reflect commercial relationships and technical audience fit; they are not necessarily hands-on reviews.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {commercialPartners.map((p) => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wide text-blue-700">{p.relationship}</p>
            <h3 class="mt-2 text-xl font-bold text-slate-900">{p.name}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-slate-600">{p.body}{p.company === "jotform" && <> <JotformOfferText /></>}</p>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href={p.url} target="_blank" rel="nofollow sponsored noopener noreferrer"
                data-track-event="affiliate_click"
                data-tp-company={p.company}
                data-tp-offer-id={p.offerId}
                data-tp-offer-type={p.offerType}
                data-tp-cta-position="related_offer"
                data-tp-cta-variant="commercial_partner_card"
                class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700">
                {p.cta}
              </a>
              {p.related && (
                <a href={p.related.href} class="text-sm font-semibold text-blue-700 hover:underline">{p.related.label}</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <article id="revolut-referral" hidden class="mt-6 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm" data-expires-at="2026-12-03T00:00:00+01:00">
        <p class="text-xs font-bold uppercase tracking-wide text-blue-700">Limited-time personal referral</p>
        <h3 class="mt-2 text-xl font-bold text-slate-900">Revolut Business</h3>
        <p class="mt-3 leading-relaxed text-slate-600">
          For existing business contacts who have agreed to receive my referral invitation: if you are considering a new Revolut Business account, this invitation may be relevant. Eligibility and required steps are set by Revolut. The campaign ends December 2, 2026; all required steps must be completed before the deadline. I may receive a referral reward; no reward for the applicant is promised.
        </p>
        <a href="https://business.revolut.com/signup?promo=B2B-NOV2-26-AR-H3&amp;ext=40513667-16ae-4a35-b760-ee714790fc1c&amp;context=B2B_REFERRAL" target="_blank" rel="nofollow sponsored noopener noreferrer"
          data-track-event="affiliate_click"
          data-tp-company="revolut"
          data-tp-offer-id="revolut_business_nov2026"
          data-tp-offer-type="partner"
          data-tp-cta-position="related_offer"
          data-tp-cta-variant="commercial_partner_card"
          class="mt-5 inline-block rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700">Open your referral invitation</a>
      </article>
      <script is:inline>
        (() => {
          const offer = document.getElementById("revolut-referral");
          if (!offer) return;
          const expires = Date.parse(offer.dataset.expiresAt);
          const refresh = () => { offer.hidden = !(Date.now() < expires); };
          refresh();
          window.addEventListener("pageshow", refresh);
          if (Date.now() < expires) window.setTimeout(refresh, expires - Date.now());
        })();
      </script>
    </section>

    <section id="partnership-form" class="mx-auto mb-16 max-w-5xl scroll-mt-24">
      <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-8">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Start a conversation</p>
          <h2 class="mt-2 text-3xl font-black text-slate-900">Send the product, audience, deliverables, timeline, and budget range.</h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Include any affiliate or referral program, campaign usage requirements, geographic restrictions, and whether you want organic creator content, paid-media rights, or both.
          </p>
          <p class="mt-5 text-sm text-slate-600">
            Prefer email? <a class="font-bold text-blue-700 hover:underline" href={partnershipEmail}>luca@lucaberton.com</a>
          </p>
        </div>
        <Contactform
          trackingFormId="partnership"
          subjectPlaceholder="Brand / product / campaign"
          messagePlaceholder="Tell me about the product, target audience, requested deliverables, timeline, budget range, affiliate/referral structure, and usage rights."
        />
      </div>
    </section>
  </Container>
</Layout>
