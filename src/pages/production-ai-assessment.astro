---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import heroPhoto from "@assets/photos/RedHatSummit2026-Stage.jpg";
import proofPhoto from "@assets/photos/KubeConEU2026-Xebia.jpg";

export const prerender = true;
export const lastModified = "2026-09-18";

const bookingUrl = "https://calendly.com/lucaberton/";

const diagnosticAreas = [
  { n: "01", title: "Architecture", text: "Models, agents, APIs, data paths and the dependencies between them." },
  { n: "02", title: "Compute", text: "GPU capacity, utilization, scheduling, tenancy and unit economics." },
  { n: "03", title: "Reliability", text: "Failure modes, scaling, recovery objectives and production SLOs." },
  { n: "04", title: "Observability", text: "Logs, traces, model telemetry, evaluation signals and ownership." },
  { n: "05", title: "Security", text: "Identity, access, secrets, data exposure and supply-chain controls." },
  { n: "06", title: "Governance", text: "Policies, approvals, audit evidence and clear accountability." },
  { n: "07", title: "Cost", text: "Tokens, inference, accelerators, idle capacity and cost allocation." },
  { n: "08", title: "Platform", text: "Developer paths, automation, shared services and operating boundaries." },
];

const deliverables = [
  "Executive findings summary",
  "Production readiness scorecard",
  "Architecture risk map",
  "Prioritized technical gaps",
  "Security and governance observations",
  "Cost and capacity considerations",
  "30 / 60 / 90-day action roadmap",
  "Leadership readout",
];

const faqs = [
  { q: "What exactly will you review?", a: "The assessment follows the system from model and application architecture through compute, data paths, developer workflows, reliability, observability, security, governance and cost. The scope is agreed during the fit call so the review stays focused on the decisions that matter to your production path." },
  { q: "Do we need to be running Kubernetes?", a: "No. Kubernetes may be part of the environment, but the assessment is platform- and deployment-model independent. Luca can review cloud-managed services, virtual-machine platforms and hybrid architectures as well as Kubernetes-based systems." },
  { q: "Are you tied to a particular cloud or vendor?", a: "No. The goal is an independent view of your production risks and priorities, not a vendor sales recommendation. Existing technology choices are evaluated against your operating needs, constraints and economics." },
  { q: "How much access will you need?", a: "The review can usually be completed through architecture material, configuration evidence and structured conversations with the relevant stakeholders. Direct production access is not the default and is only discussed if it is genuinely useful and acceptable to your security team." },
  { q: "Who should participate?", a: "Usually the technical owner of the AI initiative plus representatives from platform or infrastructure, application engineering, security and governance. Executive sponsorship is helpful for the opening context and final readout." },
  { q: "How long does the assessment take?", a: "Timing depends on scope and stakeholder availability. The first 30-minute conversation confirms fit, boundaries and a realistic schedule before any work begins." },
  { q: "What does the final deliverable look like?", a: "You receive a concise executive summary, a production-readiness scorecard, a risk and gap map, prioritized recommendations and a 30 / 60 / 90-day roadmap, followed by a leadership readout." },
  { q: "Can Luca help implement the recommendations?", a: "Yes, when it is a good fit. Implementation or advisory support is scoped separately after the assessment, so the diagnostic remains independent and useful even if your own team completes the work." },
  { q: "We are still in pilot. Is it too early?", a: "Not necessarily. The best time is often when the use case is proven but major platform decisions are still reversible. If you are still searching for a first AI use case, this assessment is probably premature." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Layout
  title="Production AI Readiness Assessment"
  description="Find the architecture, platform, security, reliability, cost and governance gaps between your AI prototype and production."
  minimalChrome
  minimalCtaHref={bookingUrl}
  minimalCtaLabel="Book Assessment"
  minimalCtaOffer="production_ai_assessment"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="assessment-hero relative overflow-hidden bg-slate-950 py-16 text-white lg:py-24">
    <div class="grid-glow" aria-hidden="true"></div>
    <Container>
      <div class="relative grid items-center gap-12 lg:grid-cols-[1.08fr_.92fr] lg:gap-16">
        <div data-reveal>
          <p class="eyebrow">Production AI Readiness Assessment</p>
          <h1 class="mt-6 max-w-4xl text-5xl font-black leading-[.96] tracking-[-.045em] sm:text-6xl lg:text-7xl">
            Your AI demo works.<br /><span class="text-red-500">Now find out what will break</span> in production.
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-300 lg:text-xl">
            Get an independent assessment of the architecture, platform and operating decisions between your AI prototype and a system your organization can reliably operate, secure, govern and scale.
          </p>
          <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href={bookingUrl} data-track-event="consulting_cta_click" data-tp-target-offer="production_ai_assessment" data-tp-cta-position="hero" data-tp-cta-variant="hero_book_assessment" class="primary-cta">Book your production AI assessment <span aria-hidden="true">→</span></a>
            <a href="#assessment" class="text-sm font-semibold text-slate-300 transition hover:text-white">See what we assess ↓</a>
          </div>
          <p class="mt-5 text-sm text-slate-400">30-minute fit call · No sales deck · A technical conversation</p>
        </div>
        <div class="relative mx-auto w-full max-w-[520px]" data-reveal>
          <div class="photo-frame">
            <Image src={heroPhoto} alt="Luca Berton speaking on stage at Red Hat Summit" width={900} widths={[600, 900]} sizes="(max-width: 1024px) 90vw, 42vw" loading="eager" fetchpriority="high" class="h-[520px] w-full object-cover object-[center_30%] sm:h-[620px]" />
          </div>
          <div class="framework-tag" aria-hidden="true">
            <span>Prototype</span><i>→</i><span>Platform</span><i>→</i><span>Production</span><i>→</i><span>Proof</span>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-y border-slate-200 bg-white py-7">
    <Container>
      <div class="grid grid-cols-2 gap-x-6 gap-y-5 text-center text-sm font-bold text-slate-700 md:grid-cols-3 lg:grid-cols-6">
        <span>Former Red Hat Engineer</span><span>Docker Captain</span><span>8 Technical Books</span><span>40K+ Students</span><span>KubeCon Speaker</span><span>Red Hat Summit</span>
      </div>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-4xl text-center" data-reveal>
        <p class="eyebrow text-red-700">The production gap</p>
        <h2 class="section-title mt-4">The prototype answered one question.<br />Production introduces twenty more.</h2>
        <p class="section-intro mx-auto mt-6">Connecting an application to a model is increasingly easy. Operating it reliably across teams, workloads and organizational controls is not.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-[1fr_auto_1fr] md:items-center">
        <div class="comparison-card comparison-demo" data-reveal>
          <p class="card-label">The demo</p>
          <ul><li>Model responds</li><li>Prompt works</li><li>Team sees value</li><li>Executives see potential</li></ul>
        </div>
        <span class="hidden text-3xl text-red-500 md:block">→</span>
        <div class="comparison-card bg-slate-950 text-white" data-reveal>
          <p class="card-label text-red-400">Production</p>
          <div class="grid grid-cols-2 gap-3 text-sm text-slate-300"><span>Identity</span><span>Reliability</span><span>GPU capacity</span><span>Observability</span><span>Cost</span><span>Security</span><span>Governance</span><span>Auditability</span></div>
        </div>
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center text-lg font-semibold text-slate-800">The assessment identifies which questions your current architecture can answer—and which ones are becoming production risk.</p>
    </Container>
  </section>

  <section id="assessment" class="scroll-mt-24 bg-slate-100 py-20 lg:py-28">
    <Container>
      <div class="max-w-3xl" data-reveal><p class="eyebrow text-red-700">A complete diagnostic</p><h2 class="section-title mt-4">What the assessment examines</h2><p class="section-intro mt-5">Eight connected layers. One production system. Each area is reviewed against your real operating context—not a generic maturity checklist.</p></div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-slate-300 bg-slate-300 sm:grid-cols-2 lg:grid-cols-4">
        {diagnosticAreas.map((item) => <article class="diagnostic-card bg-white p-6 lg:p-7" data-reveal><span class="text-xs font-black text-red-600">{item.n}</span><h3 class="mt-8 text-xl font-bold text-slate-950">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{item.text}</p></article>)}
      </div>
      <div class="mt-10 text-center"><a href={bookingUrl} data-track-event="consulting_cta_click" data-tp-target-offer="production_ai_assessment" data-tp-cta-position="inline_50" data-tp-cta-variant="mid_page_assess_my_platform" class="secondary-cta">Assess my AI platform →</a></div>
    </Container>
  </section>

  <section class="bg-slate-950 py-20 text-white lg:py-28">
    <Container>
      <div class="mx-auto max-w-4xl text-center" data-reveal><p class="eyebrow text-red-400">The Production AI Framework</p><h2 class="section-title mt-4 text-white">From prototype to proof.</h2><p class="section-intro mx-auto mt-5 text-slate-400">A repeatable way to evaluate the complete operating system around AI—not only whether the application works today.</p></div>
      <div class="framework mt-14 grid gap-4 md:grid-cols-4">
        {[
          ["01", "Prototype", "Validate the use case and economics before the demo becomes architecture by accident."],
          ["02", "Platform", "Standardize infrastructure, access, security, data paths and developer workflows."],
          ["03", "Production", "Engineer for reliability, observability, performance, cost and recovery."],
          ["04", "Proof", "Make governance visible with controls, logs, runbooks and verifiable evidence."],
        ].map(([n, title, text], i) => <article class="relative rounded-2xl border border-white/10 bg-white/[.04] p-6" data-reveal><span class="text-xs font-black text-red-400">{n}</span><h3 class="mt-10 text-2xl font-bold">{title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-400">{text}</p>{i < 3 && <span class="framework-arrow" aria-hidden="true">→</span>}</article>)}
      </div>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div data-reveal><p class="eyebrow text-red-700">Your deliverables</p><h2 class="section-title mt-4">You leave with decisions, not another strategy deck.</h2><div class="mt-8 grid gap-3 sm:grid-cols-2">{deliverables.map((item, i) => <div class="flex items-start gap-3 rounded-xl border border-slate-200 p-4"><span class="text-xs font-black text-red-600">{String(i + 1).padStart(2, "0")}</span><span class="text-sm font-semibold text-slate-800">{item}</span></div>)}</div><a href={bookingUrl} data-track-event="consulting_cta_click" data-tp-target-offer="production_ai_assessment" data-tp-cta-position="inline_75" data-tp-cta-variant="deliverables_book_my_assessment" class="primary-cta mt-9">Book my assessment →</a></div>
        <div class="report-mockup" data-reveal>
          <div class="flex items-start justify-between border-b border-slate-200 pb-8"><div><p class="text-xs font-black uppercase tracking-[.18em] text-red-600">Production AI Readiness</p><h3 class="mt-2 text-3xl font-black text-slate-950">Assessment</h3></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500">CONFIDENTIAL</span></div>
          <p class="mt-8 text-xs font-bold uppercase tracking-wider text-slate-500">Executive readiness</p><div class="mt-3 h-3 overflow-hidden rounded-full bg-slate-100"><div class="h-full w-[64%] bg-red-600"></div></div>
          <div class="mt-8 space-y-4">{[["Architecture","High priority"],["Observability","Medium"],["Governance","High priority"],["Cost controls","Medium"]].map(([a,b]) => <div class="flex items-center justify-between border-b border-slate-100 pb-3 text-sm"><span class="font-semibold text-slate-800">{a}</span><span class:list={["text-xs font-black uppercase", b === "High priority" ? "text-red-600" : "text-amber-600"]}>{b}</span></div>)}</div>
          <p class="mt-8 text-xs font-black uppercase tracking-wider text-slate-500">Top actions</p><ol class="mt-4 space-y-3 text-sm text-slate-700"><li>01 · Establish production ownership and SLOs</li><li>02 · Close identity and data-path controls</li><li>03 · Instrument cost per workload</li></ol>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-slate-100 py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-4xl text-center" data-reveal><p class="eyebrow text-red-700">A focused engagement</p><h2 class="section-title mt-4">From first conversation to production priorities.</h2></div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">{[
        ["01", "Before", "Fit call, architecture questionnaire, relevant diagrams and business context."],
        ["02", "Assessment", "Stakeholder interviews, architecture review and Production AI analysis."],
        ["03", "After", "Findings, prioritized roadmap, leadership readout and next-step recommendations."],
      ].map(([n,title,text]) => <article class="rounded-2xl bg-white p-7 shadow-sm" data-reveal><span class="text-xs font-black text-red-600">{n}</span><h3 class="mt-10 text-2xl font-bold text-slate-950">{title}</h3><p class="mt-3 leading-relaxed text-slate-600">{text}</p></article>)}</div>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      <div class="max-w-3xl" data-reveal><p class="eyebrow text-red-700">Executive outcomes</p><h2 class="section-title mt-4">Know what to fix before scale makes it expensive.</h2></div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{[
        ["Production priorities", "Know which architectural gaps matter now and which can wait."],
        ["Platform decisions", "Identify what belongs in shared capability instead of project-by-project engineering."],
        ["Operational risk", "Surface reliability and observability weaknesses before real users depend on the system."],
        ["Cost visibility", "See where GPU, model and inference economics need stronger controls."],
        ["Governance evidence", "Connect technical controls to the proof security, risk and audit teams require."],
        ["Leadership alignment", "Create a common definition of production ready across executives and engineering."],
      ].map(([title,text]) => <article class="outcome-card" data-reveal><h3 class="text-xl font-bold text-slate-950">{title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{text}</p></article>)}</div>
    </Container>
  </section>

  <section class="overflow-hidden bg-slate-950 text-white">
    <div class="grid lg:grid-cols-2">
      <Image src={proofPhoto} alt="Luca Berton speaking to a technical audience at KubeCon Europe" widths={[800,1200,1600]} sizes="(max-width: 1024px) 100vw, 50vw" class="h-full min-h-[420px] w-full object-cover" />
      <div class="flex items-center px-6 py-16 sm:px-12 lg:px-16 lg:py-24" data-reveal><div class="max-w-xl"><p class="eyebrow text-red-400">Why Luca</p><h2 class="section-title mt-4 text-white">Engineering depth.<br />Executive translation.</h2><p class="mt-6 text-lg leading-relaxed text-slate-300">Luca Berton has spent 15+ years across enterprise infrastructure, automation, Kubernetes, cloud and AI platforms. He focuses on the operational layer most AI conversations skip: what it takes to run AI safely, repeatedly and economically in production.</p><div class="mt-8 grid grid-cols-2 gap-4 text-sm font-bold text-slate-200"><span>Former Red Hat engineer</span><span>Docker Captain</span><span>8 technical books</span><span>40K+ students</span><span>KubeCon speaker</span><span>Red Hat Summit speaker</span></div><blockquote class="mt-10 border-l-2 border-red-500 pl-5 text-xl font-bold leading-snug">“The board sees an AI demo. The platform team sees everything the demo forgot.”</blockquote></div></div>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      <div class="grid gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border border-slate-200 p-7 lg:p-10" data-reveal><p class="card-label text-red-700">This is for you if…</p><ul class="fit-list mt-8">{["You have working AI pilots", "Production is approaching", "Multiple teams are involved", "Platform decisions are becoming strategic", "Security or governance has entered the conversation"].map(item => <li><span>✓</span>{item}</li>)}</ul></article>
        <article class="rounded-2xl bg-slate-100 p-7 lg:p-10" data-reveal><p class="card-label text-slate-600">Probably not if…</p><ul class="fit-list mt-8 muted">{["You are still looking for your first AI use case", "You only need prompt engineering", "You want a generic AI strategy presentation", "You want a specific vendor sales pitch"].map(item => <li><span>×</span>{item}</li>)}</ul></article>
      </div>
    </Container>
  </section>

  <section class="bg-slate-100 py-20 lg:py-28">
    <Container>
      <div class="offer-panel mx-auto max-w-5xl" data-reveal><p class="eyebrow text-red-400">The engagement</p><h2 class="mt-5 text-4xl font-black tracking-tight text-white md:text-5xl">Production AI Readiness Assessment</h2><p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">An independent review of the architecture, platform and operating model behind your production AI initiative.</p><div class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2">{["Discovery and technical intake", "Architecture review", "Production readiness assessment", "Risk and gap analysis", "Prioritized recommendations", "30 / 60 / 90-day roadmap", "Leadership readout", "Clear next-step options"].map(item => <div class="flex gap-3 text-sm font-semibold text-slate-200"><span class="text-red-400">✓</span>{item}</div>)}</div><div class="mt-12 flex flex-col items-start gap-4 sm:flex-row sm:items-center"><a href={bookingUrl} class="primary-cta">Book an assessment call →</a><span class="text-sm text-slate-400">Start with a 30-minute fit conversation.</span></div></div>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-3xl"><div class="text-center" data-reveal><p class="eyebrow text-red-700">Questions before you book</p><h2 class="section-title mt-4">Frequently asked questions</h2></div><div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">{faqs.map(({q,a}) => <details class="group py-1"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-bold text-slate-950"><span>{q}</span><span class="text-xl text-red-600 transition group-open:rotate-45">+</span></summary><p class="max-w-2xl pb-6 leading-relaxed text-slate-600">{a}</p></details>)}</div><div class="mt-10 text-center"><a href={bookingUrl} class="secondary-cta">Book your assessment →</a></div></div>
    </Container>
  </section>

  <section class="final-cta bg-red-600 py-20 text-center text-white lg:py-28">
    <Container><div class="mx-auto max-w-4xl" data-reveal><p class="eyebrow text-red-100">Your prototype already proved something.</p><h2 class="mt-5 text-4xl font-black leading-tight tracking-tight md:text-6xl">Now prove it can survive production.</h2><p class="mx-auto mt-6 max-w-2xl text-lg text-red-100">Identify the architecture, platform and operating gaps before they become production constraints.</p><a href={bookingUrl} class="mt-9 inline-flex rounded-full bg-white px-7 py-4 font-black text-red-700 shadow-2xl transition hover:-translate-y-0.5">Book your assessment →</a><p class="mt-4 text-sm text-red-100">30-minute initial conversation</p></div></Container>
  </section>

  <footer class="bg-slate-950 px-6 py-8 text-sm text-slate-400"><div class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><a href="/" class="font-bold text-white">Luca Berton</a><div class="flex gap-5"><a href="/privacy-policy/" class="hover:text-white">Privacy</a><a href="/terms/" class="hover:text-white">Terms</a><a href="/" class="hover:text-white">Main site</a></div><span>© 2026 Luca Berton</span></div></footer>

  <a href={bookingUrl} data-track-event="consulting_cta_click" data-tp-target-offer="production_ai_assessment" data-tp-cta-position="sticky_bar" data-tp-cta-variant="mobile_book_production_assessment" class="mobile-cta">Book production assessment</a>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .eyebrow { font-size: .75rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .section-title { font-size: clamp(2.25rem, 5vw, 3.6rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.02; color: #0f172a; }
  .section-intro { max-width: 46rem; font-size: 1.125rem; line-height: 1.75; color: #64748b; }
  .primary-cta { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 999px; background: #dc2626; padding: 1rem 1.5rem; color: white; font-weight: 800; box-shadow: 0 14px 36px rgba(220,38,38,.24); transition: .2s ease; }
  .primary-cta:hover { background: #ef4444; transform: translateY(-2px); }
  .secondary-cta { display: inline-flex; border-radius: 999px; border: 1px solid #cbd5e1; padding: .9rem 1.35rem; font-weight: 800; color: #0f172a; transition: .2s ease; }
  .secondary-cta:hover { border-color: #dc2626; color: #b91c1c; }
  .grid-glow { position: absolute; inset: 0; opacity: .45; background-image: linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px),radial-gradient(circle at 25% 20%,rgba(220,38,38,.32),transparent 35%); background-size: 58px 58px,58px 58px,100% 100%; mask-image: linear-gradient(to bottom,black,transparent 95%); }
  .photo-frame { overflow: hidden; border: 1px solid rgba(255,255,255,.14); border-radius: 1.5rem; box-shadow: 0 30px 80px rgba(0,0,0,.48); }
  .framework-tag { position: absolute; right: -1rem; bottom: 1.5rem; display: flex; max-width: calc(100% - 1rem); flex-wrap: wrap; gap: .45rem; border: 1px solid rgba(255,255,255,.15); border-radius: 1rem; background: rgba(15,23,42,.9); padding: .85rem 1rem; font-size: .65rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(12px); }
  .framework-tag i { color: #ef4444; font-style: normal; }
  .card-label { font-size: .75rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .comparison-card { min-height: 18rem; border-radius: 1.25rem; padding: 2rem; box-shadow: 0 8px 30px rgba(15,23,42,.08); }
  .comparison-demo { border: 1px solid #e2e8f0; background: white; }
  .comparison-card ul { margin-top: 2rem; display: grid; gap: .85rem; color: #475569; }
  .comparison-card li::before { content: "✓"; margin-right: .65rem; color: #16a34a; font-weight: 900; }
  .diagnostic-card { min-height: 14rem; transition: transform .2s ease, background .2s ease; }
  .diagnostic-card:hover { z-index: 1; transform: translateY(-4px); background: #fff7f7; }
  .framework-arrow { position: absolute; right: -1rem; top: 50%; z-index: 2; display: none; color: #ef4444; font-size: 1.4rem; }
  .report-mockup { border: 1px solid #e2e8f0; border-radius: 1.5rem; background: white; padding: clamp(1.5rem,4vw,3rem); box-shadow: 0 28px 70px rgba(15,23,42,.13); transform: rotate(1.2deg); }
  .outcome-card { border-top: 3px solid #dc2626; background: #f8fafc; padding: 1.75rem; }
  .fit-list { display: grid; gap: 1rem; }
  .fit-list li { display: flex; gap: .75rem; color: #334155; font-weight: 600; }
  .fit-list li span { color: #16a34a; font-weight: 900; }
  .fit-list.muted li span { color: #94a3b8; }
