---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { sales, kitLive } from "../data/sales";

export const prerender = true;

const { checkoutUrl, price, name, currency } = sales.kit;
const priceValue = price.replace(/[^0-9.]/g, "");

const inside = [
  { title: "Two editable keynote decks", text: "The 30-minute keynote from AI Tech Summit Skopje 2026 and the 20-minute Nordic APIs Summit 2026 talk, in PowerPoint, with full speaker notes and timing marks." },
  { title: "Working agent code", text: "The shippable build: a local model, a local document index, a tool registry, an egress guard that blocks client data from leaving, a budget that stops runaway loops, and an audit log. Python standard library only." },
  { title: "The 90-minute lab", text: "The same legal-research agent built twice: the afternoon version with an MCP connector, then the version where the client's name never crosses the wire." },
  { title: "Approval queue", text: "A human-in-the-loop queue in SQLite that survives a reviewer who takes three days: propose, approve, post only when approved, escalate, and a full history." },
  { title: "Readiness checklist (PDF)", text: "Score any AI system against the six platform decisions: containers, GPU orchestration, observability, cost control, security and governance." },
  { title: "Presenter guide (PDF)", text: "Run of show, timing gates and the answers to the questions you will get, so you can give this talk to your own team." },
];

const faqs = [
  { q: "Who is it for?", a: "Platform engineers, AI engineers and engineering leads who need to move an AI agent from a demo to something their organisation can run, secure and audit, or who want to make that case to their team." },
  { q: "What do I need to run the code?", a: "Python 3.10 or later. Part 2 runs on a laptop CPU with Ollama and needs no third-party Python packages. Part 1 needs an Anthropic API key and a few cents of credit. The included tests run the whole of Part 2 without any model." },
  { q: "Can I present the slides at my company?", a: "Yes. You can use, adapt and present everything inside your organisation and at events where you speak, as long as reused slides keep the credit line. You can't resell or republish the kit." },
  { q: "How do I get it?", a: "Checkout is handled by our payment provider, which also takes care of VAT. You get the download link straight after payment, by email and on screen." },
  { q: "Do I get updates?", a: "Yes. When I add a new talk or a new lab part, buyers can download the updated kit at no extra cost." },
];

const productSchema = kitLive ? {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description: "Two keynote decks with speaker notes, a 90-minute hands-on lab and working agent code for taking AI from demo to production.",
  image: "https://lucaberton.com/products/production-ai-kit-cover.png",
  brand: { "@type": "Person", name: "Luca Berton" },
  offers: { "@type": "Offer", price: priceValue, priceCurrency: currency, availability: "https://schema.org/InStock", url: "https://lucaberton.com/production-ai-kit/" },
} : null;
---

<Layout
  title={`${name}: From AI Demo to Production`}
  description="The talk, the lab and the code: two editable keynote decks, a 90-minute hands-on lab and working agent code with guardrails, by Luca Berton."
  image="/products/production-ai-kit-cover.png"
  noindex={!kitLive}
>
  {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}

  <section class="bg-slate-950 text-white py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-teal-300">{name}</p>
          <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight">From AI demo to production: the talk, the lab and the code</h1>
          <p class="mt-6 text-lg text-slate-300">
            Everything behind my Nordic APIs Summit and AI Tech Summit Skopje 2026 talks, packaged so you can run it, adapt it and present it to your own team.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 sm:items-center">
            {kitLive ? (
              <a
                href={checkoutUrl}
                data-track-event="consulting_cta_click"
                data-tp-target-offer="production_ai_kit"
                data-tp-cta-position="hero"
                data-tp-cta-variant="kit_checkout_hero"
                class="inline-flex items-center justify-center px-7 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 text-lg font-bold rounded-xl transition-colors"
              >
                Buy the kit · {price}
              </a>
            ) : (
              <span class="inline-flex items-center justify-center px-7 py-4 bg-slate-700 text-slate-300 text-lg font-bold rounded-xl">Available soon</span>
            )}
            <span class="text-sm text-slate-400">Instant download · VAT handled at checkout</span>
          </div>
        </div>
        <img src="/products/production-ai-kit-cover.png" alt={`${name} cover`} width="1600" height="900" class="w-full rounded-2xl shadow-2xl" />
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">What's inside</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {inside.map((item) => (
          <div class="rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-gray-700 max-w-3xl">
        Want to see the argument first? The <a class="text-blue-600 underline" href="/blog/nordic-apis-2026-api-guardrails-multi-tenant-ai/">talk write-up</a> is free. The kit adds the editable decks, the speaker notes, the working code and the PDFs.
      </p>
    </Container>
  </section>

  <section class="py-16 bg-gray-50">
    <Container>
      <h2 class="text-3xl font-extrabold text-gray-900">Questions</h2>
      <div class="mt-6 divide-y divide-gray-200 max-w-3xl">
        {faqs.map((f) => (
          <details class="py-4">
            <summary class="cursor-pointer font-semibold text-gray-900">{f.q}</summary>
            <p class="mt-2 text-gray-700">{f.a}</p>
          </details>
        ))}
      </div>
      {kitLive && (
        <a
          href={checkoutUrl}
          data-track-event="consulting_cta_click"
          data-tp-target-offer="production_ai_kit"
          data-tp-cta-position="post_conclusion"
          data-tp-cta-variant="kit_checkout_footer"
          class="mt-10 inline-flex items-center justify-center px-7 py-4 bg-teal-700 hover:bg-teal-600 text-white text-lg font-bold rounded-xl transition-colors"
        >
          Buy the kit · {price}
        </a>
      )}
    </Container>
  </section>
</Layout>
