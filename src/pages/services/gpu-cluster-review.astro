---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import ServiceRelatedPosts from "@components/ServiceRelatedPosts.astro";
import MagneticButton from "@components/react/MagneticButton.tsx";

export const prerender = true;
export const lastModified = '2026-10-15';

// Fixed-scope GPU cluster review. The figures below are the ones quoted on the
// first engagement of this kind. Change
// FEE and DURATION here rather than in the copy — they are referenced in three
// places on the page and in the FAQ schema.
const FEE = "EUR 10,000";
const DURATION = "two weeks";
---

<Layout
  title="GPU Cluster Design Review"
  description="An independent, fixed-fee review of your GPU cluster design — fabric, management plane and operations — before you place a non-cancellable hardware order.">
  <Breadcrumb items={[{ name: "Services", url: "/services/" }, { name: "GPU Cluster Design Review" }]} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 py-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="chip bg-white/10 text-amber-200 border border-white/10 mb-3">
          <span class="chip-dot"></span>
          Fixed scope · Fixed fee
        </span>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">
          A second pair of eyes <span class="text-brand">before the deposit is non-refundable</span>
        </h1>
        <p class="text-slate-400 mt-4 text-lg">
          A rack-scale GPU order commits seven or eight figures on a deposit you cannot cancel. This is an independent review of the fabric, management plane and operations design — delivered in writing, before the purchase order goes out.
        </p>
        <div class="flex flex-wrap gap-4 mt-8">
          <MagneticButton client:load>
            <a href="/contact/" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-all hover:scale-105 active:scale-95 cursor-pointer">Request a review</a>
          </MagneticButton>
          <a href="/gpu-cost-calculator/" class="border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white font-semibold py-3 px-8 rounded-lg transition-all cursor-pointer">GPU Cost Calculator</a>
        </div>
        <p class="text-slate-500 mt-6 text-sm">
          {FEE} · {DURATION} · written recommendation and a working session
        </p>
      </div>
    </Container>
  </section>

  <!-- The Problem -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Why the review comes first</h2>
        <p class="text-gray-700 mb-6">
          By the time a cluster is racked, the expensive decisions are already made. The fabric topology, the oversubscription ratio, the management plane, the power and cooling envelope and the multi-tenancy model are all fixed by the bill of materials. Most of them cannot be changed afterwards without buying hardware twice.
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="grad-border spotlight-card bg-red-50 border border-red-100 rounded-xl p-5">
            <p class="text-sm text-red-800 font-semibold mb-2">What goes wrong</p>
            <ul class="space-y-2 text-sm text-red-700">
              <li>❌ Fabric sized for the GPU count, not for the collective traffic</li>
              <li>❌ Cooling specified for nameplate, not sustained draw</li>
              <li>❌ No management plane in the BOM, bolted on later</li>
              <li>❌ Multi-tenancy left to "we will sort it in software"</li>
              <li>❌ Vendor's reference architecture accepted without challenge</li>
            </ul>
          </div>
          <div class="grad-border spotlight-card bg-green-50 border border-green-100 rounded-xl p-5">
            <p class="text-sm text-green-800 font-semibold mb-2">What the review gives you</p>
            <ul class="space-y-2 text-sm text-green-700">
              <li>✅ An independent read of the specification, in writing</li>
              <li>✅ The questions to put to your vendor before signing</li>
              <li>✅ Risks ranked by what they cost to fix later</li>
              <li>✅ A defensible record for your board or your investors</li>
              <li>✅ Someone with no stake in which hardware you buy</li>
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Scope -->
  <section class="py-16 bg-slate-50">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">What is reviewed</h2>
        <p class="text-gray-600 mb-8 text-sm">Four areas, each against your own specification and your own workload — not a generic checklist.</p>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100">
            <h3 class="font-bold text-gray-900">Fabric</h3>
            <p class="text-sm text-gray-600 mt-2">Topology, rail design and oversubscription against the collectives your workloads actually run. InfiniBand or Ethernet, leaf and spine counts, cable plant, and what happens to NCCL performance at the sizes you plan to train at.</p>
          </div>
          <div class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100">
            <h3 class="font-bold text-gray-900">Rack-scale and cooling</h3>
            <p class="text-sm text-gray-600 mt-2">Direct-to-chip or sidecar, coolant loop and CDU sizing, sustained versus nameplate power, and the bring-up sequence. Whether the hall you have can carry what the BOM assumes.</p>
          </div>
          <div class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100">
            <h3 class="font-bold text-gray-900">Management plane</h3>
            <p class="text-sm text-gray-600 mt-2">Scheduler and tenancy model — SLURM, Kubernetes or both — provisioning, image and driver lifecycle, and the health and telemetry stack. DCGM, node exporters, and what you do when a GPU degrades rather than fails.</p>
          </div>
          <div class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100">
            <h3 class="font-bold text-gray-900">Operations</h3>
            <p class="text-sm text-gray-600 mt-2">Who runs it on day two: quotas and fair share, isolation between tenants, upgrade path, runbooks, and the staffing the design implies. The part that decides whether the cluster is usable or merely installed.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Deliverables -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">How it runs</h2>
        <ol class="space-y-5">
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">1</span>
            <div>
              <p class="font-semibold text-gray-900">NDA and materials</p>
              <p class="text-sm text-gray-600 mt-1">You send the specification, the bill of materials and the site constraints under NDA. A short call to agree what matters most to you.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">2</span>
            <div>
              <p class="font-semibold text-gray-900">The review</p>
              <p class="text-sm text-gray-600 mt-1">{DURATION} of work across the four areas above, with questions back to you and to your vendor as they come up rather than at the end.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">3</span>
            <div>
              <p class="font-semibold text-gray-900">Written recommendation</p>
              <p class="text-sm text-gray-600 mt-1">A document you can hand to your vendor, your board or your investors: findings, risks ranked by cost of late correction, and the specific questions to resolve before the order.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">4</span>
            <div>
              <p class="font-semibold text-gray-900">Working session</p>
              <p class="text-sm text-gray-600 mt-1">A call to go through it, so the document is understood rather than filed. Anything that needs a second look after that is included.</p>
            </div>
          </li>
        </ol>
        <div class="mt-8 bg-slate-50 border border-slate-200 rounded-xl p-5">
          <p class="text-sm text-gray-700">
            <strong class="text-gray-900">{FEE}, fixed.</strong> Not an hourly engagement and not a retainer. If the scale is materially different from a single-hall deployment, the fee is agreed before anything starts — but it is always a number, agreed up front, not a day rate running against an open scope.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why me -->
  <section class="py-16 bg-slate-50">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Why an independent reviewer</h2>
        <p class="text-gray-700 mb-6">
          Your integrator, your hardware vendor and your colocation provider all have a position on what you should buy. This review has none. I do not resell hardware, I take no referral fee from any vendor, and the recommendation is the deliverable.
        </p>
        <div class="grid md:grid-cols-3 gap-4">
          <div class="bg-white rounded-xl p-5 border border-slate-100">
            <p class="text-sm font-semibold text-gray-900">Hands on, at command level</p>
            <p class="text-xs text-gray-600 mt-2">Multi-tenant GPU platforms on bare-metal OpenShift AI, SLURM multi-node, NCCL and DCGM — written up publicly, not just claimed on a slide.</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-slate-100">
            <p class="text-sm font-semibold text-gray-900">On the record</p>
            <p class="text-xs text-gray-600 mt-2">Talks on multi-tenant GPU platform engineering at KubeCon Europe and Red Hat Summit, and eight technical books on infrastructure and automation.</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-slate-100">
            <p class="text-sm font-semibold text-gray-900">Fixed scope by design</p>
            <p class="text-xs text-gray-600 mt-2">A defined piece of work with a defined end. No discovery phase, no scope creep, no retainer you have to cancel later.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Related Services -->
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto" data-reveal>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Related services</h2>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/services/ai-integration/" class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100 hover:shadow-md transition-all hover:-translate-y-0.5 cursor-pointer">
            <h3 class="font-bold text-gray-900 text-sm">AI Integration &amp; GPU Platforms</h3>
            <p class="text-xs text-gray-500 mt-1">Build and run what the review approves</p>
          </a>
          <a href="/services/cloud-infrastructure/" class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100 hover:shadow-md transition-all hover:-translate-y-0.5 cursor-pointer">
            <h3 class="font-bold text-gray-900 text-sm">Cloud Infrastructure Design</h3>
            <p class="text-xs text-gray-500 mt-1">The foundation underneath the cluster</p>
          </a>
          <a href="/services/performance-optimization/" class="grad-border spotlight-card bg-white rounded-xl p-5 border border-slate-100 hover:shadow-md transition-all hover:-translate-y-0.5 cursor-pointer">
            <h3 class="font-bold text-gray-900 text-sm">Performance Optimization</h3>
            <p class="text-xs text-gray-500 mt-1">Tune it once it is running</p>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <ServiceRelatedPosts keywords={['gpu', 'nvidia', 'slurm', 'nccl', 'dcgm', 'infiniband', 'openshift-ai', 'multi-tenant']} />
  </Container>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 py-16">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl font-bold text-white">Ordering soon?</h2>
        <p class="text-slate-400 mt-3">Tell me the scale, the site and the date the deposit is due. If a review does not fit that timeline, I will say so.</p>
        <a href="/contact/" class="mt-6 inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-all hover:scale-105 active:scale-95 cursor-pointer">Request a review</a>
      </div>
    </Container>
  </section>
</Layout>
