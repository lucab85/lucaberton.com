---
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import SpeakingStageProof from "@components/speaking-stage-proof.astro";
import lucaImage from "assets/luca-hero.jpg";

export const prerender = true;
export const lastModified = "2026-08-29";
---

<Layout
  title="Production AI Keynote Speaker"
  description="Book Luca Berton, The Production AI Expert, for a keynote on moving enterprise AI from demo to secure, governed, scalable production."
>
  <section class="relative overflow-hidden bg-slate-950 px-6 py-20 text-white lg:px-12 lg:py-28">
    <div class="absolute inset-0 opacity-20">
      <img src="/hero-stage-2.webp" alt="Conference stage" class="h-full w-full object-cover" width="1920" height="900" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-950/60"></div>

    <div class="relative mx-auto grid max-w-7xl gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-red-400">Production AI Keynote Speaker</p>
        <h1 class="mt-5 max-w-5xl text-5xl font-black leading-[0.98] tracking-[-0.04em] sm:text-6xl lg:text-7xl">
          The AI demo is easy.
          <span class="block text-red-400">Production is hard.</span>
        </h1>
        <p class="mt-7 max-w-3xl text-xl leading-relaxed text-slate-300 lg:text-2xl">
          Luca Berton helps technology leaders understand what actually breaks between an impressive AI prototype and a system the enterprise can trust, operate and scale.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href="/contact/" class="inline-flex items-center justify-center rounded-xl bg-red-600 px-7 py-4 text-lg font-bold text-white hover:bg-red-500">
            Book Luca for Your Event
          </a>
          <a href="/conferences/" class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/10 px-7 py-4 text-lg font-semibold text-white hover:bg-white/15">
            See Conference History
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm font-semibold text-slate-300">
          <span>KubeCon + CloudNativeCon Europe 2026</span>
          <span>Red Hat Summit 2026</span>
          <span>Docker Captain</span>
          <span>40,000+ students</span>
          <span>8 technical books</span>
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="mx-auto max-w-sm rounded-3xl border border-white/10 bg-white/[0.07] p-5 shadow-2xl backdrop-blur-xl">
          <Picture
            src={lucaImage}
            alt="Luca Berton speaking about Production AI"
            widths={[360, 480, 640]}
            sizes="360px"
            width={480}
            height={640}
            formats={["avif", "webp"]}
            class="aspect-[3/4] w-full rounded-2xl object-cover object-top"
          />
          <div class="p-2 pt-5">
            <div class="text-2xl font-black">Luca Berton</div>
            <div class="mt-1 font-semibold text-red-300">The Production AI Expert</div>
            <div class="mt-3 text-sm leading-relaxed text-slate-300">Amsterdam · Available worldwide</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-6 py-24 lg:px-12 lg:py-32">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">Signature keynote</p>
          <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">The AI Demo Is Easy. Production Is Hard.</h2>
        </div>
        <div class="lg:col-span-7">
          <p class="text-2xl leading-relaxed text-slate-700">
            The board sees a breakthrough demo. The platform team sees identity, reliability, GPUs, observability, cost, security, governance and a hundred unanswered operational questions.
          </p>
          <p class="mt-6 text-lg leading-relaxed text-slate-600">
            This keynote gives leaders a memorable mental model for the prototype-to-production gap and shows why AI strategy is now inseparable from platform engineering, operating discipline and governance.
          </p>

          <div class="mt-9 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-slate-50 p-6">
              <div class="font-black text-slate-950">Audience</div>
              <p class="mt-2 text-slate-600">CIOs, CTOs, engineering leaders, platform teams, AI leaders and technical decision-makers.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-6">
              <div class="font-black text-slate-950">Format</div>
              <p class="mt-2 text-slate-600">20–45 minute keynote, executive session, conference talk or tailored enterprise presentation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 px-6 py-24 lg:px-12 lg:py-32">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">What audiences leave with</p>
        <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">A practical model, not AI theater.</h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        <article class="rounded-2xl border border-slate-200 bg-white p-7">
          <div class="text-xl font-black text-slate-950">Where AI projects really stall</div>
          <p class="mt-3 leading-relaxed text-slate-600">Why a prototype can look successful while the production path is still undefined.</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-7">
          <div class="text-xl font-black text-slate-950">The Production AI Framework</div>
          <p class="mt-3 leading-relaxed text-slate-600">Prototype → Platform → Production → Proof: a shared language for technical and executive teams.</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-7">
          <div class="text-xl font-black text-slate-950">The hidden operating layer</div>
          <p class="mt-3 leading-relaxed text-slate-600">Reliability, security, observability, cost and governance — the work the demo does not show.</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-7">
          <div class="text-xl font-black text-slate-950">What leaders should do next</div>
          <p class="mt-3 leading-relaxed text-slate-600">Concrete questions to ask before scaling AI investment, teams and infrastructure.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 px-6 py-24 text-white lg:px-12 lg:py-32">
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-400">Additional keynote directions</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article class="rounded-3xl border border-white/10 bg-white/[0.06] p-8 lg:p-10">
          <h2 class="text-3xl font-black">The Platform Team Is the AI Strategy</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">
            AI increases the speed of experimentation — and the need for stronger platforms. A talk about golden paths, agentic development, governance and why platform engineering becomes more important in an AI-first organization, not less.
          </p>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.06] p-8 lg:p-10">
          <h2 class="text-3xl font-black">The Economics of Production AI</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">
            GPUs, inference, utilization, latency and architecture decisions become business decisions. A practical executive talk on making AI infrastructure economically sustainable at scale.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white px-6 py-24 lg:px-12 lg:py-32">
    <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-600">Why Luca</p>
        <h2 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Technical enough for engineers. Clear enough for executives.</h2>
        <p class="mt-6 text-xl leading-relaxed text-slate-600">
          Luca brings 15+ years of enterprise infrastructure experience, a former Red Hat engineering background, eight published technical books, teaching experience with 40,000+ students, and stage experience at KubeCon and Red Hat Summit.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          The result is a talk grounded in systems that have to work — translated into a story leaders can act on.
        </p>
      </div>
      <div class="rounded-3xl bg-red-50 p-8 lg:col-span-5 lg:p-10">
        <div class="text-sm font-bold uppercase tracking-[0.18em] text-red-700">Best fit</div>
        <ul class="mt-6 space-y-4 text-lg font-semibold text-slate-800">
          <li>AI & technology conferences</li>
          <li>CIO / CTO leadership events</li>
          <li>Enterprise innovation summits</li>
          <li>Cloud-native & platform engineering events</li>
          <li>Executive offsites and customer events</li>
        </ul>
      </div>
    </div>
  </section>

  <SpeakingStageProof />

  <section class="bg-red-600 px-6 py-20 text-white lg:px-12">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-100">Bring Production AI to your stage</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight">Give your audience the part of the AI story most demos leave out.</h2>
      </div>
      <a href="/contact/" class="shrink-0 rounded-xl bg-white px-7 py-4 text-lg font-black text-red-700 shadow-xl hover:bg-red-50">Book Luca to Speak</a>
    </div>
  </section>
</Layout>
