/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static media and self-hosted scripts/styles keep a FIXED filename when their
# content changes (e.g. scripts/cookieconsent-config.js), so they must not be
# immutable: browsers cache for a day and revalidate in the background.
# Only content-hashed /_astro/* and the self-hosted /fonts/* are immutable.
/hero-stage-1.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/hero-stage-2.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/hero-stage-1.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/hero-stage-2.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/luca-hero.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/opengraph.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/scripts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/styles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Prevent indexing of feed and PDF resources (they should not rank in search).
/rss.xml
  X-Robots-Tag: noindex, follow
  Content-Type: application/rss+xml; charset=utf-8

/slides/*
  X-Robots-Tag: noindex, follow

/pdf/*
  X-Robots-Tag: noindex, follow

# Site-wide security headers.
# Content-Security-Policy, HSTS and X-Content-Type-Options are sent by the
# Cloudflare edge, not by Vercel (EDGE_OWNED_HEADERS in
# scripts/build-vercel-config.cjs skips them), so the CSP below is a copy of the
# Cloudflare Transform Rule "Content-Security-Policy" (Rules > Transform Rules >
# Modify Response Header, all incoming requests) as live since Nov 7, 2026.
# Change both together. scripts/verify-live.mjs (and the daily Live watch)
# fails when the live CSP blocks a script on the home page.
# - 'unsafe-inline' is still required for Tailwind/JSON-LD inline scripts
#   and for inline event handlers used by some 3rd-party widgets.
# - static.cloudflareinsights.com: Cloudflare Web Analytics injects its beacon
#   for browser requests; without it in script-src the CSP blocked it on every
#   page (Nov 2026).
# - js.web3forms.com: the contact form; assets.calendly.com (script/style) and
#   calendly.com (frame): the Calendly popup (src/components/CalendlyPopup.astro).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://assets.calendly.com https://js.web3forms.com https://f.convertkit.com https://www.googletagmanager.com https://www.clarity.ms https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://calendly.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'
