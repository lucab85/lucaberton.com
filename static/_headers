/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Long-lived cache for content-stable static media and self-hosted scripts
# (filenames change when contents change; safe for 1-year immutable cache).
/hero-stage-1.webp
  Cache-Control: public, max-age=31536000, immutable
/hero-stage-2.webp
  Cache-Control: public, max-age=31536000, immutable
/hero-stage-1.jpg
  Cache-Control: public, max-age=31536000, immutable
/hero-stage-2.jpg
  Cache-Control: public, max-age=31536000, immutable
/luca-hero.jpg
  Cache-Control: public, max-age=31536000, immutable
/opengraph.jpg
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=604800
/scripts/*
  Cache-Control: public, max-age=31536000, immutable
/styles/*
  Cache-Control: public, max-age=31536000, immutable

# Prevent indexing of feed and PDF resources (they should not rank in search).
/rss.xml
  X-Robots-Tag: noindex, follow
  Content-Type: application/rss+xml; charset=utf-8

/slides/*
  X-Robots-Tag: noindex, follow

/pdf/*
  X-Robots-Tag: noindex, follow

# Site-wide security headers + tightened Content-Security-Policy.
# - 'unsafe-inline' is still required for Tailwind/JSON-LD inline scripts
#   and for inline event handlers used by some 3rd-party widgets.
# - Wildcards are scoped to known providers (analytics, Convertkit/MailerLite,
#   YouTube embeds, image CDNs).
# - frame-src includes 'self' so the Partytown sandbox iframe (~partytown/*) works.
# - cloudflareinsights.com is auto-injected by Cloudflare; allowlisted here.
#   To remove the dependency, disable Web Analytics in the Cloudflare dashboard.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.convertkit.com https://*.kit.com https://*.mailerlite.com; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com https://*.google-analytics.com https://f.convertkit.com https://*.convertkit.com https://*.kit.com https://*.mailerlite.com https://www.youtube.com https://s.ytimg.com https://platform.twitter.com https://static.cloudflareinsights.com https://www.clarity.ms; script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com https://*.google-analytics.com https://f.convertkit.com https://*.convertkit.com https://*.kit.com https://*.mailerlite.com https://www.youtube.com https://s.ytimg.com https://platform.twitter.com https://static.cloudflareinsights.com https://www.clarity.ms; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.googletagmanager.com https://api.convertkit.com https://*.convertkit.com https://*.kit.com https://*.mailerlite.com https://cloudflareinsights.com https://*.clarity.ms; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://platform.twitter.com https://*.convertkit.com https://*.kit.com https://*.mailerlite.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
